{
  "schemaVersion": 1,
  "enabled": true,
  "displayName": "contact-signin-staging",
  "applicationClientId": "{{CONTACT_OIDC_CLIENT_ID}}",
  "spec": {
    "onInteractiveAuthFlowStart": {
      "isSignUpAllowed": true
    },
    "identityProviders": ["Google-OAUTH", "Apple-OAUTH", "Microsoft-OAuth"],
    "onAttributeCollection": {
      "email": {
        "hidden": true,
        "editable": false,
        "required": true
      },
      "displayName": {
        "hidden": true,
        "editable": false,
        "required": false
      }
    }
  }
}
