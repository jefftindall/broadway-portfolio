---
interface Props {
  title: string;
  description: string;
  date: Date;
  href: string;
}

const { title, description, date, href } = Astro.props;
const formatted = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a
  href={href}
  class="group block border-b border-line py-8 transition hover:border-gold"
>
  <time class="text-sm text-gel" datetime={date.toISOString()}>{formatted}</time>
  <h3 class="mt-2 font-display text-2xl text-spotlight transition group-hover:text-gold md:text-3xl">
    {title}
  </h3>
  <p class="mt-2 max-w-2xl text-muted">{description}</p>
  <span class="mt-3 inline-block text-sm text-gold">Read more →</span>
</a>
