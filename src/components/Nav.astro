---
import { nav, site } from '../lib/site';
const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-line bg-ink/70 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4">
    <a
      href="/"
      class="inline-flex items-center gap-1.5 font-display text-2xl tracking-tight text-spotlight md:gap-2 md:text-3xl"
    >
      <img
        src="/favicon.svg"
        alt=""
        width="32"
        height="32"
        class="size-7 shrink-0 rounded-sm md:size-8"
        decoding="async"
      />
      {site.name}
    </a>
    <nav class="hidden items-center gap-6 md:flex" aria-label="Primary">
      {
        nav.map((item) => {
          const active = pathname === item.href || pathname.startsWith(item.href + '/');
          return (
            <a
              href={item.href}
              class:list={[
                'text-sm transition',
                active ? 'text-gold' : 'text-muted hover:text-spotlight',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
      <span id="nav-account-slot" class="hidden items-center gap-4" hidden></span>
    </nav>
    <details class="relative md:hidden">
      <summary
        class="min-h-11 cursor-pointer list-none rounded-sm border border-line px-3 py-2 text-sm text-spotlight"
      >
        Menu
      </summary>
      <div
        class="glass-panel-strong absolute right-0 mt-2 w-52 rounded-sm p-2 shadow-xl"
      >
        {
          nav.map((item) => (
            <a
              href={item.href}
              class="block min-h-11 rounded-sm px-3 py-2 text-sm text-muted hover:bg-stage hover:text-spotlight"
            >
              {item.label}
            </a>
          ))
        }
        <div id="nav-account-slot-mobile" class="hidden border-t border-line pt-2" hidden></div>
      </div>
    </details>
  </div>
</header>

<script>
  import {
    hasContactSession,
    parseContactAccountConfig,
    type SwaMeResponse,
  } from '../lib/contactAccounts';

  function linkClass(desktop: boolean): string {
    return desktop
      ? 'text-sm text-muted transition hover:text-spotlight'
      : 'block min-h-11 rounded-sm px-3 py-2 text-sm text-muted hover:bg-stage hover:text-spotlight';
  }

  function renderAccountLinks(enabled: boolean, signedIn: boolean) {
    const desktop = document.getElementById('nav-account-slot');
    const mobile = document.getElementById('nav-account-slot-mobile');
    if (!desktop || !mobile) return;

    desktop.replaceChildren();
    mobile.replaceChildren();

    if (!enabled) {
      desktop.hidden = true;
      mobile.hidden = true;
      desktop.classList.add('hidden');
      mobile.classList.add('hidden');
      return;
    }

    const href = signedIn ? '/account' : '/login';
    const label = signedIn ? 'Account' : 'Sign in';

    const desktopLink = document.createElement('a');
    desktopLink.href = href;
    desktopLink.className = linkClass(true);
    desktopLink.textContent = label;
    desktop.appendChild(desktopLink);

    const mobileLink = document.createElement('a');
    mobileLink.href = href;
    mobileLink.className = linkClass(false);
    mobileLink.textContent = label;
    mobile.appendChild(mobileLink);

    desktop.hidden = false;
    mobile.hidden = false;
    desktop.classList.remove('hidden');
    desktop.classList.add('inline-flex');
    mobile.classList.remove('hidden');
  }

  async function refreshNavAccountChrome() {
    try {
      const [configRes, meRes] = await Promise.all([
        fetch('/api/contactAccountConfig', { cache: 'no-store' }),
        fetch('/.auth/me', { cache: 'no-store' }),
      ]);
      const config = configRes.ok
        ? parseContactAccountConfig(await configRes.json())
        : { enabled: false };
      let me: SwaMeResponse | null = null;
      if (meRes.ok) {
        me = (await meRes.json()) as SwaMeResponse;
      }
      renderAccountLinks(config.enabled, hasContactSession(me));
    } catch {
      renderAccountLinks(false, false);
    }
  }

  refreshNavAccountChrome();
</script>
