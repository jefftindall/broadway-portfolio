---
interface Props {
  url: string;
  title?: string;
  /** Public path for the click-to-play poster. YouTube falls back to the hqdefault thumb. */
  poster?: string;
}

const { url, title = 'Performance video', poster } = Astro.props;

function youtubeId(raw: string): string | null {
  try {
    const u = new URL(raw);
    if (u.hostname.includes('youtu.be')) {
      const id = u.pathname.split('/').filter(Boolean)[0];
      return id || null;
    }
    if (u.hostname.includes('youtube.com')) {
      if (u.pathname.startsWith('/embed/')) {
        return u.pathname.split('/').filter(Boolean)[1] || null;
      }
      return u.searchParams.get('v');
    }
  } catch {
    return null;
  }
  return null;
}

function toEmbed(raw: string): string | null {
  try {
    const u = new URL(raw);
    if (u.hostname.includes('youtu.be') || u.hostname.includes('youtube.com')) {
      const id = youtubeId(raw);
      return id ? `https://www.youtube.com/embed/${id}` : null;
    }
    if (u.hostname.includes('vimeo.com')) {
      const id = u.pathname.split('/').filter(Boolean).pop();
      return id ? `https://player.vimeo.com/video/${id}` : null;
    }
  } catch {
    return null;
  }
  return null;
}

const ytId = youtubeId(url);
const embed = toEmbed(url);
const posterSrc = poster || (ytId ? `https://i.ytimg.com/vi/${ytId}/hqdefault.jpg` : undefined);
---

{
  ytId && posterSrc ? (
    <div
      class="relative aspect-video overflow-hidden rounded-sm border border-line bg-panel"
      data-video-facade
      data-youtube-id={ytId}
      data-video-title={title}
    >
      <button
        type="button"
        class="group relative block h-full w-full cursor-pointer"
        aria-label={`Play ${title}`}
      >
        <img
          src={posterSrc}
          alt=""
          width={1280}
          height={720}
          class="h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
        <span
          class="absolute inset-0 bg-ink/25 transition group-hover:bg-ink/35"
          aria-hidden="true"
        ></span>
        <span
          class="absolute left-1/2 top-1/2 flex h-16 w-16 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-gold text-ink shadow-lg transition group-hover:scale-105"
          aria-hidden="true"
        >
          <span class="ml-1 border-y-[10px] border-l-[16px] border-y-transparent border-l-ink"></span>
        </span>
      </button>
    </div>
  ) : embed ? (
    <div class="aspect-video overflow-hidden rounded-sm border border-line bg-panel">
      <iframe
        src={embed}
        title={title}
        class="h-full w-full"
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      />
    </div>
  ) : (
    <p class="text-sm text-muted">
      <a href={url} class="text-gel underline" target="_blank" rel="noopener noreferrer">
        Watch video
      </a>
    </p>
  )
}

<script>
  function activateFacade(root: HTMLElement) {
    const id = root.dataset.youtubeId;
    if (!id || root.dataset.activated === '1') return;
    root.dataset.activated = '1';
    const title = root.dataset.videoTitle || 'Performance video';
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1`;
    iframe.title = title;
    iframe.className = 'h-full w-full';
    iframe.allow =
      'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
    iframe.setAttribute('allowfullscreen', '');
    root.replaceChildren(iframe);
  }

  function bindFacades() {
    document.querySelectorAll<HTMLElement>('[data-video-facade]').forEach((root) => {
      if (root.dataset.bound === '1') return;
      root.dataset.bound = '1';
      root.querySelector('button')?.addEventListener('click', () => activateFacade(root));
    });
  }

  bindFacades();
  document.addEventListener('astro:page-load', bindFacades);
</script>
