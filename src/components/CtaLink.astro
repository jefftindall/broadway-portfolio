---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'gel';
  class?: string;
  external?: boolean;
  /** GA4 event name for click tracking (`select_content` / `file_download`). */
  'data-ga-event'?: string;
  'data-ga-content-type'?: string;
  'data-ga-content-id'?: string;
  'data-ga-file-name'?: string;
  'data-ga-file-extension'?: string;
  'data-testid'?: string;
}

const {
  href,
  variant = 'primary',
  class: className = '',
  external = false,
  'data-ga-event': dataGaEvent,
  'data-ga-content-type': dataGaContentType,
  'data-ga-content-id': dataGaContentId,
  'data-ga-file-name': dataGaFileName,
  'data-ga-file-extension': dataGaFileExtension,
  'data-testid': dataTestId,
} = Astro.props;

const variants = {
  primary:
    'bg-gold text-ink font-semibold hover:brightness-110',
  secondary:
    'border border-line text-spotlight hover:border-gold',
  gel: 'bg-gel text-spotlight font-semibold hover:brightness-110',
};
---

<a
  href={href}
  class:list={[
    'inline-flex min-h-11 items-center justify-center rounded-sm px-6 py-3 text-sm transition',
    variants[variant],
    className,
  ]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  data-ga-event={dataGaEvent}
  data-ga-content-type={dataGaContentType}
  data-ga-content-id={dataGaContentId}
  data-ga-file-name={dataGaFileName}
  data-ga-file-extension={dataGaFileExtension}
  data-testid={dataTestId}
>
  <slot />
</a>
