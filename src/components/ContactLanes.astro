---
import GlassPanel from './GlassPanel.astro';
import CtaLink from './CtaLink.astro';
import SectionHeader from './SectionHeader.astro';
import InquiryForm from './InquiryForm.astro';

interface Props {
  showHeader?: boolean;
  /** When true, embed casting + lesson forms (contact page). Otherwise link out. */
  embedForms?: boolean;
}

const { showHeader = true, embedForms = false } = Astro.props;
---

<section class="section-y" aria-labelledby="contact-lanes-heading">
  <div class="mx-auto max-w-6xl px-6">
    <div id="contact-lanes-heading">
      {
        showHeader ? (
          <SectionHeader
            eyebrow="Get in touch"
            title="Casting & lessons"
            support={
              embedForms
                ? 'Send a casting or lesson request — details go straight to Elyse’s inbox.'
                : 'Casting directors, agents, and students — choose a lane to reach Elyse.'
            }
          />
        ) : (
          <h2 class="sr-only">Contact options</h2>
        )
      }
    </div>

    <div class:list={['grid gap-6 md:grid-cols-2', showHeader && 'mt-10']}>
      <GlassPanel strong class="flex flex-col p-6 md:p-8" as="article">
        <h3 class="font-display text-3xl text-spotlight">Casting &amp; agents</h3>
        <p class="mt-3 text-sm text-muted">
          Headshot, resume, reel, and availability for casting directors and representation.
        </p>
        {
          embedForms ? (
            <InquiryForm class="mt-8" type="casting" id="casting-inquiry" />
          ) : (
            <CtaLink class="mt-8 self-start" href="/contact#casting-inquiry">
              Casting inquiry
            </CtaLink>
          )
        }
      </GlassPanel>

      <GlassPanel strong class="flex flex-col p-6 md:p-8" as="article">
        <h3 class="font-display text-3xl text-spotlight">Voice lesson inquiries</h3>
        <p class="mt-3 text-sm text-muted">
          Private vocal coaching for singers and parents — pedagogy, vocal health, and CCM. NYC or Zoom.
        </p>
        {
          embedForms ? (
            <InquiryForm class="mt-8" type="lesson" id="lesson-inquiry" />
          ) : (
            <CtaLink class="mt-8 self-start" variant="secondary" href="/lessons/book">
              Book a lesson
            </CtaLink>
          )
        }
      </GlassPanel>
    </div>
  </div>
</section>
