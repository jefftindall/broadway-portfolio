---
import { site } from '../lib/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalPath: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noIndex?: boolean;
}

const { title, description, image, canonicalPath, jsonLd, noIndex = false } = Astro.props;
const canonical = new URL(canonicalPath, site.url).href;
const ogImage = image
  ? new URL(image, site.url).href
  : new URL('/images/og-default.jpg', site.url).href;

const defaultPerson = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  email: site.email,
  telephone: site.phone,
  jobTitle: site.jobTitle,
  description: site.description,
  image: new URL(site.heroImage, site.url).href,
  sameAs: [site.instagram],
  knowsAbout: site.knowsAbout,
  homeLocation: {
    '@type': 'Place',
    name: 'New York, NY',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'New York',
    addressRegion: 'NY',
    addressCountry: 'US',
  },
};

const structured = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [defaultPerson];
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noIndex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content={site.name} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{
  structured.map((item) => (
    <script type="application/ld+json" set:html={JSON.stringify(item)} />
  ))
}
