---
interface Props {
  type: 'casting' | 'lesson';
  /** Optional id for deep-links (e.g. casting-inquiry). */
  id?: string;
  class?: string;
}

const { type, id, class: className } = Astro.props;
const siteKey = String(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '').trim();
const formId = id ?? `${type}-inquiry`;
const submitLabel = type === 'casting' ? 'Send casting inquiry' : 'Send lesson inquiry';
const crossLink =
  type === 'casting'
    ? { href: '/lessons/book', label: 'Looking for lessons?' }
    : { href: '/contact', label: 'Casting or representation?' };
/** Keep fields inside the panel: native inputs have an intrinsic min-width that can overflow grid. */
const fieldClass =
  'mt-1 box-border w-full max-w-full min-w-0 rounded-sm border border-line bg-ink/40 px-3 py-2 text-spotlight focus:border-gold focus:outline-none focus-visible:ring-2 focus-visible:ring-gold';
---

<form
  id={formId}
  class:list={['inquiry-form w-full min-w-0', className]}
  data-inquiry-form
  data-inquiry-type={type}
  data-turnstile-sitekey={siteKey}
  novalidate
>
  <input type="hidden" name="type" value={type} />

  <div class="grid min-w-0 gap-4">
    <label class="block min-w-0">
      <span class="text-sm text-muted">Name</span>
      <input
        class={fieldClass}
        type="text"
        name="name"
        autocomplete="name"
        required
        maxlength="200"
        data-testid={`${type}-name`}
      />
    </label>

    <fieldset class="min-w-0" data-preferred-contact>
      <legend class="text-sm text-muted">Preferred contact method</legend>
      <div class="mt-2 flex flex-wrap gap-4 text-sm text-spotlight">
        <label class="inline-flex items-center gap-2">
          <input
            type="radio"
            name="preferredContact"
            value="email"
            checked
            data-testid={`${type}-preferred-email`}
          />
          Email
        </label>
        <label class="inline-flex items-center gap-2">
          <input
            type="radio"
            name="preferredContact"
            value="phone"
            data-testid={`${type}-preferred-phone`}
          />
          Phone
        </label>
      </div>
    </fieldset>

    <label class="block min-w-0" data-field="email">
      <span class="text-sm text-muted">
        Email <span class="opacity-70" data-optional-hint hidden>(optional)</span>
      </span>
      <input
        class={fieldClass}
        type="email"
        name="email"
        autocomplete="email"
        maxlength="320"
        data-testid={`${type}-email`}
      />
    </label>

    <label class="block min-w-0" data-field="phone">
      <span class="text-sm text-muted">
        Phone <span class="opacity-70" data-optional-hint>(optional)</span>
      </span>
      <input
        class={fieldClass}
        type="tel"
        name="phone"
        autocomplete="tel"
        maxlength="40"
        data-testid={`${type}-phone`}
      />
    </label>

    {
      type === 'casting' ? (
        <label class="block min-w-0">
          <span class="text-sm text-muted">
            Organization <span class="opacity-70">(optional)</span>
          </span>
          <input
            class={fieldClass}
            type="text"
            name="organization"
            autocomplete="organization"
            maxlength="200"
            data-testid="casting-organization"
          />
        </label>
      ) : (
        <fieldset class="min-w-0">
          <legend class="text-sm text-muted">Preferred format</legend>
          <div class="mt-2 flex flex-wrap gap-4 text-sm text-spotlight">
            <label class="inline-flex items-center gap-2">
              <input type="radio" name="format" value="nyc" required data-testid="lesson-format-nyc" />
              NYC in-person
            </label>
            <label class="inline-flex items-center gap-2">
              <input type="radio" name="format" value="zoom" data-testid="lesson-format-zoom" />
              Zoom
            </label>
          </div>
        </fieldset>
      )
    }

    <label class="block min-w-0">
      <span class="text-sm text-muted">
        {type === 'casting' ? 'Project / message' : 'Goals & availability'}
      </span>
      <textarea
        class:list={[fieldClass, 'min-h-28']}
        name="message"
        required
        maxlength="5000"
        data-testid={`${type}-message`}
      ></textarea>
    </label>

    {
      siteKey ? (
        <div data-turnstile-mount class="min-h-[65px]"></div>
      ) : (
        <p class="text-sm text-muted" data-testid="turnstile-missing">
          Form verification isn’t configured for this build.
        </p>
      )
    }

    <p class="inquiry-status hidden text-sm" data-inquiry-status role="status" aria-live="polite"></p>

    <p class="text-xs leading-relaxed text-muted">
      By submitting, you agree we may contact you about this inquiry via your preferred method and
      agree to our <a class="text-gel underline underline-offset-2" href="/terms">Terms</a>. We do
      not send marketing SMS to visitors. Studio inquiry text alerts and opt-out (STOP / HELP) are
      described in our{' '}
      <a class="text-gel underline underline-offset-2" href="/privacy#sms">SMS privacy notice</a>.
    </p>

    <button
      type="submit"
      class="inline-flex items-center justify-center rounded-sm bg-gold px-5 py-3 text-sm font-semibold text-ink transition hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-60"
      data-testid={`${type}-submit`}
      disabled={!siteKey}
    >
      {submitLabel}
    </button>

    <p class="text-sm text-muted">
      <a class="text-gel underline underline-offset-4" href={crossLink.href}>{crossLink.label}</a>
    </p>
  </div>
</form>

<script>
  type TurnstileApi = {
    render: (el: HTMLElement, opts: Record<string, unknown>) => string;
    reset: (widgetId?: string) => void;
    getResponse: (widgetId?: string) => string;
  };

  const TURNSTILE_SRC = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
  let turnstileLoader: Promise<void> | null = null;

  function turnstileApi(): TurnstileApi | undefined {
    return (window as unknown as { turnstile?: TurnstileApi }).turnstile;
  }

  function loadTurnstile(): Promise<void> {
    if (turnstileApi()) return Promise.resolve();
    if (turnstileLoader) return turnstileLoader;
    turnstileLoader = new Promise((resolve, reject) => {
      const existing = document.querySelector<HTMLScriptElement>(`script[src^="${TURNSTILE_SRC}"]`);
      if (existing) {
        existing.addEventListener('load', () => resolve(), { once: true });
        existing.addEventListener('error', () => reject(new Error('Turnstile failed to load')), {
          once: true,
        });
        return;
      }
      const script = document.createElement('script');
      script.src = TURNSTILE_SRC;
      script.async = true;
      script.onload = () => resolve();
      script.onerror = () => reject(new Error('Turnstile failed to load'));
      document.head.appendChild(script);
    });
    return turnstileLoader;
  }

  function setStatus(el: HTMLElement | null, message: string, kind: 'ok' | 'err' | 'idle') {
    if (!el) return;
    el.textContent = message;
    el.classList.toggle('hidden', !message);
    el.classList.toggle('text-gel', kind === 'ok');
    el.classList.toggle('text-gold', kind === 'err');
    el.classList.toggle('text-muted', kind === 'idle');
  }

  function syncPreferredContact(form: HTMLFormElement) {
    const preferred =
      form.querySelector<HTMLInputElement>('input[name="preferredContact"]:checked')?.value ||
      'email';
    const emailInput = form.querySelector<HTMLInputElement>('input[name="email"]');
    const phoneInput = form.querySelector<HTMLInputElement>('input[name="phone"]');
    const emailHint = form.querySelector<HTMLElement>('[data-field="email"] [data-optional-hint]');
    const phoneHint = form.querySelector<HTMLElement>('[data-field="phone"] [data-optional-hint]');

    if (!emailInput || !phoneInput) return;

    const preferEmail = preferred === 'email';
    const preferPhone = preferred === 'phone';

    emailInput.required = preferEmail;
    phoneInput.required = preferPhone;

    if (emailHint) emailHint.hidden = preferEmail;
    if (phoneHint) phoneHint.hidden = preferPhone;
  }

  async function setupForm(form: HTMLFormElement) {
    if (form.dataset.bound === '1') return;
    form.dataset.bound = '1';

    const siteKey = form.dataset.turnstileSitekey || '';
    const statusEl = form.querySelector<HTMLElement>('[data-inquiry-status]');
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    let widgetId: string | undefined;

    form.querySelectorAll<HTMLInputElement>('input[name="preferredContact"]').forEach((input) => {
      input.addEventListener('change', () => syncPreferredContact(form));
    });
    syncPreferredContact(form);

    if (siteKey) {
      try {
        await loadTurnstile();
        const mount = form.querySelector<HTMLElement>('[data-turnstile-mount]');
        const api = turnstileApi();
        if (mount && api) {
          widgetId = api.render(mount, {
            sitekey: siteKey,
            theme: 'dark',
          });
        }
      } catch {
        setStatus(statusEl, 'Verification widget failed to load. Refresh and try again.', 'err');
        if (submitBtn) submitBtn.disabled = true;
      }
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!siteKey || !submitBtn) return;

      const api = turnstileApi();
      const token =
        (widgetId !== undefined && api ? api.getResponse(widgetId) : '') || '';
      if (!token) {
        setStatus(statusEl, 'Please complete the verification check.', 'err');
        return;
      }

      const fd = new FormData(form);
      const preferredContact = String(fd.get('preferredContact') || 'email').trim();
      const email = String(fd.get('email') || '').trim();
      const phone = String(fd.get('phone') || '').trim();

      if (preferredContact !== 'email' && preferredContact !== 'phone') {
        setStatus(statusEl, 'Please choose a preferred contact method.', 'err');
        return;
      }
      if (preferredContact === 'email' && !email) {
        setStatus(statusEl, 'Please enter an email address.', 'err');
        return;
      }
      if (preferredContact === 'phone' && !phone) {
        setStatus(statusEl, 'Please enter a phone number.', 'err');
        return;
      }

      const type = String(fd.get('type') || form.dataset.inquiryType || '');
      const payload: Record<string, string> = {
        type,
        name: String(fd.get('name') || '').trim(),
        preferredContact,
        email,
        phone,
        message: String(fd.get('message') || '').trim(),
        turnstileToken: token,
      };
      if (type === 'casting') {
        payload.organization = String(fd.get('organization') || '').trim();
      } else {
        payload.format = String(fd.get('format') || '').trim();
      }

      submitBtn.disabled = true;
      setStatus(statusEl, 'Sending…', 'idle');

      try {
        const res = await fetch('/api/contactInquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = (await res.json().catch(() => ({}))) as {
          error?: string;
          correlationId?: string;
          ok?: boolean;
        };

        if (!res.ok) {
          const ref = data.correlationId ? ` Reference: ${data.correlationId}` : '';
          setStatus(statusEl, `${data.error || 'Something went wrong.'}${ref}`, 'err');
          if (widgetId !== undefined && api) api.reset(widgetId);
          return;
        }

        form.reset();
        syncPreferredContact(form);
        if (widgetId !== undefined && api) api.reset(widgetId);
        setStatus(
          statusEl,
          'Thanks — your message was sent. Elyse will follow up using your preferred contact method.',
          'ok',
        );
      } catch {
        setStatus(statusEl, 'Network error — please try again.', 'err');
        if (widgetId !== undefined && api) api.reset(widgetId);
      } finally {
        submitBtn.disabled = false;
      }
    });
  }

  document.querySelectorAll<HTMLFormElement>('[data-inquiry-form]').forEach((form) => {
    void setupForm(form);
  });
</script>
