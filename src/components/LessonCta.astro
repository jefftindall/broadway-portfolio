---
import { site } from '../lib/site';
---

<div class="rounded-sm border border-line bg-panel/60 p-8 md:p-10">
  <h2 class="font-display text-3xl text-spotlight">Study with Elyse</h2>
  <p class="mt-3 max-w-xl text-muted">
    Musical theatre coaching for students who want craft, confidence, and audition readiness.
  </p>
  <div class="mt-6 flex flex-wrap gap-4">
    <a
      href="/lessons"
      class="rounded-sm bg-gel px-5 py-3 text-sm font-semibold text-spotlight hover:brightness-110"
    >
      Lessons
    </a>
    <a
      href={`mailto:${site.email}?subject=${encodeURIComponent('Lesson Inquiry')}`}
      class="rounded-sm border border-line px-5 py-3 text-sm text-spotlight hover:border-gold"
    >
      Email to inquire
    </a>
  </div>
</div>
