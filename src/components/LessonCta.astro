---
import { site } from '../lib/site';
import GlassPanel from './GlassPanel.astro';
import CtaLink from './CtaLink.astro';
---

<GlassPanel strong class="p-8 md:p-10">
  <h2 class="font-display text-3xl text-spotlight">Study voice with Elyse</h2>
  <p class="mt-3 max-w-xl text-muted">
    Private voice lessons rooted in vocal pedagogy, vocal health, and CCM — NYC or Zoom.
  </p>
  <div class="mt-6 flex flex-wrap gap-4">
    <CtaLink href="/lessons" variant="gel">Lessons</CtaLink>
    <CtaLink
      href={`mailto:${site.email}?subject=${encodeURIComponent('Lesson Inquiry')}`}
      variant="secondary"
    >
      Email to inquire
    </CtaLink>
  </div>
</GlassPanel>
