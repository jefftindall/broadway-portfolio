---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LessonsModule from '../components/LessonsModule.astro';
import ContactLanes from '../components/ContactLanes.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ShowCard from '../components/ShowCard.astro';
import PostCard from '../components/PostCard.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import GlassPanel from '../components/GlassPanel.astro';
import { site } from '../lib/site';
import { buildPersonJsonLd } from '../lib/personSchema';
import { getFeaturedShowsForHome } from '../lib/shows';
import PressQuote from '../components/PressQuote.astro';

const shows = await getCollection('shows');
const featured = getFeaturedShowsForHome(shows);
const news = (await getCollection('news'))
  .filter((n) => !n.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const person = buildPersonJsonLd({
  '@id': `${site.url}/#person`,
});
delete person['@context'];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    person,
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: site.url,
      name: site.name,
      description: site.description,
      publisher: { '@id': `${site.url}/#person` },
    },
    {
      '@type': 'VideoObject',
      name: 'NYC Cabaret — Stage Kiss',
      description: 'Elyse Tindall performs Stage Kiss at Ripley-Grier Studios, New York City.',
      thumbnailUrl: new URL('/images/photos/cabaret-reel-poster.jpg', site.url).href,
      uploadDate: '2024-08-01',
      contentUrl: site.reelUrl,
      embedUrl: 'https://www.youtube.com/embed/41jdPTkN_Sw',
    },
  ],
};
---

<BaseLayout
  description={site.description}
  image={site.heroImage}
  jsonLd={jsonLd}
  hideFooterCta
>
  <Hero />

  <section class="border-b border-line" aria-label="Press quote">
    <div class="mx-auto max-w-6xl px-6 py-10 md:py-12">
      <PressQuote quote={site.pressQuote.quote} attribution={site.pressQuote.attribution} />
    </div>
  </section>

  <section class="section-y" aria-labelledby="performance-heading">
    <div class="mx-auto max-w-6xl px-6">
      <div id="performance-heading">
        <SectionHeader
          eyebrow="Performance"
          title="Stage & reel"
          support="Recent credits and the NYC cabaret monologue from Stage Kiss."
          href="/shows"
          linkLabel="All credits →"
        />
      </div>

      <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_1.05fr]">
        <div>
          {
            featured.map((show) => (
              <ShowCard
                title={show.data.title}
                year={show.data.year}
                role={show.data.role}
                venue={show.data.venue}
                synopsis={show.data.synopsis}
                featured={show.data.featured}
                image={show.data.image}
                imageFocus={show.data.imageFocus}
              />
            ))
          }
        </div>
        <div id="reel">
          <GlassPanel strong class="overflow-hidden p-2 md:p-3">
            <VideoEmbed
              url={site.reelUrl}
              title="NYC Cabaret — Stage Kiss reel"
              poster="/images/photos/cabaret-reel-poster.jpg"
            />
            <div class="px-3 pb-3 pt-4 md:px-4">
              <p class="font-display text-2xl text-spotlight">Watch reel</p>
              <p class="mt-1 text-sm text-muted">
                Stage Kiss — NYC debut at Ripley-Grier Studios
              </p>
            </div>
          </GlassPanel>
        </div>
      </div>
    </div>
  </section>

  <LessonsModule compact />

  <ContactLanes />

  <section class="section-y border-t border-line" aria-labelledby="news-heading">
    <div class="mx-auto max-w-6xl px-6">
      <div id="news-heading">
        <SectionHeader
          eyebrow="Updates"
          title="News"
          href="/news"
          linkLabel="All news →"
        />
      </div>
      <div class="mt-6">
        {
          news.map((post) => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              href={`/news/${post.id}`}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
