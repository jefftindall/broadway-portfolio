---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/site';

const description =
  'Terms and conditions for using elysetindall.com, including portfolio materials, inquiry forms, and private voice lesson requests.';
---

<BaseLayout title="Terms" description={description} hideFooterCta>
  <section class="mx-auto max-w-3xl px-6 py-16 md:py-24">
    <p class="text-sm uppercase tracking-[0.2em] text-gel">Legal</p>
    <h1 class="mt-3 font-display text-5xl text-spotlight md:text-6xl">Terms &amp; conditions</h1>
    <p class="mt-4 text-muted">
      Rules for using {site.name}’s website ({site.url.replace(/^https:\/\//, '')}). By using this
      site, you agree to these terms.
    </p>

    <div class="prose-site mt-12">
      <h2 id="acceptance">Acceptance</h2>
      <p>
        If you do not agree, please do not use the site. We may update these terms; the version
        posted here is the current one. Continued use after changes means you accept the updated
        terms.
      </p>

      <h2 id="site-purpose">Site purpose</h2>
      <p>
        This website presents {site.name}’s work as a musical theatre actress and vocal coach, and
        provides ways to request casting materials or inquire about private <strong
          >voice lessons</strong
        > (vocal pedagogy, vocal health, and contemporary commercial music). The site does not
        offer acting lessons, monologue coaching, or scene study as advertised services.
      </p>

      <h2 id="content">Portfolio content</h2>
      <p>
        Photos, video, copy, resume materials, and other content on this site are owned by{' '}
        {site.name} or used with permission. You may view them for casting, booking, or personal
        interest. You may not copy, redistribute, train AI systems on, or commercially reuse site
        content without prior written permission, except for ordinary casting/review use of
        downloadable materials provided for that purpose (for example a resume PDF or headshot
        offered on the Materials page).
      </p>

      <h2 id="inquiries">Inquiry forms &amp; contact</h2>
      <p>
        Casting and lesson forms are for genuine professional or lesson inquiries. Do not submit
        spam, abusive content, or false information. Submitting a form does not create a booking,
        engagement, or employment relationship. Availability, rates, and lesson policies are
        confirmed separately if we agree to work together.
      </p>
      <p>
        How we handle personal information is described in the{' '}
        <a href="/privacy">Privacy Policy</a>, including{' '}
        <a href="/privacy#sms">SMS notifications</a>.
      </p>

      <h2 id="lessons">Voice lessons</h2>
      <p>
        Lesson inquiries may lead to private voice instruction. Schedules, fees, cancellation, and
        studio policies will be communicated outside these website terms before you book. Nothing on
        this site is medical advice; voice work is educational and artistic in nature.
      </p>

      <h2 id="third-parties">Third-party services</h2>
      <p>
        The site may use third-party providers for hosting, form verification, email, SMS, and
        analytics. Links to Instagram, YouTube, or other sites are provided for convenience; we are
        not responsible for their content or policies.
      </p>

      <h2 id="disclaimers">Disclaimers</h2>
      <p>
        The site is provided “as is.” We strive for accuracy but do not warrant that content is
        complete, current, or uninterrupted. To the fullest extent permitted by law, {site.name} is
        not liable for indirect or consequential damages arising from use of the site. Our total
        liability for claims relating to the website itself is limited to the greater of zero (for
        free site use) or amounts you paid specifically for website-related services in the three
        months before the claim (if any).
      </p>

      <h2 id="indemnity">Indemnity</h2>
      <p>
        You agree to indemnify and hold {site.name} harmless from claims arising out of your misuse
        of the site or violation of these terms.
      </p>

      <h2 id="governing-law">Governing law</h2>
      <p>
        These terms are governed by the laws of the State of New York, without regard to conflict of
        law rules. Courts located in New York County, New York are the exclusive venue for disputes
        arising from these terms or use of the site, except where prohibited by law.
      </p>

      <h2 id="contact">Contact</h2>
      <p>
        Questions about these terms:{' '}
        <a href={`mailto:${site.email}`}>{site.email}</a>
        {' · '}
        <a href="/contact">Contact</a>
        {' · '}
        <a href="/privacy">Privacy</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  :global(.prose-site h2) {
    scroll-margin-top: 5rem;
  }
</style>
