---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CreditList from '../components/CreditList.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import GlassPanel from '../components/GlassPanel.astro';
import { site } from '../lib/site';
import { buildReelVideoJsonLd } from '../lib/reelPoster';

const shows = (await getCollection('shows')).sort((a, b) => {
  if (b.data.year !== a.data.year) return b.data.year - a.data.year;
  return (a.data.order ?? 99) - (b.data.order ?? 99);
});

const jsonLd = buildReelVideoJsonLd({
  name: site.reelTitle,
  contentUrl: site.reelUrl,
  posterPath: site.reelPoster,
  siteUrl: site.url,
});
---

<BaseLayout
  title="Shows"
  description="Credits for Elyse Tindall — musicals, plays, film, and NYC cabaret."
  image={site.reelPoster}
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-6xl px-6 py-16 md:py-24">
    <p class="text-sm uppercase tracking-[0.2em] text-gel">Credits</p>
    <h1 class="mt-3 font-display text-5xl text-spotlight md:text-6xl">Shows</h1>
    <p class="mt-4 max-w-2xl text-muted">
      Roles, venues, and recent work for casting — filter by musical, play, cabaret, or film.
    </p>

    <div id="reel" class="mt-12">
      <GlassPanel strong class="overflow-hidden p-2 md:grid md:grid-cols-[1.2fr_0.8fr] md:gap-6 md:p-3">
        <VideoEmbed
          url={site.reelUrl}
          title={site.reelTitle}
          poster={site.reelPoster}
        />
        <div class="flex flex-col justify-center px-4 py-5 md:px-2">
          <p class="text-sm uppercase tracking-[0.2em] text-gold">Reel</p>
          <h2 class="mt-2 font-display text-3xl text-spotlight">Stage Kiss — NYC Cabaret</h2>
          <p class="mt-2 text-sm text-muted">
            Ripley-Grier Studios, New York City
          </p>
        </div>
      </GlassPanel>
    </div>

    <div class="mt-14">
      <CreditList shows={shows} showVideos={false} />
    </div>
  </section>
</BaseLayout>
