---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ShowCard from '../components/ShowCard.astro';
import VideoEmbed from '../components/VideoEmbed.astro';

const shows = (await getCollection('shows')).sort((a, b) => {
  if (b.data.year !== a.data.year) return b.data.year - a.data.year;
  return (a.data.order ?? 99) - (b.data.order ?? 99);
});
---

<BaseLayout
  title="Shows"
  description="Stage credits for Elyse Tindall — musicals, plays, and NYC cabaret."
>
  <section class="mx-auto max-w-6xl px-6 py-16 md:py-24">
    <p class="text-sm uppercase tracking-[0.2em] text-gel">Credits</p>
    <h1 class="mt-3 font-display text-5xl text-spotlight md:text-6xl">Shows</h1>
    <p class="mt-4 max-w-2xl text-muted">
      Fresh credits for casting — roles, venues, and recent work. Updated as bookings land.
    </p>
    <div class="mt-10">
      {
        shows.map((show) => (
          <div>
            <ShowCard
              title={show.data.title}
              year={show.data.year}
              role={show.data.role}
              venue={show.data.venue}
              synopsis={show.data.synopsis}
              featured={show.data.featured}
            />
            {show.data.videoUrl && (
              <div class="mb-8 max-w-2xl">
                <VideoEmbed url={show.data.videoUrl} title={show.data.title} />
              </div>
            )}
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
