---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Studio"
  description="Private content studio for Elyse Tindall."
  hideFooterCta={true}
>
  <section class="mx-auto max-w-xl px-4 py-8 md:py-12">
    <p class="text-sm uppercase tracking-[0.2em] text-gel">Private</p>
    <h1 class="mt-2 font-display text-4xl text-spotlight">Studio</h1>
    <p class="mt-3 text-sm text-muted">
      Tell me what to update — shows, news, lessons, about, gallery, or casting pages. Changes commit to GitHub and go live after the site rebuilds (usually a few minutes).
    </p>

    <div
      id="auth-user"
      class="mt-8 hidden flex flex-wrap items-center justify-between gap-3 border-b border-line pb-4 text-sm text-muted"
    >
      <p>
        Signed in as <span id="auth-user-name" class="text-spotlight"></span>
      </p>
      <a
        href="/.auth/logout?post_logout_redirect_uri=/"
        class="text-sm text-gel underline-offset-2 hover:text-gold hover:underline"
      >
        Sign out
      </a>
    </div>

    <div id="auth-gate" class="mt-8 hidden rounded-sm border border-line bg-panel/60 p-4 text-sm text-muted">
      <p>Sign in required to publish.</p>
      <a
        id="login-link"
        href="/.auth/login/aad"
        class="mt-4 inline-flex rounded-sm bg-gold px-4 py-2 text-sm font-semibold text-ink"
      >
        Sign in
      </a>
    </div>

    <div id="publisher-gate" class="mt-8 hidden rounded-sm border border-line bg-panel/60 p-4 text-sm text-muted">
      <p>
        You are signed in, but this account is not on the publisher allowlist. Ask an admin to add your
        identity from <code class="text-spotlight">/.auth/me</code> to
        <code class="text-spotlight">ALLOWED-USER-IDS</code>, then sign out and back in if needed.
      </p>
    </div>

    <div id="studio-app" class="mt-8 space-y-4">
      <div
        id="log"
        class="max-h-64 space-y-3 overflow-y-auto rounded-sm border border-line bg-panel/40 p-4 text-sm"
        aria-live="polite"
      >
        <p class="text-muted">Ready when you are.</p>
      </div>

      <label class="block text-sm text-muted">
        Message
        <textarea
          id="message"
          rows="4"
          class="mt-2 w-full rounded-sm border border-line bg-ink px-3 py-3 text-spotlight outline-none focus:border-gold"
          placeholder='e.g. "I just booked Lily in Anastasia at the Strand, July 2025"'
        ></textarea>
      </label>

      <label class="block text-sm text-muted">
        Photo (optional)
        <input
          id="photo"
          type="file"
          accept="image/jpeg,image/png,image/webp"
          class="mt-2 block w-full text-sm text-muted file:mr-3 file:rounded-sm file:border-0 file:bg-stage file:px-3 file:py-2 file:text-spotlight"
        />
      </label>

      <div class="flex flex-wrap gap-3">
        <button
          id="mic"
          type="button"
          class="rounded-sm border border-line px-4 py-3 text-sm text-spotlight hover:border-gold"
        >
          Hold to speak
        </button>
        <button
          id="send"
          type="button"
          class="rounded-sm bg-gold px-5 py-3 text-sm font-semibold text-ink hover:brightness-110"
        >
          Publish update
        </button>
      </div>
      <p id="status" class="text-xs text-muted"></p>
    </div>
  </section>

  <script>
    import { flush, trackEvent, trackException } from '../scripts/app-insights';

    const logEl = document.getElementById('log')!;
    const messageEl = document.getElementById('message') as HTMLTextAreaElement;
    const photoEl = document.getElementById('photo') as HTMLInputElement;
    const sendBtn = document.getElementById('send') as HTMLButtonElement;
    const micBtn = document.getElementById('mic') as HTMLButtonElement;
    const statusEl = document.getElementById('status')!;
    const authGate = document.getElementById('auth-gate')!;
    const publisherGate = document.getElementById('publisher-gate')!;
    const authUser = document.getElementById('auth-user')!;
    const authUserName = document.getElementById('auth-user-name')!;
    const studioApp = document.getElementById('studio-app')!;

    const UNAUTHORIZED_STATUS =
      'Signed in, but this account cannot publish. Ask an admin to update the allowlist.';

    const EMAIL_CLAIM_TYPES = new Set([
      'http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress',
      'emails',
      'email',
    ]);

    type ClientPrincipal = {
      userId?: string;
      userDetails?: string;
      claims?: Array<{ typ?: string; val?: string }>;
    };

    function displayNameFromPrincipal(principal: ClientPrincipal): string {
      const claims = Array.isArray(principal.claims) ? principal.claims : [];
      const email = claims.find((c) => c.typ && EMAIL_CLAIM_TYPES.has(c.typ) && c.val)?.val;
      return String(email || principal.userDetails || principal.userId || '').trim() || 'Unknown';
    }

    function setEditorEnabled(enabled: boolean) {
      if (enabled) {
        studioApp.classList.remove('opacity-50', 'pointer-events-none');
        sendBtn.disabled = false;
      } else {
        studioApp.classList.add('opacity-50', 'pointer-events-none');
        sendBtn.disabled = true;
      }
    }

    function appendLog(role: 'you' | 'studio', text: string) {
      const p = document.createElement('p');
      p.className = role === 'you' ? 'text-spotlight' : 'text-gel';
      p.textContent = (role === 'you' ? 'You: ' : 'Studio: ') + text;
      logEl.appendChild(p);
      logEl.scrollTop = logEl.scrollHeight;
    }

    async function checkPublisherStatus(): Promise<boolean> {
      const res = await fetch('/api/publisherStatus');
      if (!res.ok) return false;
      const data = await res.json();
      return Boolean(data?.authorized);
    }

    async function checkAuth() {
      let clientPrincipal: ClientPrincipal | null | undefined;
      try {
        const res = await fetch('/.auth/me');
        const data = await res.json();
        clientPrincipal = data?.clientPrincipal as ClientPrincipal | null | undefined;
      } catch {
        // Local dev: allow UI without SWA auth
        authUser.classList.add('hidden');
        authGate.classList.add('hidden');
        publisherGate.classList.add('hidden');
        setEditorEnabled(true);
        return true;
      }

      if (!clientPrincipal) {
        authUser.classList.add('hidden');
        authGate.classList.remove('hidden');
        publisherGate.classList.add('hidden');
        setEditorEnabled(false);
        return false;
      }

      authUserName.textContent = displayNameFromPrincipal(clientPrincipal);
      authUser.classList.remove('hidden');
      authGate.classList.add('hidden');

      let authorized = false;
      try {
        authorized = await checkPublisherStatus();
      } catch {
        authorized = false;
      }

      if (!authorized) {
        publisherGate.classList.remove('hidden');
        setEditorEnabled(false);
        return false;
      }

      publisherGate.classList.add('hidden');
      setEditorEnabled(true);
      return true;
    }

    async function resizeImage(file: File): Promise<{ name: string; contentType: string; dataBase64: string } | null> {
      const bitmap = await createImageBitmap(file);
      const max = 1600;
      const scale = Math.min(1, max / Math.max(bitmap.width, bitmap.height));
      const w = Math.round(bitmap.width * scale);
      const h = Math.round(bitmap.height * scale);
      const canvas = document.createElement('canvas');
      canvas.width = w;
      canvas.height = h;
      const ctx = canvas.getContext('2d');
      if (!ctx) return null;
      ctx.drawImage(bitmap, 0, 0, w, h);
      const blob: Blob | null = await new Promise((resolve) =>
        canvas.toBlob((b) => resolve(b), 'image/jpeg', 0.85),
      );
      if (!blob) return null;
      const buffer = await blob.arrayBuffer();
      let binary = '';
      const bytes = new Uint8Array(buffer);
      for (let i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]!);
      const dataBase64 = btoa(binary);
      const safe = file.name.replace(/[^a-zA-Z0-9._-]/g, '-').replace(/\.\w+$/, '.jpg');
      return { name: safe, contentType: 'image/jpeg', dataBase64 };
    }

    sendBtn.addEventListener('click', async () => {
      const message = messageEl.value.trim();
      if (!message) {
        statusEl.textContent = 'Write a message first.';
        return;
      }
      sendBtn.disabled = true;
      statusEl.textContent = 'Publishing…';
      appendLog('you', message);

      let photo: { name: string; contentType: string; dataBase64: string } | undefined;
      if (photoEl.files?.[0]) {
        const resized = await resizeImage(photoEl.files[0]);
        if (resized) photo = resized;
      }

      try {
        const res = await fetch('/api/updateContent', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message, photo }),
        });
        const data = await res.json();
        if (!res.ok) {
          appendLog('studio', data.error || 'Update failed.');
          const reason = res.status === 401 ? 'unauthorized' : 'http_error';
          statusEl.textContent = res.status === 401 ? UNAUTHORIZED_STATUS : 'Something went wrong.';
          trackEvent('StudioPublishUiFailed', { status: String(res.status), reason });
          flush();
          if (res.status === 401) {
            publisherGate.classList.remove('hidden');
            setEditorEnabled(false);
          }
        } else {
          appendLog('studio', data.reply || 'Update committed. Site will rebuild shortly.');
          messageEl.value = '';
          photoEl.value = '';
          statusEl.textContent = 'Done. Live in a few minutes after the build finishes.';
          trackEvent('StudioPublishUiSuccess');
          flush();
        }
      } catch (err) {
        appendLog('studio', 'Network error — try again.');
        statusEl.textContent = 'Network error.';
        trackException(err, { operation: 'studioPublish' });
        flush();
      } finally {
        if (publisherGate.classList.contains('hidden') && authGate.classList.contains('hidden')) {
          sendBtn.disabled = false;
        }
      }
    });

    type StudioSpeechRecognition = {
      continuous: boolean;
      interimResults: boolean;
      lang: string;
      start: () => void;
      stop: () => void;
      onresult: ((event: { results: ArrayLike<ArrayLike<{ transcript: string }>> }) => void) | null;
      onerror: (() => void) | null;
    };

    type SpeechRecognitionCtor = new () => StudioSpeechRecognition;

    const SpeechRecognitionCtor =
      (window as unknown as { SpeechRecognition?: SpeechRecognitionCtor }).SpeechRecognition ||
      (window as unknown as { webkitSpeechRecognition?: SpeechRecognitionCtor }).webkitSpeechRecognition;

    if (SpeechRecognitionCtor) {
      const recognition = new SpeechRecognitionCtor();
      recognition.continuous = false;
      recognition.interimResults = true;
      recognition.lang = 'en-US';

      micBtn.addEventListener('pointerdown', () => {
        try {
          recognition.start();
          micBtn.textContent = 'Listening…';
          statusEl.textContent = 'Speak now';
        } catch {
          /* already started */
        }
      });
      micBtn.addEventListener('pointerup', () => {
        recognition.stop();
        micBtn.textContent = 'Hold to speak';
      });
      recognition.onresult = (event) => {
        let transcript = '';
        for (let i = 0; i < event.results.length; i++) {
          transcript += event.results[i]![0]!.transcript;
        }
        messageEl.value = transcript;
      };
      recognition.onerror = () => {
        micBtn.textContent = 'Hold to speak';
        statusEl.textContent = 'Mic unavailable — type instead.';
      };
    } else {
      micBtn.disabled = true;
      micBtn.textContent = 'Voice not supported';
    }

    checkAuth();
  </script>
</BaseLayout>
