---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Studio"
  description="Private content studio for Elyse Tindall."
  hideFooterCta={true}
>
  <section class="mx-auto max-w-xl px-4 py-8 md:py-12">
    <p class="text-sm uppercase tracking-[0.2em] text-gel">Private</p>
    <h1 class="mt-2 font-display text-4xl text-spotlight">Studio</h1>
    <p class="mt-3 text-sm text-muted">
      Draft a change (type or speak), optionally add a photo, preview and edit the post, then
      publish. Updates go live after the site rebuilds (usually a few minutes).
    </p>

    <div
      id="auth-user"
      class="mt-8 hidden flex flex-wrap items-center justify-between gap-3 border-b border-line pb-4 text-sm text-muted"
    >
      <p>
        Signed in as <span id="auth-user-name" class="text-spotlight"></span>
      </p>
      <a
        href="/.auth/logout?post_logout_redirect_uri=/"
        class="text-sm text-gel underline-offset-2 hover:text-gold hover:underline"
      >
        Sign out
      </a>
    </div>

    <div
      id="access-check"
      class="mt-8 rounded-sm border border-line bg-panel/60 p-4 text-sm text-muted"
      role="status"
      aria-live="polite"
    >
      <p>Checking access…</p>
    </div>

    <div id="auth-gate" class="mt-8 hidden rounded-sm border border-line bg-panel/60 p-4 text-sm text-muted">
      <p>Sign in required to publish.</p>
      <a
        id="login-link"
        href="/.auth/login/aad"
        class="mt-4 inline-flex rounded-sm bg-gold px-4 py-2 text-sm font-semibold text-ink"
      >
        Sign in
      </a>
    </div>

    <div id="publisher-gate" class="mt-8 hidden rounded-sm border border-line bg-panel/60 p-4 text-sm text-muted">
      <p>You’re signed in, but this account can’t publish updates.</p>
      <p class="mt-3">
        Share this reference with an admin:&nbsp;<code
          id="publisher-correlation"
          class="break-all text-spotlight"></code>
      </p>
    </div>

    <div id="studio-app" class="mt-8 hidden space-y-6">
      <ol class="flex flex-wrap gap-x-4 gap-y-1 text-xs uppercase tracking-[0.15em] text-muted" aria-hidden="true">
        <li id="step-indicator-compose" class="text-gel">1. Compose</li>
        <li id="step-indicator-preview">2. Preview</li>
        <li id="step-indicator-done">3. Done</li>
      </ol>

      <div id="compose-step" class="space-y-4">
        <label class="block text-sm text-muted">
          Message
          <textarea
            id="message"
            rows="4"
            class="mt-2 w-full rounded-sm border border-line bg-ink px-3 py-3 text-spotlight outline-none focus:border-gold"
            placeholder='e.g. "I just booked Lily in Anastasia at the Strand, July 2025"'
          ></textarea>
        </label>

        <div class="flex flex-wrap gap-3">
          <button
            id="mic"
            type="button"
            class="rounded-sm border border-line px-4 py-3 text-sm text-spotlight hover:border-gold"
          >
            Hold to speak
          </button>
        </div>

        <label class="block text-sm text-muted">
          Photo (optional)
          <input
            id="photo"
            type="file"
            accept="image/jpeg,image/png,image/webp"
            class="mt-2 block w-full text-sm text-muted file:mr-3 file:rounded-sm file:border-0 file:bg-stage file:px-3 file:py-2 file:text-spotlight"
          />
        </label>
        <div id="photo-preview-wrap" class="hidden">
          <img
            id="photo-preview"
            alt="Selected photo preview"
            class="max-h-40 rounded-sm border border-line object-cover"
          />
        </div>

        <button
          id="preview-btn"
          type="button"
          data-label="Preview update"
          class="rounded-sm bg-gold px-5 py-3 text-sm font-semibold text-ink hover:brightness-110 disabled:cursor-wait disabled:opacity-60 disabled:hover:brightness-100"
        >
          Preview update
        </button>
      </div>

      <div id="preview-step" class="hidden space-y-4">
        <p id="preview-reply" class="text-sm text-gel"></p>
        <div id="changes-editor" class="space-y-4"></div>
        <div class="flex flex-wrap gap-3">
          <button
            id="back-btn"
            type="button"
            class="rounded-sm border border-line px-4 py-3 text-sm text-spotlight hover:border-gold disabled:cursor-wait disabled:opacity-60"
          >
            Back
          </button>
          <button
            id="publish-btn"
            type="button"
            data-label="Publish to site"
            class="rounded-sm bg-gold px-5 py-3 text-sm font-semibold text-ink hover:brightness-110 disabled:cursor-wait disabled:opacity-60 disabled:hover:brightness-100"
          >
            Publish to site
          </button>
        </div>
      </div>

      <div id="done-step" class="hidden space-y-4">
        <div class="rounded-sm border border-line bg-panel/40 p-4 space-y-3">
          <p class="text-sm font-semibold text-spotlight">Update accepted</p>
          <p id="done-reply" class="text-sm text-gel"></p>
          <p id="done-sha" class="text-xs text-muted"></p>
        </div>

        <div class="space-y-2">
          <p class="text-xs uppercase tracking-[0.15em] text-muted">Publishing pipeline</p>
          <ul id="pipeline-list" class="space-y-2 text-sm text-muted"></ul>
        </div>

        <div class="space-y-2">
          <p class="text-xs uppercase tracking-[0.15em] text-muted">Pages</p>
          <ul id="page-links" class="space-y-2 text-sm"></ul>
        </div>

        <button
          id="another-btn"
          type="button"
          class="rounded-sm border border-line px-4 py-3 text-sm text-spotlight hover:border-gold"
        >
          Start another update
        </button>
      </div>

      <p id="status" class="text-xs text-muted" role="status" aria-live="polite"></p>
    </div>
  </section>

  <script>
    import { flush, trackEvent, trackException, trackMetric } from '../scripts/app-insights';

    type PhotoPayload = { name: string; contentType: string; dataBase64: string };
    type ContentChange = {
      tool?: string;
      path: string;
      content: string;
      commitMessage: string;
      summary?: string;
    };
    type PublishAction = {
      tool?: string;
      summary?: string;
      path?: string;
      url?: string | null;
    };

    const BUSY_CLASS = 'opacity-60';
    const POLL_MS = 5000;
    const POLL_TIMEOUT_MS = 15 * 60 * 1000;

    const messageEl = document.getElementById('message') as HTMLTextAreaElement;
    const photoEl = document.getElementById('photo') as HTMLInputElement;
    const photoPreviewWrap = document.getElementById('photo-preview-wrap')!;
    const photoPreview = document.getElementById('photo-preview') as HTMLImageElement;
    const previewBtn = document.getElementById('preview-btn') as HTMLButtonElement;
    const publishBtn = document.getElementById('publish-btn') as HTMLButtonElement;
    const backBtn = document.getElementById('back-btn') as HTMLButtonElement;
    const anotherBtn = document.getElementById('another-btn') as HTMLButtonElement;
    const micBtn = document.getElementById('mic') as HTMLButtonElement;
    const statusEl = document.getElementById('status')!;
    const composeStep = document.getElementById('compose-step')!;
    const previewStep = document.getElementById('preview-step')!;
    const doneStep = document.getElementById('done-step')!;
    const changesEditor = document.getElementById('changes-editor')!;
    const previewReply = document.getElementById('preview-reply')!;
    const doneReply = document.getElementById('done-reply')!;
    const doneSha = document.getElementById('done-sha')!;
    const pipelineList = document.getElementById('pipeline-list')!;
    const pageLinks = document.getElementById('page-links')!;
    const stepCompose = document.getElementById('step-indicator-compose')!;
    const stepPreview = document.getElementById('step-indicator-preview')!;
    const stepDone = document.getElementById('step-indicator-done')!;
    const accessCheck = document.getElementById('access-check')!;
    const authGate = document.getElementById('auth-gate')!;
    const publisherGate = document.getElementById('publisher-gate')!;
    const publisherCorrelation = document.getElementById('publisher-correlation')!;
    const authUser = document.getElementById('auth-user')!;
    const authUserName = document.getElementById('auth-user-name')!;
    const studioApp = document.getElementById('studio-app')!;

    let draftPhoto: PhotoPayload | undefined;
    let provisionalPhotoPath: string | null = null;
    let draftChanges: ContentChange[] = [];
    let pollTimer: number | null = null;
    let pollStartedAt = 0;
    let publishClickedAt = 0;
    let prodLatencyEmitted = false;
    let micSupported = true;

    const EMAIL_CLAIM_TYPES = new Set([
      'http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress',
      'emails',
      'email',
    ]);

    type ClientPrincipal = {
      userId?: string;
      userDetails?: string;
      claims?: Array<{ typ?: string; val?: string }>;
    };

    function displayNameFromPrincipal(principal: ClientPrincipal): string {
      const claims = Array.isArray(principal.claims) ? principal.claims : [];
      const email = claims.find((c) => c.typ && EMAIL_CLAIM_TYPES.has(c.typ) && c.val)?.val;
      return String(email || principal.userDetails || principal.userId || '').trim() || 'Unknown';
    }

    function setStatus(text: string) {
      statusEl.textContent = text;
    }

    function setBusy(busy: boolean, primary?: HTMLButtonElement, workingLabel?: string) {
      studioApp.setAttribute('aria-busy', busy ? 'true' : 'false');
      if (busy) {
        studioApp.classList.add(BUSY_CLASS);
      } else {
        studioApp.classList.remove(BUSY_CLASS);
      }

      if (primary && workingLabel) {
        if (busy) {
          primary.dataset.restoreLabel = primary.dataset.label || primary.textContent || '';
          primary.textContent = workingLabel;
        } else if (primary.dataset.restoreLabel) {
          primary.textContent = primary.dataset.restoreLabel;
          delete primary.dataset.restoreLabel;
        } else if (primary.dataset.label) {
          primary.textContent = primary.dataset.label;
        }
      }
    }

    function setComposeBusy(busy: boolean) {
      setBusy(busy, previewBtn, 'Preparing preview…');
      previewBtn.disabled = busy;
      messageEl.disabled = busy;
      photoEl.disabled = busy;
      micBtn.disabled = busy || !micSupported;
    }

    function setPreviewBusy(busy: boolean) {
      setBusy(busy, publishBtn, 'Publishing…');
      publishBtn.disabled = busy;
      backBtn.disabled = busy;
      changesEditor.querySelectorAll('input, textarea').forEach((el) => {
        (el as HTMLInputElement | HTMLTextAreaElement).disabled = busy;
      });
    }

    function hideAccessCheck() {
      accessCheck.classList.add('hidden');
    }

    function showStudioApp() {
      hideAccessCheck();
      authGate.classList.add('hidden');
      publisherGate.classList.add('hidden');
      studioApp.classList.remove('hidden');
      setComposeBusy(false);
      setPreviewBusy(false);
    }

    function showSignInGate() {
      hideAccessCheck();
      authUser.classList.add('hidden');
      authGate.classList.remove('hidden');
      publisherGate.classList.add('hidden');
      studioApp.classList.add('hidden');
    }

    function showPublisherDenied(correlationId?: string) {
      hideAccessCheck();
      authGate.classList.add('hidden');
      studioApp.classList.add('hidden');
      publisherCorrelation.textContent = correlationId || 'unavailable';
      publisherGate.classList.remove('hidden');
    }

    function setStepIndicators(active: 'compose' | 'preview' | 'done') {
      const map = {
        compose: stepCompose,
        preview: stepPreview,
        done: stepDone,
      };
      for (const [key, el] of Object.entries(map)) {
        if (key === active) el.classList.add('text-gel');
        else el.classList.remove('text-gel');
      }
    }

    function showCompose() {
      stopPolling();
      composeStep.classList.remove('hidden');
      previewStep.classList.add('hidden');
      doneStep.classList.add('hidden');
      setStepIndicators('compose');
    }

    function showPreview() {
      composeStep.classList.add('hidden');
      previewStep.classList.remove('hidden');
      doneStep.classList.add('hidden');
      setStepIndicators('preview');
    }

    function showDone() {
      composeStep.classList.add('hidden');
      previewStep.classList.add('hidden');
      doneStep.classList.remove('hidden');
      setStepIndicators('done');
    }

    function formatApiError(data: { error?: string; correlationId?: string }, fallback: string) {
      const friendly =
        typeof data.error === 'string' && data.error.trim() ? data.error.trim() : fallback;
      const correlationId =
        typeof data.correlationId === 'string' ? data.correlationId : undefined;
      return correlationId ? `${friendly} Reference: ${correlationId}` : friendly;
    }

    function stopPolling() {
      if (pollTimer != null) {
        window.clearTimeout(pollTimer);
        pollTimer = null;
      }
    }

    function pipelineLabel(status: string) {
      switch (status) {
        case 'success':
          return 'Complete';
        case 'failure':
          return 'Failed';
        case 'skipped':
          return 'Skipped';
        case 'in_progress':
          return 'In progress';
        case 'queued':
          return 'Queued';
        default:
          return 'Waiting…';
      }
    }

    function renderPipeline(data: {
      status?: string;
      runUrl?: string | null;
      jobs?: Array<{ name: string; status: string }>;
    }) {
      pipelineList.replaceChildren();

      const overall = document.createElement('li');
      overall.className = 'flex flex-wrap items-baseline justify-between gap-2';
      const overallLabel = document.createElement('span');
      overallLabel.textContent = 'Site rebuild';
      const overallStatus = document.createElement('span');
      overallStatus.className = 'text-spotlight';
      overallStatus.textContent = pipelineLabel(String(data.status || 'unknown'));
      overall.append(overallLabel, overallStatus);
      pipelineList.appendChild(overall);

      const jobs = Array.isArray(data.jobs) ? data.jobs : [];
      const interesting = jobs.filter((j) =>
        /staging|production|deploy/i.test(j.name || ''),
      );
      for (const job of interesting.length ? interesting : jobs.slice(0, 4)) {
        const li = document.createElement('li');
        li.className = 'flex flex-wrap items-baseline justify-between gap-2 pl-2 text-xs';
        const name = document.createElement('span');
        name.textContent = job.name;
        const st = document.createElement('span');
        st.className = 'text-spotlight';
        st.textContent = pipelineLabel(job.status);
        li.append(name, st);
        pipelineList.appendChild(li);
      }

      if (data.runUrl) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = data.runUrl;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        a.className = 'text-gel underline-offset-2 hover:text-gold hover:underline';
        a.textContent = 'View build details';
        li.appendChild(a);
        pipelineList.appendChild(li);
      }
    }

    function renderPageLinks(actions: PublishAction[]) {
      pageLinks.replaceChildren();
      const seen = new Set<string>();
      for (const action of actions) {
        const url = typeof action.url === 'string' ? action.url : '';
        if (!url || url.startsWith('/images/') || seen.has(url)) continue;
        seen.add(url);

        const li = document.createElement('li');
        li.className = 'flex flex-wrap items-center justify-between gap-2';
        li.dataset.url = url;

        const label = document.createElement('span');
        label.className = 'text-muted';
        label.textContent = action.summary || url;

        const link = document.createElement('a');
        link.href = url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.className =
          'pointer-events-none text-xs text-muted opacity-50';
        link.textContent = 'Checking…';
        link.dataset.live = 'false';

        li.append(label, link);
        pageLinks.appendChild(li);
      }

      if (!pageLinks.children.length) {
        const li = document.createElement('li');
        li.className = 'text-muted';
        li.textContent = 'No public page links for this update.';
        pageLinks.appendChild(li);
      }
    }

    async function checkPageLive(url: string): Promise<boolean> {
      try {
        const res = await fetch(`${url}?t=${Date.now()}`, {
          method: 'GET',
          cache: 'no-store',
          credentials: 'same-origin',
        });
        return res.ok;
      } catch {
        return false;
      }
    }

    async function refreshLiveLinks() {
      const items = Array.from(pageLinks.querySelectorAll('li[data-url]')) as HTMLElement[];
      await Promise.all(
        items.map(async (li) => {
          const url = li.dataset.url;
          const link = li.querySelector('a') as HTMLAnchorElement | null;
          if (!url || !link || link.dataset.live === 'true') return;
          const live = await checkPageLive(url);
          if (live) {
            link.dataset.live = 'true';
            link.textContent = 'View page';
            link.className = 'text-gel underline-offset-2 hover:text-gold hover:underline';
            link.classList.remove('pointer-events-none', 'opacity-50');
          } else {
            link.textContent = 'Waiting for rebuild…';
          }
        }),
      );
    }

    function maybeEmitProdLatency(
      data: { jobs?: Array<{ name: string; status: string }> },
      sha: string,
    ) {
      if (prodLatencyEmitted || !publishClickedAt) return;
      const jobs = Array.isArray(data.jobs) ? data.jobs : [];
      const prodDeploy = jobs.find(
        (j) => /deploy\s+production/i.test(j.name || '') && j.status === 'success',
      );
      if (!prodDeploy) return;

      prodLatencyEmitted = true;
      const durationMs = Math.max(0, Date.now() - publishClickedAt);
      trackEvent('StudioPublishToProdCompleted', {
        durationMs: String(durationMs),
        commitSha: sha,
      });
      trackMetric('StudioPublishToProdDurationMs', durationMs, {
        commitSha: sha,
      });
      flush();
    }

    async function pollOnce(sha: string) {
      try {
        const res = await fetch(`/api/publishStatus?sha=${encodeURIComponent(sha)}`);
        const data = await res.json();
        if (res.ok) {
          renderPipeline(data);
          maybeEmitProdLatency(data, sha);
          if (data.status === 'failure') {
            setStatus(
              'The site rebuild reported a failure. Share this with support if it keeps happening.',
            );
            stopPolling();
            return;
          }
          if (data.status === 'success') {
            setStatus('Rebuild finished. Use View page when the link is ready.');
          }
        }
      } catch {
        /* keep polling */
      }

      await refreshLiveLinks();

      const elapsed = Date.now() - pollStartedAt;
      if (elapsed >= POLL_TIMEOUT_MS) {
        setStatus('Still rebuilding — check back in a few minutes, or use View page if it appears.');
        stopPolling();
        return;
      }

      pollTimer = window.setTimeout(() => {
        void pollOnce(sha);
      }, POLL_MS);
    }

    function startProgressTracking(sha: string | undefined, actions: PublishAction[]) {
      prodLatencyEmitted = false;
      renderPipeline({ status: 'queued', jobs: [] });
      renderPageLinks(actions);
      void refreshLiveLinks();

      if (!sha) {
        setStatus('Accepted. Waiting for the site rebuild…');
        return;
      }

      pollStartedAt = Date.now();
      setStatus('Accepted. Watching the rebuild…');
      void pollOnce(sha);
    }

    async function checkPublisherStatus(): Promise<{ authorized: boolean; correlationId?: string }> {
      const res = await fetch('/api/publisherStatus');
      if (!res.ok) return { authorized: false };
      const data = await res.json();
      return {
        authorized: Boolean(data?.authorized),
        correlationId: typeof data?.correlationId === 'string' ? data.correlationId : undefined,
      };
    }

    async function checkAuth() {
      let clientPrincipal: ClientPrincipal | null | undefined;
      try {
        const res = await fetch('/.auth/me');
        const data = await res.json();
        clientPrincipal = data?.clientPrincipal as ClientPrincipal | null | undefined;
      } catch {
        authUser.classList.add('hidden');
        showStudioApp();
        return true;
      }

      if (!clientPrincipal) {
        showSignInGate();
        return false;
      }

      authUserName.textContent = displayNameFromPrincipal(clientPrincipal);
      authUser.classList.remove('hidden');

      let status: { authorized: boolean; correlationId?: string } = { authorized: false };
      try {
        status = await checkPublisherStatus();
      } catch {
        status = { authorized: false };
      }

      if (!status.authorized) {
        showPublisherDenied(status.correlationId);
        return false;
      }

      showStudioApp();
      return true;
    }

    async function resizeImage(file: File): Promise<PhotoPayload | null> {
      const bitmap = await createImageBitmap(file);
      const max = 1600;
      const scale = Math.min(1, max / Math.max(bitmap.width, bitmap.height));
      const w = Math.round(bitmap.width * scale);
      const h = Math.round(bitmap.height * scale);
      const canvas = document.createElement('canvas');
      canvas.width = w;
      canvas.height = h;
      const ctx = canvas.getContext('2d');
      if (!ctx) return null;
      ctx.drawImage(bitmap, 0, 0, w, h);
      const blob: Blob | null = await new Promise((resolve) =>
        canvas.toBlob((b) => resolve(b), 'image/jpeg', 0.85),
      );
      if (!blob) return null;
      const buffer = await blob.arrayBuffer();
      let binary = '';
      const bytes = new Uint8Array(buffer);
      for (let i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]!);
      const dataBase64 = btoa(binary);
      const safe = file.name.replace(/[^a-zA-Z0-9._-]/g, '-').replace(/\.\w+$/, '.jpg');
      return { name: safe, contentType: 'image/jpeg', dataBase64 };
    }

    function renderChangesEditor(changes: ContentChange[]) {
      changesEditor.replaceChildren();
      changes.forEach((change, index) => {
        const wrap = document.createElement('div');
        wrap.className = 'space-y-2 rounded-sm border border-line bg-panel/40 p-4';
        wrap.dataset.index = String(index);

        const meta = document.createElement('p');
        meta.className = 'text-xs text-muted';
        meta.textContent = [change.tool, change.path].filter(Boolean).join(' · ');
        wrap.appendChild(meta);

        if (change.summary) {
          const summary = document.createElement('p');
          summary.className = 'text-sm text-spotlight';
          summary.textContent = change.summary;
          wrap.appendChild(summary);
        }

        const pathLabel = document.createElement('label');
        pathLabel.className = 'block text-sm text-muted';
        pathLabel.textContent = 'Path';
        const pathInput = document.createElement('input');
        pathInput.type = 'text';
        pathInput.value = change.path;
        pathInput.dataset.field = 'path';
        pathInput.className =
          'mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 font-mono text-xs text-spotlight outline-none focus:border-gold';
        pathLabel.appendChild(pathInput);
        wrap.appendChild(pathLabel);

        const contentLabel = document.createElement('label');
        contentLabel.className = 'block text-sm text-muted';
        contentLabel.textContent = 'Content';
        const contentArea = document.createElement('textarea');
        contentArea.rows = 12;
        contentArea.value = change.content;
        contentArea.dataset.field = 'content';
        contentArea.className =
          'mt-1 w-full rounded-sm border border-line bg-ink px-3 py-3 font-mono text-xs text-spotlight outline-none focus:border-gold';
        contentLabel.appendChild(contentArea);
        wrap.appendChild(contentLabel);

        const msgLabel = document.createElement('label');
        msgLabel.className = 'block text-sm text-muted';
        msgLabel.textContent = 'Commit message';
        const msgInput = document.createElement('input');
        msgInput.type = 'text';
        msgInput.value = change.commitMessage;
        msgInput.dataset.field = 'commitMessage';
        msgInput.className =
          'mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold';
        msgLabel.appendChild(msgInput);
        wrap.appendChild(msgLabel);

        changesEditor.appendChild(wrap);
      });
    }

    function readEditedChanges(): ContentChange[] {
      const blocks = Array.from(changesEditor.children) as HTMLElement[];
      return blocks.map((block, index) => {
        const base = draftChanges[index] || { path: '', content: '', commitMessage: '' };
        const path =
          (block.querySelector('[data-field="path"]') as HTMLInputElement | null)?.value.trim() ||
          base.path;
        const content =
          (block.querySelector('[data-field="content"]') as HTMLTextAreaElement | null)?.value ??
          base.content;
        const commitMessage =
          (block.querySelector('[data-field="commitMessage"]') as HTMLInputElement | null)?.value.trim() ||
          base.commitMessage;
        return {
          tool: base.tool,
          summary: base.summary,
          path,
          content,
          commitMessage,
        };
      });
    }

    function resetComposeForm() {
      messageEl.value = '';
      photoEl.value = '';
      draftPhoto = undefined;
      provisionalPhotoPath = null;
      draftChanges = [];
      photoPreviewWrap.classList.add('hidden');
      photoPreview.removeAttribute('src');
      changesEditor.replaceChildren();
      previewReply.textContent = '';
      doneReply.textContent = '';
      doneSha.textContent = '';
      pipelineList.replaceChildren();
      pageLinks.replaceChildren();
    }

    photoEl.addEventListener('change', () => {
      const file = photoEl.files?.[0];
      if (!file) {
        photoPreviewWrap.classList.add('hidden');
        photoPreview.removeAttribute('src');
        return;
      }
      const url = URL.createObjectURL(file);
      photoPreview.src = url;
      photoPreviewWrap.classList.remove('hidden');
    });

    previewBtn.addEventListener('click', async () => {
      const message = messageEl.value.trim();
      if (!message) {
        setStatus('Write a message first.');
        return;
      }

      setComposeBusy(true);
      setStatus('Preparing preview…');

      draftPhoto = undefined;
      if (photoEl.files?.[0]) {
        const resized = await resizeImage(photoEl.files[0]);
        if (resized) draftPhoto = resized;
      }

      try {
        const res = await fetch('/api/updateContent', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mode: 'draft', message, photo: draftPhoto }),
        });
        const data = await res.json();
        if (!res.ok) {
          const reason = res.status === 401 ? 'unauthorized' : 'http_error';
          const correlationId =
            typeof data.correlationId === 'string' ? data.correlationId : undefined;
          if (res.status === 401) {
            setStatus(formatApiError(data, 'This account can’t publish updates.'));
            showPublisherDenied(correlationId);
          } else {
            setStatus(formatApiError(data, 'Something went wrong while drafting.'));
          }
          trackEvent('StudioPublishUiFailed', {
            status: String(res.status),
            reason,
            operation: 'draft',
            ...(correlationId ? { correlationId } : {}),
          });
          flush();
          return;
        }

        const changes = Array.isArray(data.changes) ? (data.changes as ContentChange[]) : [];
        if (!changes.length) {
          setStatus(
            typeof data.reply === 'string' && data.reply.trim()
              ? data.reply.trim()
              : 'No website update was drafted. Try being more specific.',
          );
          return;
        }

        draftChanges = changes.map((c) => ({
          tool: c.tool,
          path: String(c.path || ''),
          content: String(c.content ?? ''),
          commitMessage: String(c.commitMessage || ''),
          summary: c.summary ? String(c.summary) : undefined,
        }));
        provisionalPhotoPath =
          typeof data.provisionalPhotoPath === 'string' ? data.provisionalPhotoPath : null;
        previewReply.textContent =
          typeof data.reply === 'string' && data.reply.trim()
            ? data.reply.trim()
            : 'Review the draft below, edit if needed, then publish.';
        renderChangesEditor(draftChanges);
        showPreview();
        setStatus('Review the draft, edit if needed, then publish.');
      } catch (err) {
        setStatus('Network error — try again.');
        trackException(err, { operation: 'studioDraft' });
        flush();
      } finally {
        if (!studioApp.classList.contains('hidden') && !composeStep.classList.contains('hidden')) {
          setComposeBusy(false);
        } else if (!studioApp.classList.contains('hidden')) {
          setBusy(false);
          studioApp.classList.remove(BUSY_CLASS);
        }
      }
    });

    backBtn.addEventListener('click', () => {
      showCompose();
      setStatus('');
    });

    publishBtn.addEventListener('click', async () => {
      const changes = readEditedChanges();
      if (!changes.length) {
        setStatus('Nothing to publish.');
        return;
      }

      publishClickedAt = Date.now();
      prodLatencyEmitted = false;
      setPreviewBusy(true);
      setStatus('Publishing…');

      try {
        const res = await fetch('/api/updateContent', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            mode: 'publish',
            changes,
            photo: draftPhoto,
            provisionalPhotoPath,
          }),
        });
        const data = await res.json();
        if (!res.ok) {
          const reason = res.status === 401 ? 'unauthorized' : 'http_error';
          const correlationId =
            typeof data.correlationId === 'string' ? data.correlationId : undefined;
          if (res.status === 401) {
            setStatus(formatApiError(data, 'This account can’t publish updates.'));
            showPublisherDenied(correlationId);
          } else {
            setStatus(formatApiError(data, 'Something went wrong while publishing.'));
          }
          trackEvent('StudioPublishUiFailed', {
            status: String(res.status),
            reason,
            operation: 'publish',
            ...(correlationId ? { correlationId } : {}),
          });
          flush();
          return;
        }

        const actions = Array.isArray(data.actions) ? (data.actions as PublishAction[]) : [];
        const commitSha = typeof data.commitSha === 'string' ? data.commitSha : undefined;
        doneReply.textContent =
          typeof data.reply === 'string' && data.reply.trim()
            ? data.reply.trim()
            : 'Your update was committed. The site will rebuild shortly.';
        doneSha.textContent = commitSha ? `Commit ${commitSha.slice(0, 7)}` : '';
        showDone();
        setBusy(false);
        studioApp.classList.remove(BUSY_CLASS);
        startProgressTracking(commitSha, actions);
        trackEvent('StudioPublishUiSuccess', {
          ...(commitSha ? { commitSha } : {}),
        });
        flush();
      } catch (err) {
        setStatus('Network error — try again.');
        trackException(err, { operation: 'studioPublish' });
        flush();
      } finally {
        if (!studioApp.classList.contains('hidden') && !previewStep.classList.contains('hidden')) {
          setPreviewBusy(false);
        }
      }
    });

    anotherBtn.addEventListener('click', () => {
      stopPolling();
      resetComposeForm();
      showCompose();
      setComposeBusy(false);
      setStatus('');
    });

    type StudioSpeechRecognition = {
      continuous: boolean;
      interimResults: boolean;
      lang: string;
      start: () => void;
      stop: () => void;
      onresult: ((event: { results: ArrayLike<ArrayLike<{ transcript: string }>> }) => void) | null;
      onerror: (() => void) | null;
    };

    type SpeechRecognitionCtor = new () => StudioSpeechRecognition;

    const SpeechRecognitionCtor =
      (window as unknown as { SpeechRecognition?: SpeechRecognitionCtor }).SpeechRecognition ||
      (window as unknown as { webkitSpeechRecognition?: SpeechRecognitionCtor }).webkitSpeechRecognition;

    if (SpeechRecognitionCtor) {
      const recognition = new SpeechRecognitionCtor();
      recognition.continuous = false;
      recognition.interimResults = true;
      recognition.lang = 'en-US';

      micBtn.addEventListener('pointerdown', () => {
        if (micBtn.disabled) return;
        try {
          recognition.start();
          micBtn.textContent = 'Listening…';
          setStatus('Speak now');
        } catch {
          /* already started */
        }
      });
      micBtn.addEventListener('pointerup', () => {
        recognition.stop();
        micBtn.textContent = 'Hold to speak';
      });
      recognition.onresult = (event) => {
        let transcript = '';
        for (let i = 0; i < event.results.length; i++) {
          transcript += event.results[i]![0]!.transcript;
        }
        messageEl.value = transcript;
      };
      recognition.onerror = () => {
        micBtn.textContent = 'Hold to speak';
        setStatus('Mic unavailable — type instead.');
      };
    } else {
      micSupported = false;
      micBtn.disabled = true;
      micBtn.textContent = 'Voice not supported';
    }

    checkAuth();
  </script>
</BaseLayout>
