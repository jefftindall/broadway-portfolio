---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const pages = (await getCollection('casting')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout
  title="For casting"
  description="Casting pages for Elyse Tindall — type, role, and credit landers for directors and agents."
  canonicalPath="/for"
>
  <section class="mx-auto max-w-3xl px-6 py-12 md:py-16">
    <p class="text-sm uppercase tracking-[0.2em] text-gel">Casting</p>
    <h1 class="mt-3 font-display text-5xl text-spotlight md:text-6xl">For casting</h1>
    <p class="mt-4 text-lg text-muted">
      Type- and credit-focused pages for casting directors and agents. For reel, resume, and
      headshot, go to{' '}
      <a href="/materials" class="text-gel underline underline-offset-4 hover:text-spotlight">
        Materials
      </a>.
    </p>

    <ul class="mt-12 space-y-6">
      {
        pages.map((page) => (
          <li class="border-b border-line pb-6">
            <a
              href={`/for/${page.id}`}
              class="font-display text-2xl text-spotlight transition hover:text-gold md:text-3xl"
            >
              {page.data.title}
            </a>
            <p class="mt-2 text-sm text-muted">{page.data.description}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
