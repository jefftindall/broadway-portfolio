    galleryPreviewBtn.addEventListener('click', async () => {
      const file = galleryPhotoEl.files?.[0];
      if (!file) {
        setStatus('Choose a photo first.');
        return;
      }
      if (!galleryPhotoDuplicatePath) {
        galleryPhotoDuplicatePath = await checkPhotoDuplicate(file);
        if (galleryPhotoDuplicatePath) {
          showDuplicateWarning(galleryDupWarn, galleryPhotoDuplicatePath);
        }
      }
      if (!confirmIfDuplicate(galleryPhotoDuplicatePath)) {
        setStatus('Choose a different photo, or confirm when ready to publish a duplicate.');
        return;
      }
      if (photoTooLarge(file)) {
        setStatus('That photo is larger than 12 MB. Choose a smaller file.');
        return;
      }
      const photo = await photoPayloadFromFile(file);
      if (!photo) {
        setStatus('Could not read that photo. Try a JPEG, PNG, or WebP.');
        return;
      }
      const tags = readGalleryTags();
      const focus = readGalleryFocus();
      if (!syncGallerySlugFeedback()) {
        setStatus(gallerySlugError.textContent || 'Fix the gallery file name, then try again.');
        gallerySlugInput.focus();
        return;
      }
      const slugResult = validateGallerySlug(gallerySlugInput.value);
      const args: Record<string, unknown> = {
        tags,
        focus,
      };
      if (!slugResult.empty) args.slug = slugResult.slug;
      await runDiscretePreview(
        'add_gallery_photo',
        args,
        'Could not prepare gallery photo.',
        photo,
      );
    });

