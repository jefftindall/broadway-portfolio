    function readGalleryFocus(): string {
      if (galleryFocusSelect.value === 'custom') {
        return galleryFocusCustom.value.trim() || 'center';
      }
      return galleryFocusSelect.value || 'center';
    }

    function readGalleryTags(): string[] {
      return [
        ...new Set(
          Array.from(
            document.querySelectorAll<HTMLInputElement>('input[name="gallery-tag"]:checked'),
          ).map((el) => el.value.trim()),
        ),
      ].filter(Boolean);
    }

    function syncGallerySlugFeedback(): boolean {
      const result = validateGallerySlug(gallerySlugInput.value);
      gallerySlugInput.setAttribute('aria-invalid', result.ok ? 'false' : 'true');
      if (result.ok) {
        gallerySlugError.textContent = '';
        gallerySlugError.classList.add('hidden');
        gallerySlugInput.classList.remove('border-red-400');
        gallerySlugHint.textContent = result.empty
          ? 'Will auto-name from the photo; Studio adds .md automatically.'
          : `Will save as ${result.repoPath}`;
        return true;
      }
      gallerySlugHint.textContent = '';
      gallerySlugError.textContent = result.error || 'That file name isn’t valid.';
      gallerySlugError.classList.remove('hidden');
      gallerySlugInput.classList.add('border-red-400');
      return false;
    }

    function syncGalleryFocusPreview() {
      const focus = readGalleryFocus();
      galleryPhotoPreview.style.objectPosition = focus;
      if (galleryFocusSelect.value === 'custom') {
        galleryFocusCustomWrap.classList.remove('hidden');
      } else {
        galleryFocusCustomWrap.classList.add('hidden');
      }
    }

    photoEl.addEventListener('change', () => {
      const file = photoEl.files?.[0];
      askPhotoDuplicatePath = null;
      clearDuplicateWarning(photoDupWarn);
      if (!file) {
        photoPreviewWrap.classList.add('hidden');
        photoPreview.removeAttribute('src');
        return;
      }
      const url = URL.createObjectURL(file);
      photoPreview.src = url;
      photoPreviewWrap.classList.remove('hidden');
      void checkPhotoDuplicate(file).then((hit) => {
        if (photoEl.files?.[0] !== file) return;
        askPhotoDuplicatePath = hit;
        if (hit) {
          showDuplicateWarning(photoDupWarn, hit);
          setStatus(`Duplicate photo warning — already on the site as ${hit}.`);
        }
      });
    });

    galleryPhotoEl.addEventListener('change', () => {
      const file = galleryPhotoEl.files?.[0];
      galleryPhotoDuplicatePath = null;
      clearDuplicateWarning(galleryDupWarn);
      if (!file) {
        galleryPhotoPreviewWrap.classList.add('hidden');
        galleryPhotoPreview.removeAttribute('src');
        return;
      }
      const url = URL.createObjectURL(file);
      galleryPhotoPreview.src = url;
      galleryPhotoPreviewWrap.classList.remove('hidden');
      syncGalleryFocusPreview();
      void checkPhotoDuplicate(file).then((hit) => {
        if (galleryPhotoEl.files?.[0] !== file) return;
        galleryPhotoDuplicatePath = hit;
        if (hit) {
          showDuplicateWarning(galleryDupWarn, hit);
          setStatus(`Duplicate photo warning — already on the site as ${hit}.`);
        }
