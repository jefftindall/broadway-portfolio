    type LiveDiscreteDefaults = {
      rate30: string;
      rate60: string;
      availability: string;
      vocalType: string;
      vocalRange: string;
      union: string;
      playingAge: string;
      height: string;
      ethnicity: string;
      reelUrl: string;
      reelTitle: string;
      shortBio: string;
      pressQuote: string;
      pressAttribution: string;
    };

    /** Snapshot of current live values for “Reset to live” on discrete forms. */
    let liveDiscreteDefaults: LiveDiscreteDefaults = {
      rate30: quickRate30.value,
      rate60: quickRate60.value,
      availability: factAvailability.value,
      vocalType: factVocalType.value,
      vocalRange: factVocalRange.value,
      union: factUnion.value,
      playingAge: factPlayingAge.value,
      height: factHeight.value,
      ethnicity: factEthnicity.value,
      reelUrl: reelUrlInput.value,
      reelTitle: reelTitleInput.value,
      shortBio: shortBioInput.value,
      pressQuote: pressQuoteInput.value,
      pressAttribution: pressAttributionInput.value,
    };

    function captureLiveDiscreteDefaultsFromForm() {
      liveDiscreteDefaults = {
        rate30: quickRate30.value,
        rate60: quickRate60.value,
        availability: factAvailability.value,
        vocalType: factVocalType.value,
        vocalRange: factVocalRange.value,
        union: factUnion.value,
        playingAge: factPlayingAge.value,
        height: factHeight.value,
        ethnicity: factEthnicity.value,
        reelUrl: reelUrlInput.value,
        reelTitle: reelTitleInput.value,
        shortBio: shortBioInput.value,
        pressQuote: pressQuoteInput.value,
        pressAttribution: pressAttributionInput.value,
      };
    }

    function applyLiveDiscreteDefaults(task: HubTask) {
      const live = liveDiscreteDefaults;
      if (task === 'gallery') {
        resetGalleryForm();
        return;
      }
      if (task === 'rates') {
        quickRate30.value = live.rate30;
        quickRate60.value = live.rate60;
        return;
      }
      if (task === 'facts') {
        factAvailability.value = live.availability;
        factVocalType.value = live.vocalType;
        factVocalRange.value = live.vocalRange;
        factUnion.value = live.union;
        factPlayingAge.value = live.playingAge;
        factHeight.value = live.height;
        factEthnicity.value = live.ethnicity;
        return;
      }
      if (task === 'reel') {
        reelUrlInput.value = live.reelUrl;
        reelTitleInput.value = live.reelTitle;
        return;
      }
      if (task === 'bio') {
        shortBioInput.value = live.shortBio;
        return;
      }
      if (task === 'quote') {
        pressQuoteInput.value = live.pressQuote;
        pressAttributionInput.value = live.pressAttribution;
      }
    }

    function resetGalleryForm() {
      galleryPhotoEl.value = '';
      galleryPhotoPreviewWrap.classList.add('hidden');
      galleryPhotoPreview.removeAttribute('src');
      galleryPhotoPreview.style.objectPosition = 'center';
      clearDuplicateWarning(galleryDupWarn);
      galleryPhotoDuplicatePath = null;
      galleryFocusSelect.value = 'center';
      galleryFocusCustom.value = '';
      galleryFocusCustomWrap.classList.add('hidden');
      gallerySlugInput.value = '';
      syncGallerySlugFeedback();
      document.querySelectorAll<HTMLInputElement>('input[name="gallery-tag"]').forEach((el) => {
        el.checked = false;
      });
    }

    function parseImageHashIndex(): Record<string, string> {
      try {
        const raw = studioApp.dataset.imageHashes || '{}';
        const parsed = JSON.parse(raw) as unknown;
        if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) return {};
        return parsed as Record<string, string>;
      } catch {
        return {};
      }
    }

    const imageHashes = parseImageHashIndex();

    async function sha256Hex(buffer: ArrayBuffer): Promise<string> {
      const digest = await crypto.subtle.digest('SHA-256', buffer);
      return [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, '0')).join('');
    }

    function clearDuplicateWarning(el: HTMLElement) {
      el.classList.add('hidden');
      el.textContent = '';
    }

    function showDuplicateWarning(el: HTMLElement, existingPath: string) {
      el.textContent = `This exact photo is already on the site (${existingPath}). Publishing again will create a duplicate. Choose a different file, or continue if you mean to.`;
      el.classList.remove('hidden');
    }

    async function checkPhotoDuplicate(file: File): Promise<string | null> {
      if (!Object.keys(imageHashes).length) return null;
      try {
        const hash = await sha256Hex(await file.arrayBuffer());
        const hit = imageHashes[hash];
        return typeof hit === 'string' && hit ? hit : null;
      } catch {
        return null;
      }
    }

    function confirmIfDuplicate(existingPath: string | null): boolean {
      if (!existingPath) return true;
      return window.confirm(
        `This exact photo is already on the site (${existingPath}). Publish a duplicate anyway?`,
      );
    }

    function resetDiscreteFormToLive(task: HubTask) {
      applyLiveDiscreteDefaults(task);
      setStatus('Restored current live values.');
    }

    function syncLiveDefaultsFromPublishedChanges(changes: ContentChange[]) {
      let touched = false;
      for (const change of changes) {
        const preview = change.preview;
        if (change.tool === 'update_lesson_rates' && preview?.kind === 'rates') {
          for (const rate of preview.rates) {
            if (rate.id === '30min') quickRate30.value = String(rate.priceAmount ?? '');
            if (rate.id === '60min') quickRate60.value = String(rate.priceAmount ?? '');
          }
          touched = true;
        }
        if (change.tool === 'update_performer_facts' && preview?.kind === 'performer') {
          const p = preview.performer;
          factAvailability.value = String(p.availability || '');
          factVocalType.value = String(p.vocalType || '');
          factVocalRange.value = String(p.vocalRange || '');
          factUnion.value = String(p.union || '');
          factPlayingAge.value = String(p.playingAge || '');
          factHeight.value = String(p.height || '');
          factEthnicity.value = String(p.ethnicity || '');
          touched = true;
        }
        if (change.tool === 'update_reel_url' && preview?.kind === 'reel') {
          reelUrlInput.value = preview.reelUrl || '';
          reelTitleInput.value = preview.reelTitle || '';
          touched = true;
        }
        if (change.tool === 'update_short_bio' && preview?.kind === 'shortBio') {
          shortBioInput.value = preview.shortBio || '';
          touched = true;
        }
        if (change.tool === 'update_press_quote' && preview?.kind === 'pressQuote') {
          pressQuoteInput.value = preview.quote || '';
          pressAttributionInput.value = preview.attribution || '';
          touched = true;
        }
      }
      if (touched) captureLiveDiscreteDefaultsFromForm();
    }

    const TASK_TITLES: Record<HubTask, string> = {
      ask: 'Speak or type',
      gallery: 'Gallery photo',
      rates: 'Lesson rates',
      facts: 'Performer facts',
      reel: 'Reel link',
      bio: 'Short bio',
      quote: 'Press quote',
    };

    let draftPhoto: PhotoPayload | undefined;
    let provisionalPhotoPath: string | null = null;
    let draftChanges: ContentChange[] = [];
    /** Exact content-hash match against live gallery/photos (warn-only). */
    let askPhotoDuplicatePath: string | null = null;
    let galleryPhotoDuplicatePath: string | null = null;
    let pollTimer: number | null = null;
    let pollStartedAt = 0;
    let publishClickedAt = 0;
    let prodLatencyEmitted = false;
    let micSupported = true;

    const EMAIL_CLAIM_TYPES = new Set([
      'http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress',
      'emails',
      'email',
    ]);

    type ClientPrincipal = {
      userId?: string;
      userDetails?: string;
      claims?: Array<{ typ?: string; val?: string }>;
    };

    function displayNameFromPrincipal(principal: ClientPrincipal): string {
      const claims = Array.isArray(principal.claims) ? principal.claims : [];
      const email = claims.find((c) => c.typ && EMAIL_CLAIM_TYPES.has(c.typ) && c.val)?.val;
      return String(email || principal.userDetails || principal.userId || '').trim() || 'Unknown';
    }

    function setStatus(text: string, busy = false) {
      if (!text) {
        clearStudioStatus(statusEl);
        return;
      }
      setStudioStatus(statusEl, text, busy);
    }

    function setBusy(busy: boolean, primary?: HTMLButtonElement, workingLabel?: string) {
      studioApp.setAttribute('aria-busy', busy ? 'true' : 'false');
      if (busy) {
        studioApp.classList.add(BUSY_CLASS);
      } else {
        studioApp.classList.remove(BUSY_CLASS);
      }

      if (primary) {
        if (busy && workingLabel) {
          setButtonBusy(primary, true, workingLabel);
        } else if (!busy) {
          setButtonBusy(primary, false);
        }
      }
    }

    function setComposeBusy(busy: boolean) {
      const primary =
        activeTask === 'gallery'
          ? galleryPreviewBtn
          : activeTask === 'rates'
            ? quickRatesBtn
            : activeTask === 'facts'
              ? factsPreviewBtn
              : activeTask === 'reel'
                ? reelPreviewBtn
                : activeTask === 'bio'
                  ? bioPreviewBtn
                  : activeTask === 'quote'
                    ? quotePreviewBtn
                    : previewBtn;
      setBusy(busy, primary, 'Preparing preview…');
      previewBtn.disabled = busy;
      galleryPreviewBtn.disabled = busy;
      galleryResetBtn.disabled = busy;
      quickRatesBtn.disabled = busy;
      ratesResetBtn.disabled = busy;
      factsPreviewBtn.disabled = busy;
      factsResetBtn.disabled = busy;
      reelPreviewBtn.disabled = busy;
      reelResetBtn.disabled = busy;
      bioPreviewBtn.disabled = busy;
      bioResetBtn.disabled = busy;
      quotePreviewBtn.disabled = busy;
      quoteResetBtn.disabled = busy;
      messageEl.disabled = busy;
      photoEl.disabled = busy;
      galleryPhotoEl.disabled = busy;
      galleryFocusSelect.disabled = busy;
      galleryFocusCustom.disabled = busy;
      gallerySlugInput.disabled = busy;
      document.querySelectorAll<HTMLInputElement>('input[name="gallery-tag"]').forEach((el) => {
        el.disabled = busy;
      });
      micBtn.disabled = busy || !micSupported;
      quickRate30.disabled = busy;
      quickRate60.disabled = busy;
      factAvailability.disabled = busy;
      factVocalType.disabled = busy;
      factVocalRange.disabled = busy;
      factUnion.disabled = busy;
      factPlayingAge.disabled = busy;
      factHeight.disabled = busy;
      factEthnicity.disabled = busy;
      reelUrlInput.disabled = busy;
      reelTitleInput.disabled = busy;
      shortBioInput.disabled = busy;
      pressQuoteInput.disabled = busy;
      pressAttributionInput.disabled = busy;
      hubBackBtn.disabled = busy;
      document.querySelectorAll<HTMLButtonElement>('.hub-tile').forEach((el) => {
        el.disabled = busy;
      });
    }

    function setPreviewBusy(busy: boolean) {
      setBusy(busy, publishBtn, 'Publishing…');
      publishBtn.disabled = busy;
      backBtn.disabled = busy;
      // Keep hub escape available unless we're mid-publish.
      hubBackBtn.disabled = busy;
      changesEditor.querySelectorAll('input, textarea').forEach((el) => {
        (el as HTMLInputElement | HTMLTextAreaElement).disabled = busy;
      });
    }

    /** Clear compose + preview busy locks (labels, disabled controls, opacity). */
    function unlockStudioUi() {
      setComposeBusy(false);
      setPreviewBusy(false);
    }

    function isDoneVisible() {
      return !doneStep.classList.contains('hidden');
    }

    function hideAccessCheck() {
      accessCheck.classList.add('hidden');
    }

    function showStudioApp() {
      hideAccessCheck();
      authGate.classList.add('hidden');
      publisherGate.classList.add('hidden');
      studioApp.classList.remove('hidden');
      unlockStudioUi();
      showHub();
      void loadDiscreteDefaults();
    }

    function showSignInGate() {
      hideAccessCheck();
      authUser.classList.add('hidden');
      authGate.classList.remove('hidden');
      publisherGate.classList.add('hidden');
      studioApp.classList.add('hidden');
    }

    function applySessionCapabilities(session: StudioSession) {
      return hasStudioPermission(session, STUDIO_PERMISSION.CONTENT_PUBLISH);
    }

    function showPublisherDenied(
      correlationId?: string,
      opts: { apiUnavailable?: boolean } = {},
    ) {
      hideAccessCheck();
      authGate.classList.add('hidden');
      studioApp.classList.add('hidden');
      if (opts.apiUnavailable) {
        publisherDeniedMsg.textContent =
          'You’re signed in, but we couldn’t verify Studio permissions. The Studio API may be temporarily unavailable — try again in a few minutes.';
        publisherCorrelationWrap.classList.add('hidden');
      } else {
        publisherDeniedMsg.textContent =
          'You’re signed in, but this account doesn’t have Studio permissions yet.';
        if (correlationId) {
          publisherCorrelationWrap.classList.remove('hidden');
          publisherCorrelation.textContent = correlationId;
        } else {
          publisherCorrelationWrap.classList.add('hidden');
        }
      }
      publisherGate.classList.remove('hidden');
    }

    function setStepIndicators(active: 'compose' | 'preview' | 'done') {
      const map = {
        compose: stepCompose,
        preview: stepPreview,
        done: stepDone,
      };
      for (const [key, el] of Object.entries(map)) {
        if (key === active) el.classList.add('text-gel');
        else el.classList.remove('text-gel');
      }
    }

    function hideAllTaskPanels() {
      composeStep.classList.add('hidden');
      composeGallery.classList.add('hidden');
      composeRates.classList.add('hidden');
      composeFacts.classList.add('hidden');
      composeReel.classList.add('hidden');
      composeBio.classList.add('hidden');
      composeQuote.classList.add('hidden');
      previewStep.classList.add('hidden');
      doneStep.classList.add('hidden');
    }

    function showHub() {
      stopPolling();
      hubStep.classList.remove('hidden');
      taskChrome.classList.add('hidden');
      hideAllTaskPanels();
      setStatus('');
    }

    function showTask(task: HubTask, hint?: string) {
      stopPolling();
      activeTask = task;
      hubStep.classList.add('hidden');
      taskChrome.classList.remove('hidden');
      taskTitle.textContent = TASK_TITLES[task];
      hideAllTaskPanels();
      if (task === 'ask') {
        composeStep.classList.remove('hidden');
        if (hint === 'credits') {
          messageEl.placeholder =
            'e.g. "Add my Anastasia credit" or "Write a news post about BroadwayWorld"';
          if (!messageEl.value.trim()) {
            setStatus('Describe a credit or news update — type or hold to speak.');
          }
        } else {
          messageEl.placeholder =
            'e.g. "I just booked Lily in Anastasia at the Strand, July 2025"';
        }
      } else if (task === 'gallery') {
        composeGallery.classList.remove('hidden');
      } else if (task === 'rates') {
        composeRates.classList.remove('hidden');
      } else if (task === 'facts') {
        composeFacts.classList.remove('hidden');
      } else if (task === 'reel') {
        composeReel.classList.remove('hidden');
      } else if (task === 'bio') {
        composeBio.classList.remove('hidden');
      } else if (task === 'quote') {
        composeQuote.classList.remove('hidden');
      }
      setStepIndicators('compose');
    }

    function showCompose() {
      unlockStudioUi();
      showTask(activeTask);
    }

    function showPreview() {
      unlockStudioUi();
      hubStep.classList.add('hidden');
      taskChrome.classList.remove('hidden');
      hideAllTaskPanels();
      previewStep.classList.remove('hidden');
