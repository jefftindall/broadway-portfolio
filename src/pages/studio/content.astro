---
import StudioLayout from '../../layouts/StudioLayout.astro';
import { getEntry } from 'astro:content';
import { site } from '../../lib/site';
import { buildPublicImageHashIndex } from '../../lib/imageContentHashes';
import { GALLERY_TAG_VALUES } from '../../lib/galleryStudio';

const book = await getEntry('pages', 'lessons-book');
const bookRates = book?.data.rates ?? [];
const rate30 =
  bookRates.find((r) => r.id === '30min')?.priceAmount ??
  bookRates.find((r) => /30/.test(r.label || ''))?.priceAmount;
const rate60 =
  bookRates.find((r) => r.id === '60min')?.priceAmount ??
  bookRates.find((r) => /60/.test(r.label || ''))?.priceAmount;
const bookFormat = book?.data.format ?? '';
const bookScheduling = book?.data.scheduling ?? '';
const performer = site.performer;
const reelUrl = site.reelUrl;
const reelTitle = site.reelTitle;
const shortBio = site.shortBio;
const pressQuote = site.pressQuote;
const siteLocation = site.location;
const siteAge = String(site.age);

const galleryTagOptions = GALLERY_TAG_VALUES;
const imageHashIndex = buildPublicImageHashIndex();
---

<StudioLayout
  title="Content"
  description="Private content studio for Elyse Tindall."
  heading="Content"
  helpHref="/studio/help/content"
>
  <section class="mx-auto max-w-xl px-4 py-5 md:py-8">
    <div
      id="auth-user"
      class="hidden"
      hidden
    >
      <span id="auth-user-name"></span>
    </div>

    <div
      id="access-check"
      class="mt-6 rounded-sm border border-line bg-panel/60 p-4 text-sm text-muted"
      role="status"
      aria-live="polite"
    >
      <p class="busy-status">
        <span class="busy-spinner" aria-hidden="true"></span>
        <span>Checking access…</span>
      </p>
    </div>

    <div id="auth-gate" class="mt-6 hidden rounded-sm border border-line bg-panel/60 p-4 text-sm text-muted">
      <p>Sign in to use Studio.</p>
      <a
        id="login-link"
        href="/.auth/login/aad"
        class="mt-4 inline-flex rounded-sm bg-gold px-4 py-2 text-sm font-semibold text-ink"
      >
        Sign in
      </a>
    </div>

    <div id="publisher-gate" class="mt-6 hidden rounded-sm border border-line bg-panel/60 p-4 text-sm text-muted">
      <p id="publisher-denied-msg">You’re signed in, but this account can’t publish site updates yet.</p>
      <p id="publisher-correlation-wrap" class="mt-3 hidden">
        Share this reference with an admin:&nbsp;<code
          id="publisher-correlation"
          class="break-all text-spotlight"></code>
      </p>
      <p class="mt-4">
        You can still read how Content works in{' '}
        <a
          href="/studio/help/content"
          class="text-gel underline-offset-2 hover:text-gold hover:underline"
        >
          Content help
        </a>
        .
      </p>
    </div>

    <div
      id="studio-app"
      class="mt-6 hidden space-y-5"
      data-site-location={siteLocation}
      data-site-age={siteAge}
      data-book-format={bookFormat}
      data-book-scheduling={bookScheduling}
      data-image-hashes={JSON.stringify(imageHashIndex)}
    >
      <div id="hub-step" class="space-y-4">
        <p class="text-sm text-muted">What do you want to update on the site?</p>
        <div class="grid gap-3">
          <button
            type="button"
            data-hub-task="ask"
            class="hub-tile rounded-sm border border-gold/50 bg-gold/10 px-4 py-4 text-left transition hover:bg-gold/15 focus:outline-none focus-visible:ring-2 focus-visible:ring-gold"
          >
            <span class="block font-display text-2xl text-spotlight">Speak or type an update</span>
            <span class="mt-1 block text-sm text-muted"
              >Credits, news, lessons copy — say it or type it.</span
            >
          </button>
          <div class="grid grid-cols-2 gap-3">
            <button
              type="button"
              data-hub-task="gallery"
              class="hub-tile rounded-sm border border-line bg-panel/40 px-3 py-4 text-left transition hover:border-gold focus:outline-none focus-visible:ring-2 focus-visible:ring-gold"
            >
              <span class="block text-sm font-semibold text-spotlight">Gallery photo</span>
              <span class="mt-1 block text-xs text-muted">Add an image</span>
            </button>
            <button
              type="button"
              data-hub-task="rates"
              class="hub-tile rounded-sm border border-line bg-panel/40 px-3 py-4 text-left transition hover:border-gold focus:outline-none focus-visible:ring-2 focus-visible:ring-gold"
            >
              <span class="block text-sm font-semibold text-spotlight">Lesson rates</span>
              <span class="mt-1 block text-xs text-muted">Dollar amounts</span>
            </button>
            <button
              type="button"
              data-hub-task="facts"
              class="hub-tile rounded-sm border border-line bg-panel/40 px-3 py-4 text-left transition hover:border-gold focus:outline-none focus-visible:ring-2 focus-visible:ring-gold"
            >
              <span class="block text-sm font-semibold text-spotlight">Performer facts</span>
              <span class="mt-1 block text-xs text-muted">Range, availability…</span>
            </button>
            <button
              type="button"
              data-hub-task="reel"
              class="hub-tile rounded-sm border border-line bg-panel/40 px-3 py-4 text-left transition hover:border-gold focus:outline-none focus-visible:ring-2 focus-visible:ring-gold"
            >
              <span class="block text-sm font-semibold text-spotlight">Reel link</span>
              <span class="mt-1 block text-xs text-muted">YouTube URL</span>
            </button>
            <button
              type="button"
              data-hub-task="bio"
              class="hub-tile rounded-sm border border-line bg-panel/40 px-3 py-4 text-left transition hover:border-gold focus:outline-none focus-visible:ring-2 focus-visible:ring-gold"
            >
              <span class="block text-sm font-semibold text-spotlight">Short bio</span>
              <span class="mt-1 block text-xs text-muted">About lead</span>
            </button>
            <button
              type="button"
              data-hub-task="quote"
              class="hub-tile rounded-sm border border-line bg-panel/40 px-3 py-4 text-left transition hover:border-gold focus:outline-none focus-visible:ring-2 focus-visible:ring-gold"
            >
              <span class="block text-sm font-semibold text-spotlight">Press quote</span>
              <span class="mt-1 block text-xs text-muted">Homepage quote</span>
            </button>
          </div>
          <div class="pt-1">
            <a
              href="/studio/help/content"
              class="inline-flex items-center gap-2 text-sm text-muted underline-offset-2 hover:text-gold hover:underline"
            >
              <svg
                class="size-4 shrink-0 text-gel"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M9.5 9.5a2.5 2.5 0 1 1 3.8 2.1c-.7.4-1.3 1-1.3 1.9"></path>
                <circle cx="12" cy="16.5" r="0.75" fill="currentColor" stroke="none"></circle>
              </svg>
              Help
            </a>
          </div>
        </div>
      </div>

      <div id="task-chrome" class="hidden space-y-3">
        <button
          id="hub-back-btn"
          type="button"
          class="text-sm text-gel underline-offset-2 hover:text-gold hover:underline"
        >
          ← All updates
        </button>
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 id="task-title" class="font-display text-2xl text-spotlight">Update</h2>
          <ol
            class="flex flex-wrap gap-x-3 gap-y-1 text-xs uppercase tracking-[0.15em] text-muted"
            aria-hidden="true"
          >
            <li id="step-indicator-compose" class="text-gel">1. Edit</li>
            <li id="step-indicator-preview">2. Preview</li>
            <li id="step-indicator-done">3. Done</li>
          </ol>
        </div>
      </div>

      <div id="compose-step" class="hidden space-y-4">
        <label class="block text-sm text-muted">
          Message
          <textarea
            id="message"
            rows="5"
            class="mt-2 w-full rounded-sm border border-line bg-ink px-3 py-3 text-spotlight outline-none focus:border-gold"
            placeholder='e.g. "I just booked Lily in Anastasia at the Strand, July 2025"'
          ></textarea>
        </label>

        <div class="flex flex-wrap gap-3">
          <button
            id="mic"
            type="button"
            class="rounded-sm border border-line px-4 py-3 text-sm text-spotlight hover:border-gold"
          >
            Hold to speak
          </button>
        </div>

        <label class="block text-sm text-muted">
          Photo (optional)
          <input
            id="photo"
            type="file"
            accept="image/jpeg,image/png,image/webp"
            class="mt-2 block w-full text-sm text-muted file:mr-3 file:rounded-sm file:border-0 file:bg-stage file:px-3 file:py-2 file:text-spotlight"
          />
        </label>
        <div id="photo-preview-wrap" class="hidden">
          <img
            id="photo-preview"
            alt="Selected photo preview"
            class="max-h-40 rounded-sm border border-line object-cover"
          />
        </div>
        <p
          id="photo-dup-warn"
          class="hidden rounded-sm border border-gold/40 bg-gold/10 px-3 py-2 text-sm text-spotlight"
          role="status"
        ></p>

        <button
          id="preview-btn"
          type="button"
          data-label="Preview update"
          class="w-full rounded-sm bg-gold px-5 py-3 text-sm font-semibold text-ink hover:brightness-110 disabled:cursor-wait disabled:opacity-60 disabled:hover:brightness-100 sm:w-auto"
        >
          Preview update
        </button>
      </div>

      <div id="compose-gallery" class="hidden space-y-4">
        <p class="text-sm text-muted">
          Choose a photo and tags from the list below. New photos appear first in the gallery.
          Captions stay empty — the public gallery does not show them.
        </p>
        <label class="block text-sm text-muted">
          Photo
          <input
            id="gallery-photo"
            type="file"
            accept="image/jpeg,image/png,image/webp"
            class="mt-2 block w-full text-sm text-muted file:mr-3 file:rounded-sm file:border-0 file:bg-stage file:px-3 file:py-2 file:text-spotlight"
          />
        </label>
        <div id="gallery-photo-preview-wrap" class="hidden">
          <img
            id="gallery-photo-preview"
            alt="Selected gallery photo preview"
            class="max-h-48 w-full rounded-sm border border-line object-cover"
            style="object-position: center"
          />
        </div>
        <p
          id="gallery-dup-warn"
          class="hidden rounded-sm border border-gold/40 bg-gold/10 px-3 py-2 text-sm text-spotlight"
          role="status"
        ></p>
        <fieldset>
          <legend class="text-sm text-muted">Tags</legend>
          <p class="mt-1 text-xs text-muted">
            Pick from existing gallery filters only — new custom tags can’t be added here.
          </p>
          <div id="gallery-tag-chips" class="mt-2 flex flex-wrap gap-2">
            {
              galleryTagOptions.map((tag) => (
                <label class="inline-flex cursor-pointer items-center gap-2 rounded-sm border border-line px-3 py-2 text-sm text-spotlight has-[:checked]:border-gold has-[:checked]:bg-gold/15">
                  <input
                    type="checkbox"
                    name="gallery-tag"
                    value={tag}
                    class="accent-gold"
                  />
                  <span class="capitalize">{tag}</span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <label class="block text-sm text-muted">
          Crop focus
          <select
            id="gallery-focus"
            class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-spotlight outline-none focus:border-gold"
          >
            <option value="center">Center</option>
            <option value="center top">Center top (faces higher)</option>
            <option value="50% 35%">Mid-upper (50% 35%)</option>
            <option value="50% 55%">Lower (50% 55%)</option>
            <option value="center bottom">Center bottom</option>
            <option value="custom">Custom…</option>
          </select>
        </label>
        <label id="gallery-focus-custom-wrap" class="hidden block text-sm text-muted">
          Custom object-position
          <input
            id="gallery-focus-custom"
            type="text"
            placeholder='e.g. 50% 28%'
            class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-spotlight outline-none focus:border-gold"
          />
        </label>
        <div>
          <label class="block text-sm text-muted" for="gallery-slug">
            Gallery file name (optional)
          </label>
          <p id="gallery-slug-help" class="mt-1 text-xs text-muted">
            Sets the markdown file name in the repo
            (<code class="text-spotlight">src/content/gallery/&lt;name&gt;.md</code>). A stable name
            makes this photo easy to find in git history and Studio commits. Leave blank to auto-name
            from the photo. You can omit <code class="text-spotlight">.md</code> — Studio adds it.
          </p>
          <input
            id="gallery-slug"
            type="text"
            inputmode="text"
            autocomplete="off"
            spellcheck="false"
            maxlength="83"
            placeholder="e.g. nyc-winter-headshot"
            aria-describedby="gallery-slug-help gallery-slug-hint gallery-slug-error"
            class="mt-2 w-full rounded-sm border border-line bg-ink px-3 py-2 text-spotlight outline-none focus:border-gold"
          />
          <p id="gallery-slug-hint" class="mt-1 text-xs text-muted" aria-live="polite"></p>
          <p
            id="gallery-slug-error"
            class="mt-1 hidden text-sm text-red-300"
            role="alert"
            aria-live="assertive"
          ></p>
        </div>
        <div class="flex flex-wrap gap-3">
          <button
            id="gallery-preview-btn"
            type="button"
            data-label="Preview gallery photo"
            class="w-full rounded-sm bg-gold px-5 py-3 text-sm font-semibold text-ink hover:brightness-110 disabled:cursor-wait disabled:opacity-60 sm:w-auto"
          >
            Preview gallery photo
          </button>
          <button
            id="gallery-reset-btn"
            type="button"
            class="rounded-sm border border-line px-4 py-3 text-sm text-spotlight hover:border-gold disabled:cursor-wait disabled:opacity-60"
          >
            Clear form
          </button>
        </div>
      </div>

      <div id="compose-rates" class="hidden space-y-4">
        <p class="text-sm text-muted">Change the dollar amounts, then preview.</p>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="block text-sm text-muted">
            30-minute session ($)
            <input
              id="quick-rate-30"
              type="number"
              min="1"
              step="1"
              value={rate30 != null ? String(rate30) : ''}
              class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-spotlight outline-none focus:border-gold"
            />
          </label>
          <label class="block text-sm text-muted">
            60-minute session ($)
            <input
              id="quick-rate-60"
              type="number"
              min="1"
              step="1"
              value={rate60 != null ? String(rate60) : ''}
              class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-spotlight outline-none focus:border-gold"
            />
          </label>
        </div>
        <div class="flex flex-wrap gap-3">
          <button
            id="quick-rates-btn"
            type="button"
            data-label="Preview rate update"
            class="w-full rounded-sm bg-gold px-5 py-3 text-sm font-semibold text-ink hover:brightness-110 disabled:cursor-wait disabled:opacity-60 sm:w-auto"
          >
            Preview rate update
          </button>
          <button
            id="rates-reset-btn"
            type="button"
            class="rounded-sm border border-line px-4 py-3 text-sm text-spotlight hover:border-gold disabled:cursor-wait disabled:opacity-60"
          >
            Reset to live
          </button>
        </div>
      </div>

      <div id="compose-facts" class="hidden space-y-4">
        <p class="text-sm text-muted">Edit casting facts shown on About and Materials.</p>
        <label class="block text-sm text-muted">
          Availability
          <input
            id="fact-availability"
            type="text"
            value={performer.availability}
            class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-spotlight outline-none focus:border-gold"
          />
        </label>
        <label class="block text-sm text-muted">
          Vocal type
          <input
            id="fact-vocalType"
            type="text"
            value={performer.vocalType}
            class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-spotlight outline-none focus:border-gold"
          />
        </label>
        <label class="block text-sm text-muted">
          Vocal range
          <input
            id="fact-vocalRange"
            type="text"
            value={performer.vocalRange}
            class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-spotlight outline-none focus:border-gold"
          />
        </label>
        <label class="block text-sm text-muted">
          Union
          <input
            id="fact-union"
            type="text"
            value={performer.union}
            class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-spotlight outline-none focus:border-gold"
          />
        </label>
        <label class="block text-sm text-muted">
          Playing age
          <input
            id="fact-playingAge"
            type="text"
            value={performer.playingAge ?? ''}
            class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-spotlight outline-none focus:border-gold"
          />
        </label>
        <label class="block text-sm text-muted">
          Height
          <input
            id="fact-height"
            type="text"
            value={performer.height ?? ''}
            class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-spotlight outline-none focus:border-gold"
          />
        </label>
        <label class="block text-sm text-muted">
          Ethnicity
          <textarea
            id="fact-ethnicity"
            rows="3"
            class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-spotlight outline-none focus:border-gold"
          >{performer.ethnicity ?? ''}</textarea>
        </label>
        <div class="flex flex-wrap gap-3">
          <button
            id="facts-preview-btn"
            type="button"
            data-label="Preview facts update"
            class="w-full rounded-sm bg-gold px-5 py-3 text-sm font-semibold text-ink hover:brightness-110 disabled:cursor-wait disabled:opacity-60 sm:w-auto"
          >
            Preview facts update
          </button>
          <button
            id="facts-reset-btn"
            type="button"
            class="rounded-sm border border-line px-4 py-3 text-sm text-spotlight hover:border-gold disabled:cursor-wait disabled:opacity-60"
          >
            Reset to live
          </button>
        </div>
      </div>

      <div id="compose-reel" class="hidden space-y-4">
        <p class="text-sm text-muted">
          Paste the YouTube (or video) link. Title is the name on the play button (not show or Materials copy).
        </p>
        <label class="block text-sm text-muted">
          Reel title
          <input
            id="reel-title"
            type="text"
            maxlength="120"
            value={reelTitle}
            placeholder="NYC Cabaret — Stage Kiss reel"
            class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-spotlight outline-none focus:border-gold"
          />
        </label>
        <label class="block text-sm text-muted">
          Reel link
          <input
            id="reel-url"
            type="url"
            inputmode="url"
            autocomplete="url"
            value={reelUrl}
            placeholder="https://youtu.be/…"
            class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-spotlight outline-none focus:border-gold"
          />
        </label>
        <div class="flex flex-wrap gap-3">
          <button
            id="reel-preview-btn"
            type="button"
            data-label="Preview reel update"
            class="w-full rounded-sm bg-gold px-5 py-3 text-sm font-semibold text-ink hover:brightness-110 disabled:cursor-wait disabled:opacity-60 sm:w-auto"
          >
            Preview reel update
          </button>
          <button
            id="reel-reset-btn"
            type="button"
            class="rounded-sm border border-line px-4 py-3 text-sm text-spotlight hover:border-gold disabled:cursor-wait disabled:opacity-60"
          >
            Reset to live
          </button>
        </div>
      </div>

      <div id="compose-bio" class="hidden space-y-4">
        <p class="text-sm text-muted">
          Short lead on the About page (one or two sentences). Longer Background/Philosophy stay
          as-is.
        </p>
        <label class="block text-sm text-muted">
          Short bio
          <textarea
            id="short-bio"
            rows="4"
            maxlength="600"
            class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-spotlight outline-none focus:border-gold"
          >{shortBio}</textarea>
        </label>
        <div class="flex flex-wrap gap-3">
          <button
            id="bio-preview-btn"
            type="button"
            data-label="Preview bio update"
            class="w-full rounded-sm bg-gold px-5 py-3 text-sm font-semibold text-ink hover:brightness-110 disabled:cursor-wait disabled:opacity-60 sm:w-auto"
          >
            Preview bio update
          </button>
          <button
            id="bio-reset-btn"
            type="button"
            class="rounded-sm border border-line px-4 py-3 text-sm text-spotlight hover:border-gold disabled:cursor-wait disabled:opacity-60"
          >
            Reset to live
          </button>
        </div>
      </div>

      <div id="compose-quote" class="hidden space-y-4">
        <p class="text-sm text-muted">
          Homepage press quote under the hero. Keep it short — quotation marks are added by the
          layout.
        </p>
        <label class="block text-sm text-muted">
          Quote
          <textarea
            id="press-quote-text"
            rows="3"
            maxlength="280"
            class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-spotlight outline-none focus:border-gold"
          >{pressQuote.quote}</textarea>
        </label>
        <label class="block text-sm text-muted">
          Attribution
          <input
            id="press-quote-attribution"
            type="text"
            maxlength="120"
            value={pressQuote.attribution}
            class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-spotlight outline-none focus:border-gold"
          />
        </label>
        <div class="flex flex-wrap gap-3">
          <button
            id="quote-preview-btn"
            type="button"
            data-label="Preview quote update"
            class="w-full rounded-sm bg-gold px-5 py-3 text-sm font-semibold text-ink hover:brightness-110 disabled:cursor-wait disabled:opacity-60 sm:w-auto"
          >
            Preview quote update
          </button>
          <button
            id="quote-reset-btn"
            type="button"
            class="rounded-sm border border-line px-4 py-3 text-sm text-spotlight hover:border-gold disabled:cursor-wait disabled:opacity-60"
          >
            Reset to live
          </button>
        </div>
      </div>

      <div id="preview-step" class="hidden space-y-4">
        <p id="preview-reply" class="text-sm text-gel"></p>
        <div id="changes-editor" class="space-y-4"></div>
        <div class="flex flex-wrap gap-3">
          <button
            id="back-btn"
            type="button"
            class="rounded-sm border border-line px-4 py-3 text-sm text-spotlight hover:border-gold disabled:cursor-wait disabled:opacity-60"
          >
            Back
          </button>
          <button
            id="publish-btn"
            type="button"
            data-label="Publish to site"
            class="rounded-sm bg-gold px-5 py-3 text-sm font-semibold text-ink hover:brightness-110 disabled:cursor-wait disabled:opacity-60 disabled:hover:brightness-100"
          >
            Publish to site
          </button>
        </div>
      </div>

