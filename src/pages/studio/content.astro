    previewBtn.addEventListener('click', async () => {
      const message = messageEl.value.trim();
      if (!message) {
        setStatus('Write a message first.');
        return;
      }
      if (photoEl.files?.[0]) {
        if (photoTooLarge(photoEl.files[0])) {
          setStatus('That photo is larger than 12 MB. Choose a smaller file.');
          return;
        }
        if (!askPhotoDuplicatePath) {
          askPhotoDuplicatePath = await checkPhotoDuplicate(photoEl.files[0]);
          if (askPhotoDuplicatePath) {
            showDuplicateWarning(photoDupWarn, askPhotoDuplicatePath);
          }
        }
        if (!confirmIfDuplicate(askPhotoDuplicatePath)) {
          setStatus('Choose a different photo, or confirm when ready to publish a duplicate.');
          return;
        }
      }

      setComposeBusy(true);
      setStatus('Preparing preview…', true);

      draftPhoto = undefined;
      if (photoEl.files?.[0]) {
        const photo = await photoPayloadFromFile(photoEl.files[0]);
        if (photo) draftPhoto = photo;
      }

      try {
        const res = await fetch('/api/updateContent', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mode: 'draft', message, photo: draftPhoto }),
        });
        const data = await res.json();
        if (!res.ok) {
          const reason = res.status === 401 ? 'unauthorized' : 'http_error';
          const correlationId =
            typeof data.correlationId === 'string' ? data.correlationId : undefined;
          if (res.status === 401) {
            setStatus(formatApiError(data, 'This account can’t publish updates.'));
            showPublisherDenied(correlationId);
          } else {
            setStatus(formatApiError(data, 'Something went wrong while drafting.'));
          }
          trackEvent('StudioPublishUiFailed', {
            status: String(res.status),
            reason,
            operation: 'draft',
            ...(correlationId ? { correlationId } : {}),
          });
          flush();
          return;
        }

        const changes = Array.isArray(data.changes) ? (data.changes as ContentChange[]) : [];
        if (!changes.length) {
          setStatus(
            typeof data.reply === 'string' && data.reply.trim()
              ? data.reply.trim()
              : 'No website update was drafted. Try being more specific.',
          );
          return;
        }

        draftChanges = changes.map((c) => ({
          tool: c.tool,
          path: String(c.path || ''),
          content: String(c.content ?? ''),
          commitMessage: String(c.commitMessage || ''),
          summary: c.summary ? String(c.summary) : undefined,
          livePath: c.livePath ? String(c.livePath) : undefined,
          preview: c.preview,
          commitParams:
            c.commitParams && typeof c.commitParams === 'object' ? c.commitParams : undefined,
        }));
        provisionalPhotoPath =
          typeof data.provisionalPhotoPath === 'string' ? data.provisionalPhotoPath : null;
        const allDiscrete =
          draftChanges.length > 0 &&
          draftChanges.every((c) => c.tool && DISCRETE_TOOLS.has(c.tool));
        previewReply.textContent = allDiscrete
          ? 'Confirm the values below, then publish to the site.'
          : typeof data.reply === 'string' && data.reply.trim()
            ? data.reply.trim()
            : 'Review the draft below, edit if needed, then publish.';
        renderChangesEditor(draftChanges);
        showPreview();
        setStatus(
          allDiscrete
            ? 'Confirm, then publish — or go Back to edit.'
            : 'Review the draft, edit if needed, then publish.',
        );
      } catch (err) {
        setStatus('Network error — try again.');
        trackException(err, { operation: 'studioDraft' });
        flush();
      } finally {
        if (!studioApp.classList.contains('hidden')) {
          unlockStudioUi();
        }
      }
    });

    backBtn.addEventListener('click', () => {
      showCompose();
      setStatus('Edit, then preview again — or go back to all updates.');
    });

    publishBtn.addEventListener('click', async () => {
      setPreviewBusy(true);
      setStatus('Preparing…', true);
      let changes: ContentChange[];
      try {
        changes = await readEditedChanges();
      } catch (err) {
        unlockStudioUi();
        setStatus(err instanceof Error ? err.message : 'Could not prepare that update.');
        return;
      }
      if (!changes.length) {
        unlockStudioUi();
        setStatus('Nothing to publish.');
        return;
      }

      publishClickedAt = Date.now();
      prodLatencyEmitted = false;
      setStatus('Publishing…', true);

      try {
        const res = await fetch('/api/updateContent', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            mode: 'publish',
            changes,
            photo: draftPhoto,
            provisionalPhotoPath,
          }),
        });
        const data = await res.json();
        if (!res.ok) {
          const reason = res.status === 401 ? 'unauthorized' : 'http_error';
          const correlationId =
            typeof data.correlationId === 'string' ? data.correlationId : undefined;
          if (res.status === 401) {
            setStatus(formatApiError(data, 'This account can’t publish updates.'));
            showPublisherDenied(correlationId);
          } else {
            setStatus(formatApiError(data, 'Something went wrong while publishing.'));
          }
          trackEvent('StudioPublishUiFailed', {
            status: String(res.status),
            reason,
            operation: 'publish',
            ...(correlationId ? { correlationId } : {}),
          });
          flush();
          return;
        }

        const actions = Array.isArray(data.actions) ? (data.actions as PublishAction[]) : [];
        const commitSha = typeof data.commitSha === 'string' ? data.commitSha : undefined;
        const publishMode = data.publishMode === 'pr' ? 'pr' : 'direct';
        const branch = typeof data.branch === 'string' ? data.branch : undefined;
        const prUrl = typeof data.prUrl === 'string' ? data.prUrl : undefined;
        doneReply.textContent =
          typeof data.reply === 'string' && data.reply.trim()
            ? data.reply.trim()
            : publishMode === 'pr'
              ? 'Your update was saved on a staging branch.'
              : 'Your update was committed. The site will rebuild shortly.';
        doneSha.textContent = commitSha ? `Commit ${commitSha.slice(0, 7)}` : '';
        if (publishMode === 'pr' && branch) {
          doneBranch.textContent = `Branch ${branch}`;
          doneBranch.classList.remove('hidden');
        } else {
          doneBranch.textContent = '';
          doneBranch.classList.add('hidden');
        }
        donePr.replaceChildren();
        if (publishMode === 'pr' && prUrl) {
          const a = document.createElement('a');
          a.href = prUrl;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.className = 'text-gel underline-offset-2 hover:text-gold hover:underline';
          a.textContent =
            typeof data.prNumber === 'number' ? `Open pull request #${data.prNumber}` : 'Open pull request';
          donePr.appendChild(a);
          donePr.classList.remove('hidden');
        } else {
          donePr.classList.add('hidden');
        }
        showDone();
        syncLiveDefaultsFromPublishedChanges(changes);
        startProgressTracking(commitSha, actions, { publishMode, branch, prUrl });
        trackEvent('StudioPublishUiSuccess', {
          publishMode,
          ...(commitSha ? { commitSha } : {}),
          ...(branch ? { branch } : {}),
        });
        flush();
      } catch (err) {
        setStatus('Network error — try again.');
        trackException(err, { operation: 'studioPublish' });
        flush();
      } finally {
        if (!studioApp.classList.contains('hidden')) {
          unlockStudioUi();
        }
      }
    });

    anotherBtn.addEventListener('click', () => {
      resetToHub();
    });

    type StudioSpeechRecognition = {
      continuous: boolean;
      interimResults: boolean;
      lang: string;
      start: () => void;
      stop: () => void;
      onresult: ((event: { results: ArrayLike<ArrayLike<{ transcript: string }>> }) => void) | null;
      onerror: (() => void) | null;
    };

    type SpeechRecognitionCtor = new () => StudioSpeechRecognition;

    const SpeechRecognitionCtor =
      (window as unknown as { SpeechRecognition?: SpeechRecognitionCtor }).SpeechRecognition ||
      (window as unknown as { webkitSpeechRecognition?: SpeechRecognitionCtor }).webkitSpeechRecognition;

    if (SpeechRecognitionCtor) {
      const recognition = new SpeechRecognitionCtor();
      recognition.continuous = false;
      recognition.interimResults = true;
      recognition.lang = 'en-US';

      micBtn.addEventListener('pointerdown', () => {
        if (micBtn.disabled) return;
        try {
          recognition.start();
          micBtn.textContent = 'Listening…';
          setStatus('Speak now');
        } catch {
          /* already started */
        }
      });
      micBtn.addEventListener('pointerup', () => {
        recognition.stop();
        micBtn.textContent = 'Hold to speak';
      });
      recognition.onresult = (event) => {
        let transcript = '';
        for (let i = 0; i < event.results.length; i++) {
          transcript += event.results[i]![0]!.transcript;
        }
        messageEl.value = transcript;
      };
      recognition.onerror = () => {
        micBtn.textContent = 'Hold to speak';
        setStatus('Mic unavailable — type instead.');
      };
    } else {
      micSupported = false;
      micBtn.disabled = true;
      micBtn.textContent = 'Voice not supported';
    }

    checkAuth();
  </script>
</StudioLayout>
