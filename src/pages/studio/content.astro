      syncGalleryFocusPreview();
    });
    galleryFocusCustom.addEventListener('input', () => {
      syncGalleryFocusPreview();
    });
    gallerySlugInput.addEventListener('input', () => {
      syncGallerySlugFeedback();
    });
    gallerySlugInput.addEventListener('blur', () => {
      const result = validateGallerySlug(gallerySlugInput.value);
      if (result.ok && !result.empty && gallerySlugInput.value.trim() !== result.filename) {
        // Normalize casing and ensure .md is visible when the user typed a basename only.
        gallerySlugInput.value = result.filename;
      }
      syncGallerySlugFeedback();
    });
    syncGallerySlugFeedback();

    async function runDiscretePreview(
      tool: string,
      args: Record<string, unknown>,
      emptyMessage: string,
      photo?: PhotoPayload,
    ) {
      setComposeBusy(true);
      setStatus('Preparing preview…', true);
      try {
        const { changes, provisionalPhotoPath: provisional } = await composeDiscrete(
          tool,
          args,
          photo,
        );
        draftChanges = changes;
        draftPhoto = photo;
        provisionalPhotoPath = provisional;
        previewReply.textContent = 'Confirm the values below, then publish to the site.';
        renderChangesEditor(draftChanges);
        showPreview();
        setStatus('Confirm, then publish — or go Back to edit.');
      } catch (err) {
        setStatus(err instanceof Error ? err.message : emptyMessage);
        trackException(err, { operation: 'studioDiscretePreview', tool });
        flush();
      } finally {
        if (!studioApp.classList.contains('hidden')) {
          // Always clear compose lock — success already showed Preview; failure stays on Edit.
          unlockStudioUi();
        }
      }
    }

    studioApp.querySelectorAll('[data-hub-task]').forEach((el) => {
      el.addEventListener('click', () => {
        const task = (el as HTMLElement).dataset.hubTask as HubTask | undefined;
        const hint = (el as HTMLElement).dataset.hubHint;
        if (!task || !TASK_TITLES[task]) return;
        showTask(task, hint);
      });
    });

    hubBackBtn.addEventListener('click', () => {
