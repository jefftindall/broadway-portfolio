    function formatApiError(data: { error?: string; correlationId?: string }, fallback: string) {
      const friendly =
        typeof data.error === 'string' && data.error.trim() ? data.error.trim() : fallback;
      const correlationId =
        typeof data.correlationId === 'string' ? data.correlationId : undefined;
      return correlationId ? `${friendly} Reference: ${correlationId}` : friendly;
    }

    function stopPolling() {
      if (pollTimer != null) {
        window.clearTimeout(pollTimer);
        pollTimer = null;
      }
    }

    function pipelineLabel(status: string) {
      switch (status) {
        case 'success':
          return 'Complete';
        case 'failure':
          return 'Failed';
        case 'skipped':
          return 'Skipped';
        case 'in_progress':
          return 'In progress';
        case 'queued':
          return 'Queued';
        default:
          return 'Waiting…';
      }
    }

    function renderPipeline(data: {
      status?: string;
      runUrl?: string | null;
      jobs?: Array<{ name: string; status: string }>;
    }) {
      pipelineList.replaceChildren();

      const overall = document.createElement('li');
      overall.className = 'flex flex-wrap items-baseline justify-between gap-2';
      const overallLabel = document.createElement('span');
      overallLabel.textContent = 'Site rebuild';
      const overallStatus = document.createElement('span');
      overallStatus.className = 'text-spotlight';
      overallStatus.textContent = pipelineLabel(String(data.status || 'unknown'));
      overall.append(overallLabel, overallStatus);
      pipelineList.appendChild(overall);

      const jobs = Array.isArray(data.jobs) ? data.jobs : [];
      const interesting = jobs.filter((j) =>
        /staging|production|deploy/i.test(j.name || ''),
      );
      for (const job of interesting.length ? interesting : jobs.slice(0, 4)) {
        const li = document.createElement('li');
        li.className = 'flex flex-wrap items-baseline justify-between gap-2 pl-2 text-xs';
        const name = document.createElement('span');
        name.textContent = job.name;
        const st = document.createElement('span');
        st.className = 'text-spotlight';
        st.textContent = pipelineLabel(job.status);
        li.append(name, st);
        pipelineList.appendChild(li);
      }

      if (data.runUrl) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = data.runUrl;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        a.className = 'text-gel underline-offset-2 hover:text-gold hover:underline';
        a.textContent = 'View build details';
        li.appendChild(a);
        pipelineList.appendChild(li);
      }
    }

    function renderPageLinks(actions: PublishAction[]) {
      pageLinks.replaceChildren();
      const seen = new Set<string>();
      for (const action of actions) {
        const url = typeof action.url === 'string' ? action.url : '';
        if (!url || url.startsWith('/images/') || seen.has(url)) continue;
        seen.add(url);

        const li = document.createElement('li');
        li.className = 'flex flex-wrap items-center justify-between gap-2';
        li.dataset.url = url;

        const label = document.createElement('span');
        label.className = 'text-muted';
        label.textContent = action.summary || url;

        const link = document.createElement('a');
        link.href = url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.className =
          'pointer-events-none text-xs text-muted opacity-50';
        link.innerHTML = `<span class="busy-status">${busyStatusChildrenMarkup('Checking…')}</span>`;
        link.dataset.live = 'false';

        li.append(label, link);
        pageLinks.appendChild(li);
      }

      if (!pageLinks.children.length) {
        const li = document.createElement('li');
        li.className = 'text-muted';
        li.textContent = 'No public page links for this update.';
        pageLinks.appendChild(li);
      }
    }

    async function checkPageLive(url: string): Promise<boolean> {
      try {
        const res = await fetch(`${url}?t=${Date.now()}`, {
          method: 'GET',
          cache: 'no-store',
          credentials: 'same-origin',
        });
        return res.ok;
      } catch {
        return false;
      }
    }

    async function refreshLiveLinks() {
      const items = Array.from(pageLinks.querySelectorAll('li[data-url]')) as HTMLElement[];
      await Promise.all(
        items.map(async (li) => {
          const url = li.dataset.url;
          const link = li.querySelector('a') as HTMLAnchorElement | null;
          if (!url || !link || link.dataset.live === 'true') return;
          const live = await checkPageLive(url);
          if (live) {
            link.dataset.live = 'true';
            link.textContent = 'View page';
            link.className = 'text-gel underline-offset-2 hover:text-gold hover:underline';
            link.classList.remove('pointer-events-none', 'opacity-50');
          } else {
            link.textContent = 'Waiting for rebuild…';
          }
        }),
      );
    }

    function maybeEmitProdLatency(
      data: { jobs?: Array<{ name: string; status: string }> },
      sha: string,
    ) {
      if (prodLatencyEmitted || !publishClickedAt) return;
      const jobs = Array.isArray(data.jobs) ? data.jobs : [];
      const prodDeploy = jobs.find(
        (j) => /deploy\s+production/i.test(j.name || '') && j.status === 'success',
      );
      if (!prodDeploy) return;

      prodLatencyEmitted = true;
      const durationMs = Math.max(0, Date.now() - publishClickedAt);
      trackEvent('StudioPublishToProdCompleted', {
        durationMs: String(durationMs),
        commitSha: sha,
      });
      trackMetric('StudioPublishToProdDurationMs', durationMs, {
        commitSha: sha,
      });
      flush();
    }

    async function pollOnce(sha: string) {
      try {
        const res = await fetch(`/api/publishStatus?sha=${encodeURIComponent(sha)}`);
        const data = await res.json();
        if (res.ok) {
          renderPipeline(data);
          maybeEmitProdLatency(data, sha);
          if (data.status === 'failure') {
            setStatus(
              'The site rebuild reported a failure. Share this with support if it keeps happening.',
            );
            stopPolling();
            return;
          }
          if (data.status === 'success') {
            setStatus('Rebuild finished. Use View page when the link is ready.');
          }
        }
      } catch {
        /* keep polling */
      }

      await refreshLiveLinks();

      const elapsed = Date.now() - pollStartedAt;
      if (elapsed >= POLL_TIMEOUT_MS) {
        setStatus('Still rebuilding — check back in a few minutes, or use View page if it appears.', true);
        stopPolling();
        return;
      }

      pollTimer = window.setTimeout(() => {
        void pollOnce(sha);
      }, POLL_MS);
    }

    function startProgressTracking(
      sha: string | undefined,
      actions: PublishAction[],
      meta?: { publishMode?: string; branch?: string; prUrl?: string },
    ) {
      const mode = meta?.publishMode === 'pr' ? 'pr' : 'direct';
      prodLatencyEmitted = false;
      renderPageLinks(actions);

      if (mode === 'pr') {
        pipelineSection.classList.add('hidden');
        stagingTestSection.classList.remove('hidden');
        pipelineList.replaceChildren();
        // Page links on this host may still be yesterday's build — don't poll for "live".
        for (const link of Array.from(pageLinks.querySelectorAll('a'))) {
          const a = link as HTMLAnchorElement;
          a.textContent = 'After staging deploy / merge';
          a.className = 'pointer-events-none text-xs text-muted opacity-50';
        }
        setStatus(
          meta?.prUrl
            ? 'Saved on a staging branch. Open the pull request, or run CD: staging to test.'
            : 'Saved on a staging branch. Run Actions → CD: staging to test.',
        );
        return;
      }

      pipelineSection.classList.remove('hidden');
      stagingTestSection.classList.add('hidden');
      renderPipeline({ status: 'queued', jobs: [] });
      void refreshLiveLinks();

      if (!sha) {
        setStatus('Accepted. Waiting for the site rebuild…', true);
        return;
      }

      pollStartedAt = Date.now();
      setStatus('Accepted. Watching the rebuild…', true);
      void pollOnce(sha);
    }

    async function checkAuth() {
      let clientPrincipal: ClientPrincipal | null | undefined;
      try {
        const res = await fetch('/.auth/me');
        const data = await res.json();
        clientPrincipal = data?.clientPrincipal as ClientPrincipal | null | undefined;
      } catch {
        authUser.classList.add('hidden');
        applySessionCapabilities({
          signedIn: true,
          authorized: true,
          roles: ['super_administrator'],
          permissions: Object.values(STUDIO_PERMISSION),
        });
        showStudioApp();
        return true;
      }

      if (!clientPrincipal) {
        showSignInGate();
        return false;
      }

      authUserName.textContent = displayNameFromPrincipal(clientPrincipal);
      authUser.classList.remove('hidden');

      const session = await fetchStudioSession();
      if (session.apiUnavailable) {
        showPublisherDenied(undefined, { apiUnavailable: true });
        return false;
      }

      const hasCapability = applySessionCapabilities(session);
      if (!hasCapability) {
        showPublisherDenied(session.correlationId);
        return false;
      }

      applyPublishModeUi(session.publishMode === 'pr' ? 'pr' : 'direct');
      showStudioApp();
      return true;
    }

    /** Transport cap only — do not bake display sizes here. Derived variants are build-time. */
    const STUDIO_PHOTO_MAX_BYTES = 12 * 1024 * 1024;

    function photoTooLarge(file: File): boolean {
      return file.size > STUDIO_PHOTO_MAX_BYTES;
    }

    async function photoPayloadFromFile(file: File): Promise<PhotoPayload | null> {
      const type =
        file.type === 'image/png' || file.type === 'image/webp' || file.type === 'image/jpeg'
          ? file.type
          : '';
      if (!type) return null;
      const buffer = await file.arrayBuffer();
      let binary = '';
      const bytes = new Uint8Array(buffer);
      for (let i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]!);
      const dataBase64 = btoa(binary);
      const ext = type === 'image/png' ? '.png' : type === 'image/webp' ? '.webp' : '.jpg';
      const safe = file.name.replace(/[^a-zA-Z0-9._-]/g, '-').replace(/\.\w+$/, ext);
      return { name: safe, contentType: type, dataBase64 };
    }

    function fieldClass(readOnly = false) {
      return readOnly
        ? 'mt-1 w-full cursor-default rounded-sm border border-line/70 bg-ink/50 px-3 py-2 text-sm text-spotlight outline-none'
        : 'mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold';
    }

    function appendLabeledInput(
      wrap: HTMLElement,
      labelText: string,
      field: string,
      value: string,
      opts?: { type?: string; rows?: number; readOnly?: boolean },
    ) {
      const readOnly = Boolean(opts?.readOnly);
      const label = document.createElement('label');
      label.className = 'block text-sm text-muted';
      label.textContent = labelText;
      if (opts?.rows) {
        const area = document.createElement('textarea');
        area.rows = opts.rows;
        area.value = value;
        area.dataset.field = field;
        area.readOnly = readOnly;
        area.className = fieldClass(readOnly);
        label.appendChild(area);
      } else {
        const input = document.createElement('input');
        // Read-only confirmation: avoid number steppers that look editable.
        input.type = readOnly ? 'text' : opts?.type || 'text';
        if (!readOnly && opts?.type === 'number') {
          input.min = '1';
          input.step = '1';
        }
        input.value = value;
        input.dataset.field = field;
        input.readOnly = readOnly;
        input.className = fieldClass(readOnly);
        label.appendChild(input);
      }
      wrap.appendChild(label);
    }

