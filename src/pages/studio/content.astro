    function renderDiscretePreview(wrap: HTMLElement, change: ContentChange) {
      const preview = change.preview;
      const tool = change.tool || '';
      const ro = { readOnly: true as const };

      if (tool === 'add_gallery_photo' || preview?.kind === 'gallery') {
        const gallery =
          preview && preview.kind === 'gallery'
            ? preview
            : { image: '', tags: [] as string[], focus: 'center' };
        renderGallerySitePreview(wrap, gallery);
        return;
      }

      if (tool === 'update_lesson_rates' || preview?.kind === 'rates') {
        const rates =
          preview && preview.kind === 'rates'
            ? preview.rates
            : [
                { id: '30min', label: '30-minute session', priceAmount: 0 },
                { id: '60min', label: '60-minute session', priceAmount: 0 },
              ];
        renderRatesSitePreview(wrap, rates);
        return;
      }

      if (tool === 'update_reel_url' || preview?.kind === 'reel') {
        const url = preview && preview.kind === 'reel' ? preview.reelUrl : '';
        const title = preview && preview.kind === 'reel' ? preview.reelTitle : '';
        renderReelSitePreview(wrap, url, title);
        return;
      }

      if (tool === 'update_short_bio' || preview?.kind === 'shortBio') {
        const bio = preview && preview.kind === 'shortBio' ? preview.shortBio : '';
        renderShortBioSitePreview(wrap, bio);
        return;
      }

      if (tool === 'update_press_quote' || preview?.kind === 'pressQuote') {
        const quote = preview && preview.kind === 'pressQuote' ? preview.quote : '';
        const attribution = preview && preview.kind === 'pressQuote' ? preview.attribution : '';
        renderPressQuoteSitePreview(wrap, quote, attribution);
        return;
      }

      if (tool === 'update_performer_facts' || preview?.kind === 'performer') {
        const performer =
          preview && preview.kind === 'performer' ? preview.performer : ({} as Record<string, string>);
        renderPerformerFactsSitePreview(wrap, performer);
        return;
      }

      if (tool === 'update_casting_fields' || preview?.kind === 'casting') {
        const casting =
          preview && preview.kind === 'casting'
            ? preview
            : {
                slug: '',
                keyword: '',
                title: '',
                description: '',
                cta: '',
                relatedShows: [] as string[],
                relatedSkills: [] as string[],
              };
        wrap.dataset.castingSlug = casting.slug || '';
        appendLabeledInput(wrap, 'Keyword', 'keyword', String(casting.keyword || ''), { ...ro });
        appendLabeledInput(wrap, 'Title', 'title', String(casting.title || ''), { ...ro });
        appendLabeledInput(wrap, 'Description', 'description', String(casting.description || ''), {
          rows: 3,
          ...ro,
        });
        appendLabeledInput(wrap, 'Button label (CTA)', 'cta', String(casting.cta || ''), { ...ro });
        appendLabeledInput(
          wrap,
          'Related shows (one per line)',
          'relatedShows',
          (casting.relatedShows || []).join('\n'),
          { rows: 3, ...ro },
        );
        appendLabeledInput(
          wrap,
          'Related skills (one per line)',
          'relatedSkills',
          (casting.relatedSkills || []).join('\n'),
          { rows: 3, ...ro },
        );
      }
    }

    function renderChangesEditor(changes: ContentChange[]) {
      changesEditor.replaceChildren();
      changes.forEach((change, index) => {
        const wrap = document.createElement('div');
        wrap.className = 'space-y-2 rounded-sm border border-line bg-panel/40 p-4';
        wrap.dataset.index = String(index);
        wrap.dataset.tool = change.tool || '';

        const isDiscrete = Boolean(change.tool && DISCRETE_TOOLS.has(change.tool));

        if (isDiscrete) {
          const headline = document.createElement('p');
          headline.className = 'text-sm text-spotlight';
          headline.textContent = discreteWillPublishCopy(change);
          wrap.appendChild(headline);
          renderDiscretePreview(wrap, change);
        } else {
          const meta = document.createElement('p');
          meta.className = 'text-xs text-muted';
          const liveHint = change.livePath || '';
          meta.textContent = liveHint
            ? `Will update ${liveHint}`
            : change.summary || 'Website update';
          wrap.appendChild(meta);

          if (change.summary) {
            const summary = document.createElement('p');
            summary.className = 'text-sm text-spotlight';
            summary.textContent = change.summary;
            wrap.appendChild(summary);
          }

          const contentLabel = document.createElement('label');
          contentLabel.className = 'block text-sm text-muted';
          contentLabel.textContent = 'Content';
          const contentArea = document.createElement('textarea');
          contentArea.rows = 12;
          contentArea.value = change.content;
          contentArea.dataset.field = 'content';
          contentArea.className =
            'mt-1 w-full rounded-sm border border-line bg-ink px-3 py-3 font-mono text-xs text-spotlight outline-none focus:border-gold';
          contentLabel.appendChild(contentArea);
          wrap.appendChild(contentLabel);
        }

        changesEditor.appendChild(wrap);
      });
    }

    async function composeDiscrete(
      tool: string,
      args: Record<string, unknown>,
      photo?: PhotoPayload,
    ): Promise<{ changes: ContentChange[]; provisionalPhotoPath: string | null }> {
      const res = await fetch('/api/updateContent', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ mode: 'compose', tool, args, photo }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        throw new Error(formatApiError(data, 'Could not prepare that update.'));
      }
      const changes = Array.isArray(data.changes) ? (data.changes as ContentChange[]) : [];
      if (!changes.length) {
        throw new Error('No website update was prepared.');
      }
      return {
        changes: changes.map((c) => ({
          tool: c.tool,
          path: c.path,
          content: c.content,
          commitMessage: c.commitMessage,
          summary: c.summary,
          livePath: c.livePath,
          preview: c.preview,
          commitParams: c.commitParams,
        })),
        provisionalPhotoPath:
          typeof data.provisionalPhotoPath === 'string' ? data.provisionalPhotoPath : null,
      };
    }

    async function readEditedChanges(): Promise<ContentChange[]> {
      const blocks = Array.from(changesEditor.children) as HTMLElement[];
      const out: ContentChange[] = [];
      for (let index = 0; index < blocks.length; index++) {
        const block = blocks[index];
        const base = draftChanges[index] || { path: '', content: '', commitMessage: '' };
        // Discrete Preview is confirmation-only (read-only). Publish the composed draft as-is.
        if (base.tool && DISCRETE_TOOLS.has(base.tool)) {
          out.push(base);
          continue;
        }
        const content =
          (block.querySelector('[data-field="content"]') as HTMLTextAreaElement | null)?.value ??
          base.content;
        out.push({
          tool: base.tool,
          summary: base.summary,
          path: base.path,
          content,
          commitMessage: base.commitMessage,
          livePath: base.livePath,
          preview: base.preview,
          commitParams: base.commitParams,
        });
      }
      return out;
    }

    async function loadDiscreteDefaults() {
      try {
        const res = await fetch('/api/studioDiscrete');
        if (!res.ok) return;
        const data = await res.json();
        if (!data?.authorized) return;
        const rates = Array.isArray(data.rates) ? data.rates : [];
        for (const rate of rates) {
          if (rate.id === '30min' && rate.priceAmount != null) {
            quickRate30.value = String(rate.priceAmount);
          }
          if (rate.id === '60min' && rate.priceAmount != null) {
            quickRate60.value = String(rate.priceAmount);
          }
        }
        const performer = data.performer && typeof data.performer === 'object' ? data.performer : null;
        if (performer) {
          factAvailability.value = String(performer.availability || '');
          factVocalType.value = String(performer.vocalType || '');
          factVocalRange.value = String(performer.vocalRange || '');
          factUnion.value = String(performer.union || '');
          factPlayingAge.value = String(performer.playingAge || '');
          factHeight.value = String(performer.height || '');
          factEthnicity.value = String(performer.ethnicity || '');
        }
        if (typeof data.reelUrl === 'string' && data.reelUrl) {
          reelUrlInput.value = data.reelUrl;
        }
        if (typeof data.reelTitle === 'string' && data.reelTitle) {
          reelTitleInput.value = data.reelTitle;
        }
        if (typeof data.shortBio === 'string' && data.shortBio) {
          shortBioInput.value = data.shortBio;
        }
        const press = data.pressQuote && typeof data.pressQuote === 'object' ? data.pressQuote : null;
        if (press) {
          if (typeof press.quote === 'string') pressQuoteInput.value = press.quote;
          if (typeof press.attribution === 'string') {
            pressAttributionInput.value = press.attribution;
          }
        }
        captureLiveDiscreteDefaultsFromForm();
      } catch {
        /* non-fatal */
      }
    }

    function resetComposeForm() {
      messageEl.value = '';
      photoEl.value = '';
      draftPhoto = undefined;
