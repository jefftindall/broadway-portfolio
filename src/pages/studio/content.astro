    function photoPayloadToObjectUrl(photo: PhotoPayload): string {
      const binary = atob(photo.dataBase64);
      const bytes = new Uint8Array(binary.length);
      for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i)!;
      return URL.createObjectURL(new Blob([bytes], { type: photo.contentType || 'image/jpeg' }));
    }

    function renderGallerySitePreview(
