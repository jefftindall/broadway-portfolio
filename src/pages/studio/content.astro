      changesEditor.replaceChildren();
      previewReply.textContent = '';
      doneReply.textContent = '';
      doneSha.textContent = '';
      doneBranch.textContent = '';
      doneBranch.classList.add('hidden');
      donePr.replaceChildren();
      donePr.classList.add('hidden');
      pipelineSection.classList.remove('hidden');
      stagingTestSection.classList.add('hidden');
      pipelineList.replaceChildren();
      pageLinks.replaceChildren();
