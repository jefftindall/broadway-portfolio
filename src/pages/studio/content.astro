    function youtubeOrVimeoEmbed(raw: string): string | null {
      try {
        const u = new URL(raw);
        if (u.hostname.includes('youtu.be')) {
          return `https://www.youtube.com/embed/${u.pathname.slice(1)}`;
        }
        if (u.hostname.includes('youtube.com')) {
          const id = u.searchParams.get('v');
          return id ? `https://www.youtube.com/embed/${id}` : null;
        }
        if (u.hostname.includes('vimeo.com')) {
          const id = u.pathname.split('/').filter(Boolean).pop();
          return id ? `https://player.vimeo.com/video/${id}` : null;
        }
      } catch {
        return null;
      }
      return null;
    }

    function formatRatePrice(rate: { price?: string; priceAmount: number }): string {
      if (rate.price && String(rate.price).trim()) return String(rate.price).trim();
      return `$${Math.round(Number(rate.priceAmount) || 0)}`;
    }

