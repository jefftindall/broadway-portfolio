---
import StudioLayout from '../../layouts/StudioLayout.astro';
import StudioLandingCard from '../../components/StudioLandingCard.astro';
---

<StudioLayout
  title="Students"
  description="Private Studio student and lesson ops."
  heading="Students"
  helpHref="/studio/help/students"
>
  <section class="mx-auto max-w-xl px-4 py-5 md:py-8">
    <p class="text-sm text-muted">
      Teaching relationships and lesson ops. People, payment status, and lesson schedules are live.
      Reminders are not built yet. Studio-wide holidays and vacations will live under Admin →
      Calendar later — not here.
    </p>
    <div class="mt-5 grid gap-3" id="students-cards">
      <StudioLandingCard
        href="/studio/people"
        title="People"
        summary="Students, parents, and related contacts — notes, personas, and lifetime value."
        primary
      />
      <div id="schedules-card-wrap">
        <StudioLandingCard
          href="/studio/calendar"
          title="Schedules"
          summary="Request a voice lesson time. Confirmed when Elyse accepts the Google invite."
        />
      </div>
      <StudioLandingCard
        href="/studio/students/payments"
        title="Payment status"
        summary="Copy Payment Links and attach Stripe charges that need a person. Upcoming lesson paid/unpaid still waits on joining confirmed lessons."
      />
      <StudioLandingCard
        title="Reminders"
        summary="Appointment reminder settings. Not available yet."
        available={false}
      />
    </div>
  </section>
</StudioLayout>

<script>
  import { fetchStudioSession } from '../../lib/studioSession';

  const wrap = document.getElementById('schedules-card-wrap');
  if (wrap) {
    const session = await fetchStudioSession();
    if (!session.lessonSchedulingEnabled) {
      wrap.innerHTML = `
        <div class="block rounded-sm border border-line bg-panel/20 px-4 py-4 text-left opacity-80">
          <span class="block font-display text-2xl text-spotlight">Schedules</span>
          <span class="mt-1 block text-sm text-muted">Lesson scheduling is not enabled in this environment yet.</span>
          <span class="mt-2 block text-xs uppercase tracking-[0.15em] text-gel">Not available yet</span>
        </div>`;
    }
  }
</script>
