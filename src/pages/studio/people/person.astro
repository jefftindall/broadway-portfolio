---
import StudioLayout from '../../../layouts/StudioLayout.astro';
import {
  STUDIO_PERSONAS,
  STUDIO_PERSONA_LABELS,
  STUDIO_RELATED_RELATIONS,
  STUDIO_RELATED_LABELS,
  STUDIO_STUDENT_FORMATS,
  STUDIO_STUDENT_FORMAT_LABELS,
  STUDIO_WARMTH,
  STUDIO_WARMTH_LABELS,
  STUDIO_OFFLINE_METHODS,
  STUDIO_OFFLINE_METHOD_LABELS,
} from '../../../lib/studioPeople';

// Contact ids live in Table Storage. This static shell reads `?id=` in the
// browser so `astro build` (`output: 'static'`) does not need getStaticPaths.
---

<StudioLayout
  title="Person"
  description="Private Studio contact detail."
  helpHref="/studio/help/students"
>
  <section class="mx-auto max-w-xl px-4 py-5 md:py-8">
    <p class="text-sm">
      <a href="/studio/people" class="text-gel underline-offset-2 hover:text-gold hover:underline">
        ← People
      </a>
    </p>
    <h1 id="person-title" class="mt-3 font-display text-3xl text-spotlight md:text-4xl">Person</h1>

    <div
      id="people-gate"
      class="mt-4 hidden rounded-sm border border-line bg-panel/60 p-4 text-sm text-muted"
      role="alert"
    >
      <p id="people-gate-msg">You’re signed in, but this account cannot view People.</p>
      <p class="mt-4">
        <a href="/studio" class="text-gel underline-offset-2 hover:text-gold hover:underline">Back to Studio</a>
      </p>
    </div>

    <div
      id="people-error"
      class="mt-4 hidden rounded-sm border border-line bg-panel/60 p-3 text-sm text-muted"
      role="alert"
    >
      <p id="people-error-msg"></p>
      <p id="people-error-ref" class="mt-2 hidden">
        Reference: <code id="people-error-id" class="break-all text-spotlight"></code>
      </p>
    </div>

    <p id="people-status" class="busy-status mt-4 text-sm text-muted" role="status" aria-live="polite">
      <span class="busy-spinner" aria-hidden="true"></span>
      <span>Loading…</span>
    </p>

    <form id="edit-form" class="mt-6 hidden space-y-4">
      <label class="block text-sm text-muted">
        Name
        <input
          id="edit-name"
          type="text"
          required
          class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
        />
      </label>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="block text-sm text-muted">
          Email
          <input
            id="edit-email"
            type="email"
            class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
          />
        </label>
        <label class="block text-sm text-muted">
          Phone
          <input
            id="edit-phone"
            type="tel"
            class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
          />
        </label>
      </div>
      <fieldset>
        <legend class="text-sm text-muted">Personas</legend>
        <div class="mt-2 flex flex-wrap gap-2">
          {
            STUDIO_PERSONAS.map((persona) => (
              <label class="inline-flex items-center gap-2 rounded-sm border border-line px-3 py-2 text-sm text-spotlight">
                <input type="checkbox" name="edit-persona" value={persona} />
                {STUDIO_PERSONA_LABELS[persona]}
              </label>
            ))
          }
        </div>
      </fieldset>
      <label class="block text-sm text-muted">
        Notes
        <textarea
          id="edit-notes"
          rows="4"
          class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
        ></textarea>
      </label>

      <div id="student-fields" class="hidden space-y-3 rounded-sm border border-line bg-panel/40 p-4">
        <h2 class="font-display text-2xl text-spotlight">Student</h2>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="block text-sm text-muted">
            Lesson rate ($)
            <input
              id="edit-rate"
              type="number"
              min="0"
              step="1"
              class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
            />
          </label>
          <label class="block text-sm text-muted">
            Format
            <select
              id="edit-format"
              class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
            >
              <option value="">Not set</option>
              {
                STUDIO_STUDENT_FORMATS.map((format) => (
                  <option value={format}>{STUDIO_STUDENT_FORMAT_LABELS[format]}</option>
                ))
              }
            </select>
          </label>
          <label class="block text-sm text-muted">
            Package remaining
            <input
              id="edit-package"
              type="number"
              min="0"
              step="1"
              class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
            />
          </label>
          <label class="block text-sm text-muted">
            Last lesson
            <input
              id="edit-last-lesson"
              type="date"
              class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
            />
          </label>
        </div>
        <label class="inline-flex items-center gap-2 text-sm text-spotlight">
          <input id="edit-sms-ok" type="checkbox" />
          SMS reminders OK (explicit opt-in only)
        </label>
      </div>

      <div id="agent-fields" class="hidden space-y-3 rounded-sm border border-line bg-panel/40 p-4">
        <h2 class="font-display text-2xl text-spotlight">Agent</h2>
        <label class="block text-sm text-muted">
          Agency
          <input
            id="edit-agency"
            type="text"
            class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
          />
        </label>
        <label class="block text-sm text-muted">
          Territory
          <input
            id="edit-territory"
            type="text"
            class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
          />
        </label>
        <label class="block text-sm text-muted">
          Last submission
          <input
            id="edit-last-submission"
            type="text"
            class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
          />
        </label>
        <label class="block text-sm text-muted">
          Last booking
          <input
            id="edit-last-booking"
            type="text"
            class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
          />
        </label>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="block text-sm text-muted">
            Last booking year
            <input
              id="edit-last-booking-year"
              type="number"
              min="1950"
              max="2100"
              step="1"
              class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
            />
          </label>
          <label class="block text-sm text-muted">
            Last touch
            <input
              id="edit-last-touch"
              type="date"
              class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
            />
          </label>
        </div>
        <label class="block text-sm text-muted">
          Warmth
          <select
            id="edit-warmth"
            class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
          >
            <option value="">Not set</option>
            {
              STUDIO_WARMTH.map((warmth) => (
                <option value={warmth}>{STUDIO_WARMTH_LABELS[warmth]}</option>
              ))
            }
          </select>
        </label>
        <p id="agent-recency" class="text-sm text-muted"></p>
        <label class="block text-sm text-muted">
          Next step
          <input
            id="edit-next-step"
            type="text"
            class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
          />
        </label>
      </div>

      <div id="casting-fields" class="hidden space-y-3 rounded-sm border border-line bg-panel/40 p-4">
        <h2 class="font-display text-2xl text-spotlight">Casting</h2>
        <p class="text-sm text-muted">Relationship value — not a dollar total.</p>
        <label class="block text-sm text-muted">
          Last materials request
          <input
            id="edit-casting-request"
            type="text"
            class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
          />
        </label>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="block text-sm text-muted">
            Request date
            <input
              id="edit-casting-request-on"
              type="date"
              class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
            />
          </label>
          <label class="block text-sm text-muted">
            Warmth
            <select
              id="edit-casting-warmth"
              class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
            >
              <option value="">Not set</option>
              {
                STUDIO_WARMTH.map((warmth) => (
                  <option value={warmth}>{STUDIO_WARMTH_LABELS[warmth]}</option>
                ))
              }
            </select>
          </label>
        </div>
        <p id="casting-recency" class="text-sm text-muted"></p>
      </div>

      <div class="space-y-3 rounded-sm border border-line bg-panel/40 p-4">
        <h2 class="font-display text-2xl text-spotlight">Related people</h2>
        <ul id="related-list" class="space-y-2 text-sm"></ul>
        <div class="grid gap-3 sm:grid-cols-[1fr_auto_auto] sm:items-end">
          <label class="block text-sm text-muted">
            Link an existing person
            <select
              id="related-pick"
              class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
            >
              <option value="">Choose…</option>
            </select>
          </label>
          <label class="block text-sm text-muted">
            Relation
            <select
              id="related-relation"
              class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
            >
              {
                STUDIO_RELATED_RELATIONS.map((relation) => (
                  <option value={relation}>{STUDIO_RELATED_LABELS[relation]}</option>
                ))
              }
            </select>
          </label>
          <button
            id="related-add"
            type="button"
            class="rounded-sm border border-line px-4 py-2 text-sm text-spotlight hover:border-gold"
          >
            Link
          </button>
        </div>
      </div>

      <div class="flex flex-wrap gap-2">
        <button
          id="edit-save-btn"
          type="submit"
          data-label="Save changes"
          class="inline-flex items-center justify-center gap-2 rounded-sm bg-gold px-4 py-2 text-sm font-semibold text-ink hover:brightness-110 disabled:cursor-wait disabled:opacity-60 disabled:hover:brightness-100"
        >
          Save changes
        </button>
        <button
          id="archive-btn"
          type="button"
          data-label="Archive"
          class="inline-flex items-center justify-center gap-2 rounded-sm border border-line px-4 py-2 text-sm text-spotlight hover:border-gold disabled:cursor-wait disabled:opacity-60"
        >
          Archive
        </button>
      </div>
    </form>

    <div id="student-value" class="mt-6 hidden space-y-4 rounded-sm border border-line bg-panel/40 p-4">
      <h2 class="font-display text-2xl text-spotlight">Lifetime value</h2>
      <p id="student-ltv" class="text-sm text-spotlight"></p>
      <p id="student-ltv-sync" class="text-xs text-muted"></p>
      <div id="pay-links" class="hidden space-y-2">
        <h3 class="font-display text-xl text-spotlight">Payment links</h3>
        <p class="text-sm text-muted">Copy or share a lesson Payment Link. Studio never charges a card from voice.</p>
        <div id="pay-link-buttons" class="flex flex-col gap-2 sm:flex-row sm:flex-wrap"></div>
      </div>
      <div>
        <h3 class="font-display text-xl text-spotlight">Payments</h3>
        <ul id="payment-list" class="mt-2 space-y-2 text-sm text-muted"></ul>
      </div>
      <form id="offline-form" class="space-y-3">
        <h3 class="font-display text-xl text-spotlight">Log offline money</h3>
        <p class="text-sm text-muted">Venmo, cash, Zelle, or other — not a Stripe charge.</p>
        <div class="grid gap-3 sm:grid-cols-3">
          <label class="block text-sm text-muted">
            Amount ($)
            <input
              id="offline-amount"
              type="number"
              min="1"
              step="1"
              required
              class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
            />
          </label>
          <label class="block text-sm text-muted">
            Method
            <select
              id="offline-method"
              class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
            >
              {
                STUDIO_OFFLINE_METHODS.map((method) => (
                  <option value={method}>{STUDIO_OFFLINE_METHOD_LABELS[method]}</option>
                ))
              }
            </select>
          </label>
          <label class="block text-sm text-muted">
            Date
            <input
              id="offline-date"
              type="date"
              required
              class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
            />
          </label>
        </div>
        <button
          id="offline-save-btn"
          type="submit"
          data-label="Add offline payment"
          class="inline-flex items-center justify-center gap-2 rounded-sm bg-gold px-4 py-2 text-sm font-semibold text-ink hover:brightness-110 disabled:cursor-wait disabled:opacity-60 disabled:hover:brightness-100"
        >
          Add offline payment
        </button>
      </form>
      <div id="comms-panel" class="hidden space-y-3 border-t border-line pt-4">
        <h3 class="font-display text-xl text-spotlight">Send a message</h3>
        <p class="text-sm text-muted">
          Explicit tap only — never from voice. Requires an email on this person.
        </p>
        <label class="block text-sm text-muted">
          Lesson (for confirm / reminder templates)
          <select
            id="comms-lesson"
            class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
          >
            <option value="">None</option>
          </select>
        </label>
        <div id="comms-buttons" class="flex flex-wrap gap-2"></div>
        <p id="comms-status" class="hidden text-sm text-muted" role="status"></p>
      </div>
    </div>

    <div id="parent-value" class="mt-6 hidden space-y-2 rounded-sm border border-line bg-panel/40 p-4">
      <h2 class="font-display text-2xl text-spotlight">Linked student value</h2>
      <p id="parent-ltv" class="text-sm text-muted"></p>
    </div>
  </section>
</StudioLayout>

<script>
  import {
    STUDIO_OFFLINE_METHOD_LABELS,
    STUDIO_RELATED_LABELS,
    careerRecencyLabel,
    formatUsdFromCents,
    studioPersonPath,
    type StudioOfflineMethod,
  } from '../../../lib/studioPeople';
  import {
    STUDIO_PERMISSION,
    fetchStudioSession,
    hasStudioPermission,
  } from '../../../lib/studioSession';
  import { renderPayLinkMenus } from '../../../lib/studioPayLinks';
  import { clearStudioStatus, setStudioStatus } from '../../../lib/studioStatus';
  import { isButtonBusy, withButtonBusy } from '../../../lib/buttonBusy';

  type Related = { id: string; relation: string };
  type Contact = {
    id: string;
    displayName: string;
    email: string;
    phone: string;
    personas: string[];
    notes: string;
    archived: boolean;
    studentRateCents: number | null;
    studentFormat: string;
    studentPackageRemaining: number | null;
    studentLastLesson: string;
    agentAgency: string;
    agentTerritory: string;
    agentLastSubmission: string;
    agentLastBooking: string;
    agentLastBookingYear: number | null;
    agentNextStep: string;
    agentWarmth: string;
    agentLastTouch: string;
    castingLastRequest: string;
    castingLastRequestOn: string;
    castingWarmth: string;
    studentSmsOk: boolean;
    studentLtvCents: number;
    studentLtvStripeCents: number;
    studentLtvOfflineCents: number;
    studentLtvSyncedAt: string;
    relatedContacts: Related[];
    etag?: string;
  };
  type LedgerRow = {
    id: string;
    source: string;
    amountCents: number;
    refundedCents: number;
    netCents: number;
    method: string;
    paidOn: string;
    matchKind: string;
  };

  const contactId = new URLSearchParams(window.location.search).get('id') || '';
  const titleEl = document.getElementById('person-title') as HTMLElement;
  const statusEl = document.getElementById('people-status') as HTMLElement;
  const form = document.getElementById('edit-form') as HTMLFormElement;
  const errorBox = document.getElementById('people-error') as HTMLElement;
  const errorMsg = document.getElementById('people-error-msg') as HTMLElement;
  const errorRef = document.getElementById('people-error-ref') as HTMLElement;
  const errorId = document.getElementById('people-error-id') as HTMLElement;
  const studentFields = document.getElementById('student-fields') as HTMLElement;
  const agentFields = document.getElementById('agent-fields') as HTMLElement;
  const castingFields = document.getElementById('casting-fields') as HTMLElement;
  const studentValue = document.getElementById('student-value') as HTMLElement;
  const parentValue = document.getElementById('parent-value') as HTMLElement;
  const studentLtv = document.getElementById('student-ltv') as HTMLElement;
  const studentLtvSync = document.getElementById('student-ltv-sync') as HTMLElement;
  const parentLtv = document.getElementById('parent-ltv') as HTMLElement;
  const paymentList = document.getElementById('payment-list') as HTMLElement;
  const payLinks = document.getElementById('pay-links') as HTMLElement;
  const payLinkButtons = document.getElementById('pay-link-buttons') as HTMLElement;
  const commsPanel = document.getElementById('comms-panel') as HTMLElement;
  const commsLesson = document.getElementById('comms-lesson') as HTMLSelectElement;
  const commsButtons = document.getElementById('comms-buttons') as HTMLElement;
  const commsStatus = document.getElementById('comms-status') as HTMLElement;
  const offlineForm = document.getElementById('offline-form') as HTMLFormElement;
  const agentRecency = document.getElementById('agent-recency') as HTMLElement;
  const castingRecency = document.getElementById('casting-recency') as HTMLElement;
  const relatedList = document.getElementById('related-list') as HTMLElement;
  const relatedPick = document.getElementById('related-pick') as HTMLSelectElement;
  const relatedRelation = document.getElementById('related-relation') as HTMLSelectElement;
  const archiveBtn = document.getElementById('archive-btn') as HTMLButtonElement;
  const saveBtn = document.getElementById('edit-save-btn') as HTMLButtonElement;
  const offlineSaveBtn = document.getElementById('offline-save-btn') as HTMLButtonElement;
  const peopleGate = document.getElementById('people-gate') as HTMLElement;
  let canWrite = true;

  let current: Contact | null = null;
  let directory: Contact[] = [];
  let payments: LedgerRow[] = [];
  let payLinkMap: Record<string, string> = {};

  function showError(message: string, correlationId?: string) {
    errorMsg.textContent = message;
    if (correlationId) {
      errorId.textContent = correlationId;
      errorRef.classList.remove('hidden');
    } else {
      errorRef.classList.add('hidden');
    }
    errorBox.classList.remove('hidden');
  }

  function clearError() {
    errorBox.classList.add('hidden');
  }

  function selectedPersonas() {
    return [...document.querySelectorAll<HTMLInputElement>('input[name="edit-persona"]:checked')].map(
      (el) => el.value,
    );
  }

  function togglePersonaSections() {
    const personas = selectedPersonas();
    studentFields.classList.toggle('hidden', !personas.includes('student'));
    agentFields.classList.toggle('hidden', !personas.includes('agent'));
    castingFields.classList.toggle('hidden', !personas.includes('casting'));
    studentValue.classList.toggle('hidden', !personas.includes('student'));
    parentValue.classList.toggle('hidden', !personas.includes('parent'));
  }

  function fillForm(contact: Contact) {
    current = contact;
    titleEl.textContent = contact.displayName;
    (document.getElementById('edit-name') as HTMLInputElement).value = contact.displayName;
    (document.getElementById('edit-email') as HTMLInputElement).value = contact.email || '';
    (document.getElementById('edit-phone') as HTMLInputElement).value = contact.phone || '';
    (document.getElementById('edit-notes') as HTMLTextAreaElement).value = contact.notes || '';
    document.querySelectorAll<HTMLInputElement>('input[name="edit-persona"]').forEach((box) => {
      box.checked = contact.personas.includes(box.value);
    });
    (document.getElementById('edit-rate') as HTMLInputElement).value =
      contact.studentRateCents === null || contact.studentRateCents === undefined
        ? ''
        : String(Math.round(contact.studentRateCents / 100));
    (document.getElementById('edit-format') as HTMLSelectElement).value = contact.studentFormat || '';
    (document.getElementById('edit-package') as HTMLInputElement).value =
      contact.studentPackageRemaining === null || contact.studentPackageRemaining === undefined
        ? ''
        : String(contact.studentPackageRemaining);
    (document.getElementById('edit-last-lesson') as HTMLInputElement).value = contact.studentLastLesson || '';
    (document.getElementById('edit-sms-ok') as HTMLInputElement).checked = Boolean(contact.studentSmsOk);
    (document.getElementById('edit-agency') as HTMLInputElement).value = contact.agentAgency || '';
    (document.getElementById('edit-territory') as HTMLInputElement).value = contact.agentTerritory || '';
    (document.getElementById('edit-last-submission') as HTMLInputElement).value =
      contact.agentLastSubmission || '';
    (document.getElementById('edit-last-booking') as HTMLInputElement).value = contact.agentLastBooking || '';
    (document.getElementById('edit-last-booking-year') as HTMLInputElement).value =
      contact.agentLastBookingYear === null || contact.agentLastBookingYear === undefined
        ? ''
        : String(contact.agentLastBookingYear);
    (document.getElementById('edit-last-touch') as HTMLInputElement).value = contact.agentLastTouch || '';
    (document.getElementById('edit-warmth') as HTMLSelectElement).value = contact.agentWarmth || '';
    (document.getElementById('edit-next-step') as HTMLInputElement).value = contact.agentNextStep || '';
    (document.getElementById('edit-casting-request') as HTMLInputElement).value =
      contact.castingLastRequest || '';
    (document.getElementById('edit-casting-request-on') as HTMLInputElement).value =
      contact.castingLastRequestOn || '';
    (document.getElementById('edit-casting-warmth') as HTMLSelectElement).value =
      contact.castingWarmth || '';
    agentRecency.textContent = contact.agentLastTouch
      ? `Recency: ${careerRecencyLabel(contact.agentLastTouch)}`
      : 'Recency: no date yet. Stale agents appear under Career → Agents.';
    castingRecency.textContent = contact.castingLastRequestOn
      ? `Recency: ${careerRecencyLabel(contact.castingLastRequestOn)}`
      : 'Recency: no date yet.';
    const archiveLabel = contact.archived ? 'Restore' : 'Archive';
    archiveBtn.dataset.label = archiveLabel;
    archiveBtn.textContent = archiveLabel;
    togglePersonaSections();
    renderRelated();
    renderValue();
    renderComms();
    form.classList.remove('hidden');
    statusEl.classList.remove('busy-status');
    statusEl.textContent = contact.archived ? 'Archived — restore to show them in the main list.' : '';
  }

  async function loadLessonsForComms() {
    if (!contactId) return;
    const res = await fetch(`/api/lessons?contactId=${encodeURIComponent(contactId)}`, {
      headers: { Accept: 'application/json' },
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) return;
    commsLesson.replaceChildren(new Option('None', ''));
    for (const lesson of (data.lessons || []) as { id: string; startAt: string; status: string }[]) {
      if (lesson.status === 'cancelled' || lesson.status === 'declined') continue;
      const when = new Date(lesson.startAt).toLocaleString('en-US', {
        timeZone: 'America/New_York',
        month: 'short',
        day: 'numeric',
        hour: 'numeric',
        minute: '2-digit',
      });
      commsLesson.add(new Option(`${when} · ${lesson.status}`, lesson.id));
    }
  }

  function renderComms() {
    if (!current || !canWrite || !current.email) {
      commsPanel.classList.add('hidden');
      return;
    }
    commsPanel.classList.remove('hidden');
    const templates: { id: string; label: string; needsLesson?: boolean; personas?: string[] }[] = [
      { id: 'pay_link', label: 'Send pay link', personas: ['student', 'parent'] },
      { id: 'lesson_confirm_resend', label: 'Resend Confirmed', needsLesson: true, personas: ['student', 'parent'] },
      { id: 'lesson_reminder', label: 'Send reminder', needsLesson: true, personas: ['student', 'parent'] },
      { id: 'materials_thanks', label: 'Thanks for materials', personas: ['casting', 'agent'] },
    ];
    commsButtons.replaceChildren(
      ...templates
        .filter((row) => !row.personas || row.personas.some((p) => current!.personas.includes(p)))
        .map((row) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className =
            'inline-flex items-center justify-center gap-2 rounded-sm border border-line px-3 py-2 text-sm text-spotlight hover:border-gold disabled:cursor-wait disabled:opacity-60';
          btn.dataset.label = row.label;
          btn.textContent = row.label;
          btn.addEventListener('click', () => {
            void withButtonBusy(btn, () => sendTemplate(row.id, row.needsLesson), row.label);
          });
          return btn;
        }),
    );
    void loadLessonsForComms();
  }

  async function sendTemplate(template: string, needsLesson?: boolean) {
    if (!current?.email) {
      showError('Add an email before sending a message.');
      return;
    }
    const lessonId = commsLesson.value;
    if (needsLesson && !lessonId) {
      showError('Choose a lesson for this template.');
      return;
    }
    commsStatus.classList.add('hidden');
    const res = await fetch('/api/studioComms', {
      method: 'POST',
      headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
      body: JSON.stringify({ template, contactId: current.id, lessonId: lessonId || undefined }),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) {
      showError(data.error || 'Could not send that message.', data.correlationId);
      return;
    }
    commsStatus.textContent = 'Message sent.';
    commsStatus.classList.remove('hidden');
  }

  function renderValue() {
    if (!current) return;
    const stripe = current.studentLtvStripeCents ?? 0;
    const offline = current.studentLtvOfflineCents ?? 0;
    const total = current.studentLtvCents ?? stripe + offline;
    studentLtv.textContent = `${formatUsdFromCents(total)} lifetime · ${formatUsdFromCents(stripe)} Stripe · ${formatUsdFromCents(offline)} offline`;
    studentLtvSync.textContent = current.studentLtvSyncedAt
      ? `Last synced ${new Date(current.studentLtvSyncedAt).toLocaleString()}`
      : 'No Stripe match yet.';
    const linkedStudents = (current.relatedContacts || []).filter((rel) => rel.relation === 'student');
    const linkedTotal = linkedStudents.reduce((sum, rel) => {
      const other = directory.find((row) => row.id === rel.id);
      return sum + (other?.studentLtvCents ?? 0);
    }, 0);
    parentLtv.textContent = linkedStudents.length
      ? `Linked students: ${formatUsdFromCents(linkedTotal)} (not a second invoice).`
      : 'Link a student to see their lifetime value here.';
    paymentList.replaceChildren(
      ...(payments.length
        ? payments.map((row) => {
            const li = document.createElement('li');
            const method =
              row.source === 'stripe'
                ? 'Stripe'
                : STUDIO_OFFLINE_METHOD_LABELS[row.method as StudioOfflineMethod] || row.method;
            const refund =
              row.refundedCents > 0 ? ` · refunded ${formatUsdFromCents(row.refundedCents)}` : '';
            li.textContent = `${row.paidOn || '—'} · ${formatUsdFromCents(row.netCents)} · ${method}${refund}`;
            if (row.source === 'offline' && canWrite) {
              const remove = document.createElement('button');
              remove.type = 'button';
              remove.className =
                'ml-2 inline-flex items-center gap-1 text-xs text-muted underline-offset-2 hover:text-gold hover:underline disabled:cursor-wait disabled:opacity-60';
              remove.dataset.label = 'Remove';
              remove.textContent = 'Remove';
              remove.addEventListener('click', () => {
                void removeOffline(row.id, remove);
              });
              li.append(remove);
            }
            return li;
          })
        : [
            Object.assign(document.createElement('li'), {
              textContent: 'No Stripe or offline payments on this student yet.',
            }),
          ]),
    );
    const entries = Object.entries(payLinkMap);
    payLinks.classList.toggle('hidden', entries.length === 0);
    renderPayLinkMenus(payLinkButtons, payLinkMap, (message) => showError(message));
  }

  async function removeOffline(paymentId: string, button: HTMLButtonElement) {
    if (!canWrite) return;
    await withButtonBusy(button, async () => {
      clearError();
      try {
        const res = await fetch(
          `/api/contacts/${encodeURIComponent(contactId)}/offlinePayments/${encodeURIComponent(paymentId)}`,
          { method: 'DELETE', headers: { Accept: 'application/json' } },
        );
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          showError(data.error || 'Could not remove that payment.', data.correlationId);
          return;
        }
        if (data.contact) current = { ...current!, ...(data.contact as Contact) };
        payments = payments.filter((row) => row.id !== paymentId);
        renderValue();
      } catch {
        showError('Could not remove that payment. Try again in a moment.');
      }
    }, 'Removing…');
  }

  function renderRelated() {
    if (!current) return;
    relatedList.replaceChildren(
      ...(current.relatedContacts || []).map((rel) => {
        const other = directory.find((row) => row.id === rel.id);
        const li = document.createElement('li');
        li.className = 'flex flex-wrap items-center justify-between gap-2';
        const label = other?.displayName || 'Linked person';
        const relation = STUDIO_RELATED_LABELS[rel.relation as keyof typeof STUDIO_RELATED_LABELS] || rel.relation;
        li.innerHTML = `
          <a href="${studioPersonPath(rel.id)}" class="text-gel underline-offset-2 hover:text-gold hover:underline">${escapeHtml(label)}</a>
          <span class="text-xs text-muted">${escapeHtml(relation)}</span>
          <button type="button" data-unlink="${escapeHtml(rel.id)}" class="text-xs text-muted underline-offset-2 hover:text-gold hover:underline">Unlink</button>
        `;
        li.querySelector('button')?.addEventListener('click', () => {
          current!.relatedContacts = current!.relatedContacts.filter((item) => item.id !== rel.id);
          renderRelated();
        });
        return li;
      }),
    );

    const used = new Set((current.relatedContacts || []).map((rel) => rel.id));
    used.add(contactId);
    relatedPick.replaceChildren(new Option('Choose…', ''));
    for (const row of directory) {
      if (used.has(row.id) || row.archived) continue;
      relatedPick.add(new Option(row.displayName, row.id));
    }
  }

  function escapeHtml(value: string) {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function formPayload() {
    const rate = (document.getElementById('edit-rate') as HTMLInputElement).value;
    const pack = (document.getElementById('edit-package') as HTMLInputElement).value;
    return {
      displayName: (document.getElementById('edit-name') as HTMLInputElement).value,
      email: (document.getElementById('edit-email') as HTMLInputElement).value,
      phone: (document.getElementById('edit-phone') as HTMLInputElement).value,
      notes: (document.getElementById('edit-notes') as HTMLTextAreaElement).value,
      personas: selectedPersonas(),
      studentRateUsd: rate === '' ? null : Number(rate),
      studentFormat: (document.getElementById('edit-format') as HTMLSelectElement).value,
      studentPackageRemaining: pack === '' ? null : Number(pack),
      studentLastLesson: (document.getElementById('edit-last-lesson') as HTMLInputElement).value,
      studentSmsOk: (document.getElementById('edit-sms-ok') as HTMLInputElement).checked,
      agentAgency: (document.getElementById('edit-agency') as HTMLInputElement).value,
      agentTerritory: (document.getElementById('edit-territory') as HTMLInputElement).value,
      agentLastSubmission: (document.getElementById('edit-last-submission') as HTMLInputElement).value,
      agentLastBooking: (document.getElementById('edit-last-booking') as HTMLInputElement).value,
      agentLastBookingYear: (document.getElementById('edit-last-booking-year') as HTMLInputElement).value,
      agentLastTouch: (document.getElementById('edit-last-touch') as HTMLInputElement).value,
      agentWarmth: (document.getElementById('edit-warmth') as HTMLSelectElement).value,
      agentNextStep: (document.getElementById('edit-next-step') as HTMLInputElement).value,
      castingLastRequest: (document.getElementById('edit-casting-request') as HTMLInputElement).value,
      castingLastRequestOn: (document.getElementById('edit-casting-request-on') as HTMLInputElement)
        .value,
      castingWarmth: (document.getElementById('edit-casting-warmth') as HTMLSelectElement).value,
      relatedContacts: current?.relatedContacts || [],
      archived: current?.archived || false,
      etag: current?.etag || '',
    };
  }

  async function save(extra: Partial<Contact> = {}, button?: HTMLButtonElement) {
    if (!canWrite) return false;
    const run = async () => {
      clearError();
      const payload = { ...formPayload(), ...extra };
      const res = await fetch(`/api/contacts/${encodeURIComponent(contactId)}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        showError(data.error || 'Could not save this person.', data.correlationId);
        return false;
      }
      fillForm(data.contact as Contact);
      return true;
    };
    if (button) {
      let ok = false;
      await withButtonBusy(button, async () => {
        ok = (await run()) ?? false;
      }, button === archiveBtn ? (current?.archived ? 'Restoring…' : 'Archiving…') : 'Saving…');
      return ok;
    }
    return run();
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (isButtonBusy(saveBtn)) return;
    const ok = await save({}, saveBtn);
    if (ok) setStudioStatus(statusEl, 'Saved.');
  });

  archiveBtn.addEventListener('click', async () => {
    if (isButtonBusy(archiveBtn)) return;
    const next = !current?.archived;
    const ok = await save({ archived: next }, archiveBtn);
    if (ok) setStudioStatus(statusEl, next ? 'Archived.' : 'Restored.');
  });

  document.getElementById('related-add')?.addEventListener('click', () => {
    const id = relatedPick.value;
    if (!id || !current) return;
    current.relatedContacts = [
      ...current.relatedContacts.filter((rel) => rel.id !== id),
      { id, relation: relatedRelation.value || 'related' },
    ];
    renderRelated();
  });

  document.querySelectorAll<HTMLInputElement>('input[name="edit-persona"]').forEach((box) => {
    box.addEventListener('change', togglePersonaSections);
  });

  async function load() {
    if (!contactId) {
      showError('Open a person from the People list.');
      clearStudioStatus(statusEl);
      return;
    }
    setStudioStatus(statusEl, 'Loading…', true);
    try {
      const [detailRes, listRes] = await Promise.all([
        fetch(`/api/contacts/${encodeURIComponent(contactId)}`, { headers: { Accept: 'application/json' } }),
        fetch('/api/contacts?directory=1&includeArchived=true', { headers: { Accept: 'application/json' } }),
      ]);
      const detail = await detailRes.json().catch(() => ({}));
      const list = await listRes.json().catch(() => ({}));
      if (!detailRes.ok) {
        showError(detail.error || 'That person isn’t in Studio.', detail.correlationId);
        clearStudioStatus(statusEl);
        return;
      }
      directory = (list.contacts || []) as Contact[];
      payments = (detail.payments || []) as LedgerRow[];
      payLinkMap = (detail.payLinks || {}) as Record<string, string>;
      fillForm(detail.contact as Contact);
    } catch {
      showError('Could not load this person. Try again in a moment.');
      clearStudioStatus(statusEl);
    }
  }

  async function bootstrap() {
    setStudioStatus(statusEl, 'Checking access…', true);
    const session = await fetchStudioSession();
    if (!session.apiUnavailable && !hasStudioPermission(session, STUDIO_PERMISSION.PEOPLE_READ)) {
      peopleGate.classList.remove('hidden');
      clearStudioStatus(statusEl);
      return;
    }
    canWrite =
      session.apiUnavailable || hasStudioPermission(session, STUDIO_PERMISSION.PEOPLE_WRITE);
    if (!canWrite) {
      archiveBtn.classList.add('hidden');
      form.querySelectorAll('input, textarea, select, button[type="submit"]').forEach((el) => {
        (el as HTMLInputElement).disabled = true;
      });
      offlineForm.querySelectorAll('input, select, button').forEach((el) => {
        (el as HTMLInputElement).disabled = true;
      });
    }
    offlineForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!canWrite || isButtonBusy(offlineSaveBtn)) return;
      await withButtonBusy(offlineSaveBtn, async () => {
        clearError();
        try {
          const res = await fetch(`/api/contacts/${encodeURIComponent(contactId)}/offlinePayments`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({
              amountUsd: Number((document.getElementById('offline-amount') as HTMLInputElement).value),
              method: (document.getElementById('offline-method') as HTMLSelectElement).value,
              paidOn: (document.getElementById('offline-date') as HTMLInputElement).value,
            }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) {
            showError(data.error || 'Could not log that payment.', data.correlationId);
            return;
          }
          if (data.contact) current = { ...current!, ...(data.contact as Contact) };
          if (data.payment) payments = [data.payment as LedgerRow, ...payments];
          offlineForm.reset();
          renderValue();
          setStudioStatus(statusEl, 'Offline payment saved.');
        } catch {
          showError('Could not log that payment. Try again in a moment.');
        }
      }, 'Saving…');
    });
    await load();
  }

  void bootstrap();
</script>
