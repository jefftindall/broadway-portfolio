---
import StudioLayout from '../../../layouts/StudioLayout.astro';
import StudioLandingCard from '../../../components/StudioLandingCard.astro';
---

<StudioLayout
  title="Admin"
  description="Private Studio administration."
  heading="Admin"
  helpHref="/studio/help/admin"
>
  <section class="mx-auto max-w-xl px-4 py-5 md:py-8">
    <p class="text-sm text-muted">
      Studio-wide settings. Access and Google Calendar connect are live. Reports are not built yet.
    </p>
    <div class="mt-5 grid gap-3">
      <StudioLandingCard
        href="/studio/admin/access"
        title="Access"
        summary="Who is signed in, roles, and publish vs People permissions."
        primary
      />
      <StudioLandingCard
        href="/studio/admin/calendar"
        title="Calendar"
        summary="Connect the Studio organizer and optional Elyse free/busy Google accounts. Holidays and studio-wide closures are not built yet. Per-student lessons live under Students → Schedules."
      />
      <StudioLandingCard
        title="Reports"
        summary="Studio-wide reporting. Not available yet."
        available={false}
      />
    </div>
  </section>
</StudioLayout>
