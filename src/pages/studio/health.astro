---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Studio health"
  description="Read-only authenticated health marker for Studio sign-in checks."
  hideFooterCta={true}
  noIndex={true}
>
  <section class="mx-auto max-w-xl px-4 py-8 md:py-12">
    <p class="text-sm uppercase tracking-[0.2em] text-gel">Private</p>
    <h1 class="mt-2 font-display text-3xl text-spotlight md:text-4xl">Studio health</h1>
    <p class="mt-3 text-sm text-muted">
      Signed-in canary only. This page does not publish or edit the site.
    </p>
    <p
      class="mt-8 rounded-sm border border-line px-4 py-3 text-sm text-spotlight"
      data-studio-health="ok"
    >
      studio-health-ok
    </p>
    <p class="mt-8 text-sm">
      <a href="/studio" class="text-gel underline-offset-2 hover:text-gold hover:underline">
        ← Back to Studio
      </a>
    </p>
  </section>
</BaseLayout>

<script>
  import { flush, trackEvent } from '../../scripts/app-insights';

  trackEvent('StudioAuthOutcome', { outcome: 'success', path: '/studio/health' });
  flush();
</script>
