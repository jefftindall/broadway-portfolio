---
import StudioLayout from '../../layouts/StudioLayout.astro';
import {
  STUDIO_PERSONAS,
  STUDIO_PERSONA_LABELS,
  studioPeopleNotes,
} from '../../lib/studioPeople';
---

<StudioLayout
  title="People"
  description="Private Studio contacts for students, parents, agents, and casting."
  heading="People"
  helpHref="/studio/help/students"
>
  <section class="mx-auto max-w-xl px-4 py-5 md:py-8">
    <p class="text-sm text-muted">{studioPeopleNotes.summary}</p>

    <div
      id="people-gate"
      class="mt-6 hidden rounded-sm border border-line bg-panel/60 p-4 text-sm text-muted"
      role="alert"
    >
      <p id="people-gate-msg">You’re signed in, but this account cannot view People.</p>
      <p id="people-gate-ref" class="mt-3 hidden">
        Reference: <code id="people-gate-id" class="break-all text-spotlight"></code>
      </p>
      <p class="mt-4">
        <a href="/studio" class="text-gel underline-offset-2 hover:text-gold hover:underline">Back to Studio</a>
      </p>
    </div>

    <div
      id="people-error"
      class="mt-4 hidden rounded-sm border border-line bg-panel/60 p-3 text-sm text-muted"
      role="alert"
    >
      <p id="people-error-msg"></p>
      <p id="people-error-ref" class="mt-2 hidden">
        Reference: <code id="people-error-id" class="break-all text-spotlight"></code>
      </p>
    </div>

    <div id="people-workspace">
    <div class="mt-6 flex flex-wrap items-center gap-2">
      <button
        id="add-person-btn"
        type="button"
        class="rounded-sm bg-gold px-4 py-2 text-sm font-semibold text-ink hover:brightness-110"
      >
        Add person
      </button>
    </div>

    <form id="create-form" class="mt-6 hidden space-y-4 rounded-sm border border-line bg-panel/40 p-4">
      <h2 class="font-display text-2xl text-spotlight">New person</h2>
      <label class="block text-sm text-muted">
        Name
        <input
          id="create-name"
          type="text"
          required
          autocomplete="name"
          class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
        />
      </label>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="block text-sm text-muted">
          Email
          <input
            id="create-email"
            type="email"
            autocomplete="email"
            class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
          />
        </label>
        <label class="block text-sm text-muted">
          Phone
          <input
            id="create-phone"
            type="tel"
            autocomplete="tel"
            class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
          />
        </label>
      </div>
      <fieldset>
        <legend class="text-sm text-muted">Personas</legend>
        <div class="mt-2 flex flex-wrap gap-2">
          {
            STUDIO_PERSONAS.map((persona) => (
              <label class="inline-flex items-center gap-2 rounded-sm border border-line px-3 py-2 text-sm text-spotlight">
                <input type="checkbox" name="create-persona" value={persona} />
                {STUDIO_PERSONA_LABELS[persona]}
              </label>
            ))
          }
        </div>
      </fieldset>
      <label class="block text-sm text-muted">
        Notes
        <textarea
          id="create-notes"
          rows="3"
          class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
        ></textarea>
      </label>
      <div class="flex flex-wrap gap-2">
        <button
          type="submit"
          class="rounded-sm bg-gold px-4 py-2 text-sm font-semibold text-ink hover:brightness-110"
        >
          Save person
        </button>
        <button
          id="create-cancel"
          type="button"
          class="rounded-sm border border-line px-4 py-2 text-sm text-spotlight hover:border-gold"
        >
          Cancel
        </button>
      </div>
    </form>

    <div class="mt-6 space-y-3">
      <label class="block text-sm text-muted">
        Search name or email
        <input
          id="people-search"
          type="search"
          class="mt-1 w-full rounded-sm border border-line bg-ink px-3 py-2 text-sm text-spotlight outline-none focus:border-gold"
        />
      </label>
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by persona">
        <button
          type="button"
          data-persona=""
          class="persona-filter rounded-sm border border-gold bg-gold/15 px-3 py-1.5 text-xs font-semibold text-spotlight"
        >
          All
        </button>
        {
          STUDIO_PERSONAS.map((persona) => (
            <button
              type="button"
              data-persona={persona}
              class="persona-filter rounded-sm border border-line px-3 py-1.5 text-xs text-muted hover:border-gold"
            >
              {STUDIO_PERSONA_LABELS[persona]}
            </button>
          ))
        }
      </div>
      <label class="inline-flex items-center gap-2 text-sm text-muted">
        <input id="include-archived" type="checkbox" />
        Show archived
      </label>
    </div>

    <p id="people-status" class="mt-4 text-sm text-muted" role="status">Loading people…</p>
    <ul id="people-list" class="mt-3 space-y-3"></ul>
    <nav
      id="people-pager"
      class="mt-4 hidden items-center justify-between gap-3"
      aria-label="People pages"
    >
      <button
        id="people-prev"
        type="button"
        class="rounded-sm border border-line px-4 py-2 text-sm text-spotlight hover:border-gold disabled:cursor-not-allowed disabled:opacity-40"
      >
        Previous
      </button>
      <p id="people-page-label" class="text-center text-sm text-muted"></p>
      <button
        id="people-next"
        type="button"
        class="rounded-sm border border-line px-4 py-2 text-sm text-spotlight hover:border-gold disabled:cursor-not-allowed disabled:opacity-40"
      >
        Next
      </button>
    </nav>
    </div>
  </section>
</StudioLayout>

<script>
  import { STUDIO_PERSONA_LABELS, studioPersonPath, type StudioPersona } from '../../lib/studioPeople';
  import {
    STUDIO_PERMISSION,
    fetchStudioSession,
    hasStudioPermission,
  } from '../../lib/studioSession';

  type Contact = {
    id: string;
    displayName: string;
    email: string;
    phone: string;
    personas: StudioPersona[];
    notes: string;
    archived: boolean;
  };

  const errorBox = document.getElementById('people-error') as HTMLElement;
  const errorMsg = document.getElementById('people-error-msg') as HTMLElement;
  const errorRef = document.getElementById('people-error-ref') as HTMLElement;
  const errorId = document.getElementById('people-error-id') as HTMLElement;
  const statusEl = document.getElementById('people-status') as HTMLElement;
  const listEl = document.getElementById('people-list') as HTMLElement;
  const searchEl = document.getElementById('people-search') as HTMLInputElement;
  const archivedEl = document.getElementById('include-archived') as HTMLInputElement;
  const createForm = document.getElementById('create-form') as HTMLFormElement;
  const addBtn = document.getElementById('add-person-btn') as HTMLButtonElement;
  const peopleGate = document.getElementById('people-gate') as HTMLElement;
  const peopleGateMsg = document.getElementById('people-gate-msg') as HTMLElement;
  const peopleGateRef = document.getElementById('people-gate-ref') as HTMLElement;
  const peopleGateId = document.getElementById('people-gate-id') as HTMLElement;
  const peopleWorkspace = document.getElementById('people-workspace') as HTMLElement;
  const cancelBtn = document.getElementById('create-cancel') as HTMLButtonElement;
  const pagerEl = document.getElementById('people-pager') as HTMLElement;
  const pageLabelEl = document.getElementById('people-page-label') as HTMLElement;
  const prevBtn = document.getElementById('people-prev') as HTMLButtonElement;
  const nextBtn = document.getElementById('people-next') as HTMLButtonElement;

  const PAGE_SIZE = 10;
  let personaFilter = '';
  let page = 1;

  function showError(message: string, correlationId?: string) {
    errorMsg.textContent = message;
    if (correlationId) {
      errorId.textContent = correlationId;
      errorRef.classList.remove('hidden');
    } else {
      errorRef.classList.add('hidden');
    }
    errorBox.classList.remove('hidden');
  }

  function clearError() {
    errorBox.classList.add('hidden');
  }

  function personaChip(persona: string) {
    return STUDIO_PERSONA_LABELS[persona as StudioPersona] || persona;
  }

  async function loadPeople() {
    clearError();
    statusEl.textContent = 'Loading people…';
    const params = new URLSearchParams();
    if (searchEl.value.trim()) params.set('q', searchEl.value.trim());
    if (personaFilter) params.set('persona', personaFilter);
    if (archivedEl.checked) params.set('includeArchived', 'true');
    params.set('page', String(page));
    params.set('pageSize', String(PAGE_SIZE));
    try {
      const res = await fetch(`/api/contacts?${params.toString()}`, { headers: { Accept: 'application/json' } });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        showError(data.error || 'Could not load people.', data.correlationId);
        statusEl.textContent = '';
        listEl.replaceChildren();
        pagerEl.classList.add('hidden');
        pagerEl.classList.remove('flex');
        return;
      }
      const contacts = (data.contacts || []) as Contact[];
      const total = Number(data.total) || contacts.length;
      const totalPages = Number(data.totalPages) || 1;
      page = Number(data.page) || page;
      statusEl.textContent = total
        ? `${total} ${total === 1 ? 'person' : 'people'} · last name, then first`
        : 'No people match these filters yet.';
      const showPager = total > PAGE_SIZE;
      pagerEl.classList.toggle('hidden', !showPager);
      pagerEl.classList.toggle('flex', showPager);
      pageLabelEl.textContent = `Page ${page} of ${totalPages}`;
      prevBtn.disabled = page <= 1;
      nextBtn.disabled = page >= totalPages;
      listEl.replaceChildren(
        ...contacts.map((contact) => {
          const li = document.createElement('li');
          const archived = contact.archived ? ' · archived' : '';
          li.innerHTML = `
            <a
              href="${studioPersonPath(contact.id)}"
              class="block rounded-sm border border-line bg-panel/40 px-4 py-3 hover:border-gold"
            >
              <span class="block font-semibold text-spotlight">${escapeHtml(contact.displayName)}</span>
              <span class="mt-1 block text-xs text-muted">${escapeHtml(
                (contact.personas || []).map(personaChip).join(' · ') + archived,
              )}</span>
              ${
                contact.email
                  ? `<span class="mt-1 block truncate text-xs text-muted">${escapeHtml(contact.email)}</span>`
                  : ''
              }
            </a>`;
          return li;
        }),
      );
    } catch {
      showError('Could not load people. Try again in a moment.');
      statusEl.textContent = '';
      listEl.replaceChildren();
      pagerEl.classList.add('hidden');
      pagerEl.classList.remove('flex');
    }
  }

  function escapeHtml(value: string) {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  addBtn.addEventListener('click', () => {
    createForm.classList.remove('hidden');
    (document.getElementById('create-name') as HTMLInputElement).focus();
  });
  cancelBtn.addEventListener('click', () => {
    createForm.reset();
    createForm.classList.add('hidden');
  });

  createForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearError();
    const personas = [...document.querySelectorAll<HTMLInputElement>('input[name="create-persona"]:checked')].map(
      (el) => el.value,
    );
    try {
      const res = await fetch('/api/contacts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          displayName: (document.getElementById('create-name') as HTMLInputElement).value,
          email: (document.getElementById('create-email') as HTMLInputElement).value,
          phone: (document.getElementById('create-phone') as HTMLInputElement).value,
          notes: (document.getElementById('create-notes') as HTMLTextAreaElement).value,
          personas,
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        showError(data.error || 'Could not save this person.', data.correlationId);
        return;
      }
      window.location.href = studioPersonPath(data.contact.id);
    } catch {
      showError('Could not save this person. Try again in a moment.');
    }
  });

  document.querySelectorAll<HTMLButtonElement>('.persona-filter').forEach((btn) => {
    btn.addEventListener('click', () => {
      personaFilter = btn.dataset.persona || '';
      document.querySelectorAll<HTMLButtonElement>('.persona-filter').forEach((other) => {
        const active = other === btn;
        other.classList.toggle('border-gold', active);
        other.classList.toggle('bg-gold/15', active);
        other.classList.toggle('font-semibold', active);
        other.classList.toggle('text-spotlight', active);
        other.classList.toggle('border-line', !active);
        other.classList.toggle('text-muted', !active);
      });
      page = 1;
      void loadPeople();
    });
  });

  let searchTimer = 0;
  searchEl.addEventListener('input', () => {
    window.clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => {
      page = 1;
      void loadPeople();
    }, 200);
  });
  archivedEl.addEventListener('change', () => {
    page = 1;
    void loadPeople();
  });
  prevBtn.addEventListener('click', () => {
    if (page <= 1) return;
    page -= 1;
    void loadPeople();
  });
  nextBtn.addEventListener('click', () => {
    page += 1;
    void loadPeople();
  });

  async function bootstrap() {
    const session = await fetchStudioSession();
    if (session.apiUnavailable) {
      void loadPeople();
      return;
    }
    if (!hasStudioPermission(session, STUDIO_PERMISSION.PEOPLE_READ)) {
      peopleWorkspace.classList.add('hidden');
      peopleGate.classList.remove('hidden');
      peopleGateMsg.textContent = 'You’re signed in, but this account cannot view People.';
      if (session.correlationId) {
        peopleGateId.textContent = session.correlationId;
        peopleGateRef.classList.remove('hidden');
      }
      statusEl.textContent = '';
      return;
    }
    if (!hasStudioPermission(session, STUDIO_PERMISSION.PEOPLE_WRITE)) {
      addBtn.classList.add('hidden');
    }
    void loadPeople();
  }

  void bootstrap();
</script>
