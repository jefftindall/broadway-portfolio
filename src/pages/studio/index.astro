---
import StudioLayout from '../../layouts/StudioLayout.astro';
import StudioLandingCard from '../../components/StudioLandingCard.astro';
---

<StudioLayout
  title="Studio"
  description="Private Studio home for Elyse Tindall."
  heading="Studio"
  helpHref="/studio/help"
>
  <section class="mx-auto max-w-xl px-4 py-5 md:py-8">
    <p id="studio-greeting" class="text-sm text-muted">Choose a section to get started.</p>
    <div class="mt-5 grid gap-3">
      <StudioLandingCard
        href="/studio/content"
        title="Content"
        summary="Speak or type an update, or edit gallery, rates, facts, reel, bio, and quote."
        primary
      />
      <StudioLandingCard
        href="/studio/students"
        title="Students"
        summary="People, lesson contacts, and teaching ops."
      />
      <StudioLandingCard
        href="/studio/career"
        title="Career"
        summary="Agents, casting, and performance tools."
      />
      <StudioLandingCard
        href="/studio/admin"
        title="Admin"
        summary="Access, studio-wide calendar, and reports."
      />
    </div>
  </section>
</StudioLayout>

<script>
  type ClientPrincipal = {
    userDetails?: string;
    claims?: Array<{ typ?: string; val?: string }>;
  };

  const greeting = document.getElementById('studio-greeting');
  const EMAIL_CLAIM_TYPES = new Set([
    'http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress',
    'emails',
    'email',
  ]);

  function displayName(principal: ClientPrincipal): string {
    const claims = Array.isArray(principal.claims) ? principal.claims : [];
    const email = claims.find((c) => c.typ && EMAIL_CLAIM_TYPES.has(c.typ) && c.val)?.val;
    return String(email || principal.userDetails || '').trim();
  }

  async function greet() {
    try {
      const res = await fetch('/.auth/me');
      const data = await res.json();
      const principal = data?.clientPrincipal as ClientPrincipal | null;
      const name = principal ? displayName(principal) : '';
      if (greeting && name) {
        greeting.textContent = `Signed in as ${name}. Choose a section to get started.`;
      }
    } catch {
      /* local preview without Easy Auth */
    }
  }

  void greet();
</script>
