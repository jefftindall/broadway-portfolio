---
import StudioLayout from '../../layouts/StudioLayout.astro';
---

<StudioLayout
  title="Career"
  description="Private Studio career tools for agents, casting, and performance."
  heading="Career"
  helpHref="/studio/help"
>
  <section class="mx-auto max-w-xl px-4 py-5 md:py-8">
    <p class="text-sm text-muted">
      This is where agent, casting-director, and performance tools will live. Nothing to do here
      yet — site updates are in Content, and contacts (including agents and casting) are in
      Students → People.
    </p>
    <p class="mt-6 text-sm">
      <a href="/studio/content" class="text-gel underline-offset-2 hover:text-gold hover:underline">
        Open Content
      </a>
    </p>
  </section>
</StudioLayout>
