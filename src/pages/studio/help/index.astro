---
import StudioLayout from '../../../layouts/StudioLayout.astro';
import StudioLandingCard from '../../../components/StudioLandingCard.astro';
---

<StudioLayout
  title="Studio help"
  description="Private guide to Studio."
  heading="Help"
  helpHref="/studio/help"
>
  <article class="mx-auto max-w-xl px-4 py-5 md:py-8">
    <p class="text-sm text-muted">
      Signed-in guides for Studio. Help is not a workflow tab — use the Help icon on each screen for
      the matching topic. Reference device for screenshots and mic steps:
      <span class="text-spotlight">iPhone 17 · Safari</span>.
    </p>

    <section class="mt-8 space-y-3">
      <h2 class="font-display text-2xl text-spotlight">Getting started</h2>
      <ol class="list-decimal space-y-2 pl-5 text-sm text-muted">
        <li>Open <a href="/studio" class="text-gel hover:text-gold">Studio</a> and sign in.</li>
        <li>On Home, pick a section: Career, Content, Students, or Admin.</li>
        <li>
          To update the public site, open{' '}
          <a href="/studio/content" class="text-gel hover:text-gold">Content</a>
          {' '}— speak or type, or use a discrete tile.
        </li>
        <li>
          For student and parent contacts, open{' '}
          <a href="/studio/students" class="text-gel hover:text-gold">Students</a>
          {' '}then People (when your account has People permission). Agents and casting are under{' '}
          <a href="/studio/career" class="text-gel hover:text-gold">Career</a>.
        </li>
      </ol>
      <p class="text-sm text-muted">
        You can read these guides whenever you are signed in — even before People or publish
        permissions are turned on.
      </p>
    </section>

    <div class="mt-8 grid gap-3">
      <StudioLandingCard
        href="/studio/help/content"
        title="Content"
        summary="Speak or type, discrete tiles, voice, preview, and publish."
        primary
      />
      <StudioLandingCard
        href="/studio/help/students"
        title="Students"
        summary="People, lifetime value, Payment Links, and lesson schedules."
      />
      <StudioLandingCard
        href="/studio/help/career"
        title="Career"
        summary="Agent and casting value — recency and warmth, not a fake invoice total."
      />
      <StudioLandingCard
        href="/studio/help/admin"
        title="Admin"
        summary="What Admin is for: Access and Calendar connect now; reports later."
      />
      <StudioLandingCard
        href="/studio/help/calendar"
        title="Calendar"
        summary="Connect Google, Requested vs Confirmed, and weekly series."
      />
      <StudioLandingCard
        href="/studio/help/access"
        title="Access"
        summary="Sign-in vs publish vs People. Roles and discrete permissions."
      />
    </div>

    <p class="mt-10 text-sm">
      <a href="/studio" class="inline-flex rounded-sm bg-gold px-5 py-3 text-sm font-semibold text-ink hover:brightness-110">
        Open Studio
      </a>
    </p>
  </article>
</StudioLayout>
