---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassPanel from '../components/GlassPanel.astro';
import InquiryForm from '../components/InquiryForm.astro';
import Age from '../components/Age.astro';
import { site } from '../lib/site';
---

<BaseLayout
  title="Contact"
  description="Contact Elyse Tindall for casting materials — headshot, resume, reel, and availability."
  image={site.heroImage}
  hideFooterCta
>
  <section class="mx-auto max-w-6xl px-6 py-16 md:py-24">
    <p class="text-sm uppercase tracking-[0.2em] text-gel">Get in touch</p>
    <h1 class="mt-3 font-display text-5xl text-spotlight md:text-6xl">Contact</h1>
    <p class="mt-4 max-w-2xl text-muted">
      Casting directors and agents — send a request below and it goes straight to Elyse’s inbox.
    </p>
    <p class="mt-3 text-sm text-muted">
      Age <Age /> · Based in {site.location}
    </p>
  </section>

  <section class="mx-auto max-w-2xl px-6 pb-20" aria-labelledby="casting-form-heading">
    <h2 id="casting-form-heading" class="font-display text-3xl text-spotlight md:text-4xl">
      Casting &amp; agents
    </h2>
    <p class="mt-2 text-sm text-muted">
      Headshot, resume, reel, and availability for casting directors and representation.
    </p>
    <GlassPanel strong class="mt-8 p-6 md:p-8">
      <InquiryForm type="casting" id="casting-inquiry" />
    </GlassPanel>
    <p class="mt-8 text-sm text-muted">
      <a
        class="text-gel underline underline-offset-4"
        href={site.instagram}
        target="_blank"
        rel="noopener noreferrer"
      >
        Instagram
      </a>
    </p>
  </section>
</BaseLayout>
