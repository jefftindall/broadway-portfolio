---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/site';
---

<BaseLayout
  title="Contact"
  description="Contact Elyse Tindall for casting materials or lesson inquiries."
>
  <section class="mx-auto max-w-3xl px-6 py-16 md:py-24">
    <p class="text-sm uppercase tracking-[0.2em] text-gel">Get in touch</p>
    <h1 class="mt-3 font-display text-5xl text-spotlight md:text-6xl">Contact</h1>
    <p class="mt-4 text-muted">
      One inbox — please use the subject lines below so casting and lesson emails stay organized.
    </p>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      <div class="rounded-sm border border-line bg-panel/50 p-6">
        <h2 class="font-display text-2xl text-spotlight">Casting &amp; agents</h2>
        <p class="mt-3 text-sm text-muted">
          Headshot, resume, reel, and availability.
        </p>
        <a
          href={`mailto:${site.email}?subject=${encodeURIComponent('Casting Inquiry')}`}
          class="mt-6 inline-flex rounded-sm bg-gold px-5 py-3 text-sm font-semibold text-ink hover:brightness-110"
        >
          Email for casting
        </a>
      </div>
      <div class="rounded-sm border border-line bg-panel/50 p-6">
        <h2 class="font-display text-2xl text-spotlight">Lessons</h2>
        <p class="mt-3 text-sm text-muted">
          Coaching inquiries for students and parents.
        </p>
        <a
          href={`mailto:${site.email}?subject=${encodeURIComponent('Lesson Inquiry')}`}
          class="mt-6 inline-flex rounded-sm border border-line px-5 py-3 text-sm text-spotlight hover:border-gold"
        >
          Email for lessons
        </a>
      </div>
    </div>

    <p class="mt-10 text-sm text-muted">
      Direct email:{' '}
      <a class="text-gel underline underline-offset-4" href={`mailto:${site.email}`}>{site.email}</a>
    </p>
  </section>
</BaseLayout>
