---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactLanes from '../components/ContactLanes.astro';
import Age from '../components/Age.astro';
import { site } from '../lib/site';
---

<BaseLayout
  title="Contact"
  description="Contact Elyse Tindall for casting materials or private voice lesson inquiries."
  image={site.heroImage}
  hideFooterCta
>
  <section class="mx-auto max-w-6xl px-6 py-16 md:py-24">
    <p class="text-sm uppercase tracking-[0.2em] text-gel">Get in touch</p>
    <h1 class="mt-3 font-display text-5xl text-spotlight md:text-6xl">Contact</h1>
    <p class="mt-4 max-w-2xl text-muted">
      One inbox — please use the subject lines below so casting and lesson emails stay organized.
    </p>
    <p class="mt-3 text-sm text-muted">
      Age <Age /> · Based in {site.location}
    </p>
  </section>

  <ContactLanes showHeader={false} />

  <section class="mx-auto max-w-6xl px-6 pb-20">
    <p class="text-sm text-muted">
      Direct email:{' '}
      <a class="text-gel underline underline-offset-4" href={`mailto:${site.email}`}>
        {site.email}
      </a>
      {' · '}
      <a
        class="text-gel underline underline-offset-4"
        href={site.instagram}
        target="_blank"
        rel="noopener noreferrer"
      >
        Instagram
      </a>
    </p>
  </section>
</BaseLayout>
