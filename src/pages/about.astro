---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LessonCta from '../components/LessonCta.astro';
import PerformerFacts from '../components/PerformerFacts.astro';
import { site } from '../lib/site';
import OptimizedImg from '../components/OptimizedImg.astro';

const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('Missing about page content');
const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={site.heroImage}
>
  <section class="mx-auto max-w-6xl px-6 py-16 md:py-24">
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <div class="overflow-hidden rounded-sm border border-line">
        <OptimizedImg
          src={site.heroImage}
          alt={`${site.name}, musical theatre actress and vocal coach`}
          class="aspect-[3/4] w-full object-cover object-top"
          width={800}
          height={1067}
          sizes="(min-width: 1024px) 28rem, 100vw"
          fetchpriority="high"
        />
      </div>
      <div>
        <p class="text-sm uppercase tracking-[0.2em] text-gel">Atlanta to New York</p>
        <h1 class="mt-3 font-display text-5xl text-spotlight md:text-6xl">About</h1>
        <p class="mt-4 text-lg text-muted">{site.jobTitle}</p>
        <p class="mt-6 text-lg text-spotlight/90">{site.shortBio}</p>
        <div class="prose-site mt-10">
          <Content />
        </div>
        <p class="mt-8 text-sm text-muted">
          <a class="text-gel underline underline-offset-4" href="/gallery">
            Browse the gallery
          </a>
        </p>
        <PerformerFacts class="mt-12" />
        <div class="mt-12">
          <LessonCta />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
