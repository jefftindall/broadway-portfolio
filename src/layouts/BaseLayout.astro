---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import StickyMobileCastingBar from '../components/StickyMobileCastingBar.astro';
import { site } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalPath?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  hideFooterCta?: boolean;
  noIndex?: boolean;
  hideNav?: boolean;
  hideFooter?: boolean;
}

const {
  title,
  description = site.description,
  image,
  canonicalPath,
  jsonLd,
  hideFooterCta = false,
  noIndex = false,
  hideNav = false,
  hideFooter = false,
} = Astro.props;

/** Pages pass bare titles; BaseLayout owns the brand suffix (` · Elyse Tindall`). */
function barePageTitle(raw: string): string {
  const pipe = ` | ${site.name}`;
  const dot = ` · ${site.name}`;
  let cleaned = raw.trim();
  if (cleaned.endsWith(pipe)) cleaned = cleaned.slice(0, -pipe.length).trimEnd();
  if (cleaned.endsWith(dot)) cleaned = cleaned.slice(0, -dot.length).trimEnd();
  return cleaned;
}

const pageTitle = title
  ? `${barePageTitle(title)} · ${site.name}`
  : `${site.name} · ${site.tagline}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Seo
      title={pageTitle}
      description={description}
      image={image}
      canonicalPath={canonicalPath ?? Astro.url.pathname}
      jsonLd={jsonLd}
      noIndex={noIndex}
    />
  </head>
  <body class="site-bg antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-gold focus:px-3 focus:py-2 focus:text-ink"
    >
      Skip to content
    </a>
    {hideNav ? null : <Nav />}
    <main id="main">
      <slot />
    </main>
    {hideFooter ? null : <Footer hideCta={hideFooterCta} />}
    <StickyMobileCastingBar />
    <script>
      const path = location.pathname.replace(/\/+$/, '') || '/';
      const immediate = path === '/' || path.startsWith('/studio');
      const load = () => import('../scripts/app-insights.ts');
      if (immediate) {
        void load();
      } else {
        const kick = () => {
          void load();
        };
        window.addEventListener('pointerdown', kick, { once: true });
        window.addEventListener('keydown', kick, { once: true });
        if (typeof requestIdleCallback === 'function') {
          requestIdleCallback(kick, { timeout: 4000 });
        } else {
          setTimeout(kick, 2500);
        }
      }
    </script>
    <script>
      import '../scripts/ga.ts';
    </script>
  </body>
</html>
