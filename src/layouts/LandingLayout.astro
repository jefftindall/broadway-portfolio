---
import BaseLayout from './BaseLayout.astro';
import { site } from '../lib/site';

interface Props {
  title: string;
  description: string;
  keyword: string;
  relatedSkills?: string[];
  relatedShows?: string[];
  canonicalPath: string;
}

const {
  title,
  description,
  keyword,
  relatedSkills = [],
  relatedShows = [],
  canonicalPath,
} = Astro.props;

/** BaseLayout appends ` · ${site.name}`; strip legacy `| Name` from frontmatter. */
const displayTitle = title.replace(new RegExp(`\\s*\\|\\s*${site.name}$`), '').trim();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: site.jobTitle,
  sameAs: [site.instagram],
  knowsAbout: [keyword, ...relatedSkills, ...site.knowsAbout],
  description,
};
---

<BaseLayout title={displayTitle} description={description} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-6 py-12 md:py-16">
    <h1 class="fade-up font-display text-4xl leading-tight text-spotlight md:text-5xl">
      {displayTitle}
    </h1>
    <div class="fade-up-delay prose-site mt-6">
      <slot />
    </div>

    {
      relatedShows.length > 0 && (
        <aside class="mt-10 border-t border-line pt-6">
          <h2 class="font-display text-2xl text-spotlight">Related credits</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {relatedShows.map((show) => (
              <li class="rounded-sm border border-line px-3 py-1 text-sm text-muted">{show}</li>
            ))}
          </ul>
          <p class="mt-3">
            <a href="/shows" class="text-gel underline underline-offset-4 hover:text-spotlight">
              View all shows
            </a>
          </p>
        </aside>
      )
    }
  </article>
</BaseLayout>
