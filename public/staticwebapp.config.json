      }
    },
    {
      "route": "/account/*",
      "allowedRoles": ["contact"],
      "headers": {
        "Cache-Control": "private, no-store"
      }
    },
    {
      "route": "/login",
      "headers": {
        "Cache-Control": "private, no-store"
      }
    },
    {
      "route": "/api/authRoles",
      "allowedRoles": ["anonymous", "authenticated"],
