{
  "auth": {
    "rolesSource": "/api/authRoles",
    "identityProviders": {
      "azureActiveDirectory": {
        "registration": {
          "openIdIssuer": "https://login.microsoftonline.com/e78bb87b-bdca-4a5f-8f90-a1c388528a5f/v2.0",
          "clientIdSettingName": "AAD_CLIENT_ID",
          "clientSecretSettingName": "AAD_CLIENT_SECRET"
        }
      },
      "customOpenIdConnectProviders": {
        "contact": {
          "registration": {
            "openIdIssuer": "https://REPLACE_ME.ciamlogin.com/00000000-0000-0000-0000-000000000000/v2.0",
            "clientIdSettingName": "CONTACT_OIDC_CLIENT_ID",
            "clientSecretSettingName": "CONTACT_OIDC_CLIENT_SECRET"
          }
        }
      }
    }
  },
