{
  "name": "elyse-tindall-portfolio",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run resume:pdf && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "node scripts/lint.mjs",
    "lint:api": "node scripts/lint-api.mjs",
    "test:api-flex": "node --test api/src/lib/gemini-flex.test.js",
    "test:api-studio-publish": "node --test api/src/lib/studioPublish.test.js",
    "lint:actions-secrets": "node scripts/check-actions-secret-safety.mjs",
    "test:github-app-token": "bash scripts/test-github-app-token.sh",
    "lint:terraform": "node scripts/lint-terraform.mjs",
    "resume:pdf": "node scripts/generate-resume-pdf.mjs",
    "ops:scorecard-email": "node scripts/ops-scorecard-email.mjs",
    "ops:scorecard-email:preview": "node scripts/ops-scorecard-email.mjs --preview-file=tmp-scorecard-digest-preview.html",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts",
    "test:journey": "playwright test --config=playwright.journey.config.ts",
    "test:journey:content": "playwright test --config=playwright.journey.config.ts --grep @content",
    "test:lab-fcp": "node scripts/lab-fcp.mjs",
    "ig:download": "node scripts/download-instagram-media.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@azure/communication-email": "^1.1.0",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@google-analytics/data": "^7.0.0",
    "@microsoft/applicationinsights-web": "^3.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.54.2",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.54.2",
    "typescript": "^5.9.2",
    "zod": "^4.4.3"
  }
}
