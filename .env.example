# Canonical production site (Gemini Studio context)
SITE_URL=https://elysetindall.com
PUBLIC_SITE_URL=https://elysetindall.com

# Site build contact facts (Key Vault SITE-* secrets in CI; never commit real values)
# Phone is used for the resume PDF only — not displayed on the public site.
SITE_CONTACT_EMAIL=
SITE_CONTACT_PHONE=
SITE_DATE_OF_BIRTH=

# API (local Functions) — prefer api/local.settings.json
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_OWNER=jefftindall
GITHUB_REPO=broadway-portfolio
GITHUB_BRANCH=main
ALLOWED_USER_IDS=
