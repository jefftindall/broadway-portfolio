# Canonical production site (Gemini Studio context)
SITE_URL=https://elysetindall.com
PUBLIC_SITE_URL=https://elysetindall.com

# Site build contact facts (shared Key Vault kv-elyse-shared in CI; never commit real values)
# Phone is used for the resume PDF and (prod) SMS notification destination — not shown on the public site.
SITE_CONTACT_EMAIL=
SITE_CONTACT_PHONE=
SITE_DATE_OF_BIRTH=

# Cloudflare Turnstile (both keys in shared Key Vault; site key is public at runtime)
# CI fetches TURNSTILE-SITE-KEY → PUBLIC_TURNSTILE_SITE_KEY from kv-elyse-shared
# Test keys: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
PUBLIC_TURNSTILE_SITE_KEY=

# Google Analytics 4 Measurement ID (public-by-design; embedded in the client bundle)
# CI: Terraform sets GitHub Environment variable GA_MEASUREMENT_ID → PUBLIC_GA_MEASUREMENT_ID
# Default when unset: G-XEE29C0RRE (see src/lib/analytics.ts)
PUBLIC_GA_MEASUREMENT_ID=G-XEE29C0RRE

# Local-only lesson pay CTAs (`astro dev` without Functions). CD does not bake these —
# staging/prod read LESSON_PAYMENTS_ENABLED + Payment Links from SWA app settings.
# Use Stripe test-mode Payment Links (https://buy.stripe.com/test_…).
PUBLIC_LESSON_PAYMENTS_ENABLED=
PUBLIC_STRIPE_PAYMENT_LINK_30MIN=
PUBLIC_STRIPE_PAYMENT_LINK_60MIN=

# API (local Functions) — prefer api/local.settings.json
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Search ops / lander drafts only (independent quota from Studio 3.6)
GEMINI_MODEL_SEARCH_OPS=gemini-3.5-flash
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_OWNER=jefftindall
GITHUB_REPO=broadway-portfolio
GITHUB_BRANCH=main
ALLOWED_USER_IDS=

# Contact inquiry (ACS) — set in api/local.settings.json for local Functions
# ACS_CONNECTION_STRING=
# ACS_EMAIL_SENDER=
# CONTACT_NOTIFY_EMAIL=
# CONTACT_NOTIFY_PHONE=
# CONTACT_SMS_ENABLED=false
# ACS_SMS_FROM=
# TURNSTILE_SECRET=
# LESSON_PAYMENTS_ENABLED=true
# STRIPE_PAYMENT_LINK_30MIN=
# STRIPE_PAYMENT_LINK_60MIN=
